{"type":"FeatureCollection","features":[{"type":"Feature","properties":{"name":"Colombo Port City","type":"special-economic-zone","status":"under-construction","stages":{"proposed":"2014","approved":"2016","construction":"2019","operational":"2041 (target)"},"cost":"US$1.4B initial · ~US$20B at build-out","note":"269 ha sea-reclamation SEZ beside the Colombo CBD — five precincts, ~273,000 residents at completion. Land reclamation completed Jan 2019; marina open since 2022.","source":"Colombo Port City Economic Commission (CPCEC)","source_url":"https://www.portcitycolombo.gov.lk/port-city-colombo","updated":"2026-08-16"},"geometry":{"type":"Point","coordinates":[79.838,6.945]}},{"type":"Feature","properties":{"name":"Colombo West International Terminal (CWIT)","type":"port-terminal","status":"operational","stages":{"proposed":"2021","approved":"2021","construction":"2022","operational":"2025"},"cost":"US$800M","note":"Deep-water terminal (1,400 m quay, 20 m draught, ~3.2M TEU/yr). Adani Ports / John Keells / SLPA. Operations began Apr 2025.","source":"Adani Ports / SLPA — CWIT","source_url":"https://www.adaniports.com/newsroom/media-releases/adani-colombo-terminal-commences-operations","updated":"2026-08-16"},"geometry":{"type":"Point","coordinates":[79.842,6.958]}},{"type":"Feature","properties":{"name":"East Container Terminal (ECT)","type":"port-terminal","status":"under-construction","stages":{"proposed":"2019","approved":"2021","construction":"2021","operational":"2026 (target)"},"cost":"US$475M","note":"SLPA-funded deep-water terminal (1,300 m quay). Partially operating since 2025 while final infrastructure is completed.","source":"Sri Lanka Ports Authority — ECT","source_url":"https://www.slpa.lk/","updated":"2026-08-16"},"geometry":{"type":"Point","coordinates":[79.849,6.966]}},{"type":"Feature","properties":{"name":"Bandaranaike Int’l Airport — Phase 2 (Terminal 2)","type":"airport","status":"under-construction","stages":{"proposed":"2016","approved":"2020","construction":"2024","operational":"2027 (target)"},"cost":"Rs 170bn (JICA loan)","note":"New main terminal, two piers and elevated roadway, ~JICA-financed. Restarted 2024 after the debt-restructuring freeze; ~30-month build.","source":"AASL / Embassy of Japan — BIA Phase 2","source_url":"https://www.lk.emb-japan.go.jp/itpr_en/11_000001_00509.html","updated":"2026-08-16"},"geometry":{"type":"Point","coordinates":[79.884,7.176]}},{"type":"Feature","properties":{"name":"Colombo Light Rail Transit (LRT) — Fort–Malabe","type":"rail","status":"proposed","stages":{"proposed":"2019","approved":"2019","construction":"—","operational":"2030s (target)"},"cost":"US$2.2B (US$1.85B JICA loan)","note":"15.8 km elevated light rail, 16 stations, Colombo Fort ↔ Malabe. Cancelled 2020; revival under discussion with Japan/JICA — not yet re-committed.","source":"Ministry of Transport / JICA (revival)","source_url":"https://www.ft.lk/top-story/SL-to-roll-out-Japan-funded-2-2-b-LRT-projectagain/26-746444","updated":"2026-08-16"},"geometry":{"type":"Point","coordinates":[79.894,6.909]}},{"type":"Feature","properties":{"name":"Colombo Suburban Railway — electrification","type":"rail","status":"proposed","stages":{"proposed":"2020","approved":"2026","construction":"2027 (target)","operational":"—"},"cost":"India LOC (~US$250M rail modernisation)","note":"Electrify high-density corridors (Maradana–Makumbura / Kelani Valley line first). Feasibility underway; India-funded track, signalling (IRCON) and rolling stock.","source":"Ministry of Transport — CSRP","source_url":"https://transport.gov.lk/web/index.php?option=com_content&view=article&id=136&Itemid=218&lang=en","updated":"2026-08-16"},"geometry":{"type":"Point","coordinates":[79.864,6.929]}},{"type":"Feature","properties":{"name":"Hambantota Oil Refinery (Sinopec)","type":"energy","status":"approved","stages":{"proposed":"2019","approved":"2025","construction":"2026 (target)","operational":"2028 (target)"},"cost":"US$3.7B","note":"200,000 bpd refinery in the Hambantota port investment zone — the largest single FDI in Sri Lankan history. Agreement fast-tracked Jan 2025.","source":"BOI / Sinopec (via Daily FT)","source_url":"https://www.ft.lk/columns/Sinopec-s-3-7-billion-oil-refinery-investment-in-Sri-Lanka/4-773663","updated":"2026-08-16"},"geometry":{"type":"Point","coordinates":[81.075,6.145]}},{"type":"Feature","properties":{"name":"Trincomalee Energy Hub — oil tank farm","type":"energy","status":"proposed","stages":{"proposed":"2022","approved":"2025","construction":"—","operational":"—"},"note":"India–Sri Lanka–UAE agreement (Apr 2025) to develop Trincomalee as a regional energy hub, including the WWII-era oil tank farm.","source":"Ministry of Energy (India–SL–UAE)","source_url":"https://www.lowyinstitute.org/the-interpreter/three-way-energy-play-india-sri-lanka-uae-deal-trincomalee","updated":"2026-08-16"},"geometry":{"type":"Point","coordinates":[81.205,8.556]}},{"type":"Feature","properties":{"name":"Mannar–Pooneryn Wind Power","type":"energy","status":"proposed","stages":{"proposed":"2019","approved":"—","construction":"—","operational":"—"},"note":"~484–500 MW wind. Adani Green withdrew (Feb 2025) after the power-purchase agreement was revoked; a committee is reassessing feasibility and tariff.","source":"SL Sustainable Energy Authority (via Mercom)","source_url":"https://www.mercomindia.com/sri-lanka-awards-wind-power-projects-adani-green","updated":"2026-08-16"},"geometry":{"type":"Point","coordinates":[79.92,8.98]}},{"type":"Feature","properties":{"name":"Sampur Solar Power Park","type":"energy","status":"approved","stages":{"proposed":"2022","approved":"2025","construction":"2026 (target)","operational":"—"},"note":"50 MW solar park, Sampur (Trincomalee district). CEB–NTPC joint venture; permit issued.","source":"Ceylon Electricity Board · NTPC","source_url":"https://www.themorning.lk/articles/wZg1n1IYYRgYamA7EW34","updated":"2026-08-16"},"geometry":{"type":"Point","coordinates":[81.27,8.45]}},{"type":"Feature","properties":{"name":"Sobadhanavi LNG Power Plant (Kerawalapitiya)","type":"energy","status":"operational","stages":{"proposed":"2019","approved":"2021","construction":"2022","operational":"2025"},"note":"350 MW LNG combined-cycle plant. Phase 1 (220 MW) commissioned Aug 2024; Phase 2 (130 MW steam) Sep 2025. India (Petronet) to build the LNG terminal.","source":"CEB / LTL — Sobadhanavi","source_url":"https://www.newswire.lk/2024/08/28/sobadhanavi-lng-power-plant-declared-open/","updated":"2026-08-16"},"geometry":{"type":"Point","coordinates":[79.902,6.981]}},{"type":"Feature","properties":{"name":"North Central Province Canal (Mahaweli WSIP)","type":"flood-mitigation","status":"under-construction","stages":{"proposed":"2013","approved":"2015","construction":"2016","operational":"2030 (target)"},"cost":"US$200M (ADB Stage 2)","note":"Links Moragahakanda to the North Central dry-zone reservoirs (Huruluwewa, Manankattiya…). Mahaweli Water Security Program Stage 2 benefits ~35,600 farming households.","source":"Mahaweli Authority / ADB","source_url":"https://www.adb.org/news/adb-approves-200-million-improve-water-food-security-north-central-sri-lanka","updated":"2026-08-16"},"geometry":{"type":"Point","coordinates":[80.72,7.85]}},{"type":"Feature","properties":{"name":"Uma Oya Multipurpose Project","type":"energy","status":"operational","stages":{"proposed":"2008","approved":"2010","construction":"2011","operational":"2024"},"cost":"US$529M","note":"Two dams + a 120 MW hydropower plant, inaugurated 2024. Adds ~231 GWh/yr and irrigates ~4,500 ha of the south-eastern dry zone.","source":"Ministry of Irrigation — Uma Oya","source_url":"https://economynext.com/iran-president-to-open-sri-lanka-514mn-irrigation-hydro-power-project-159760/","updated":"2026-08-16"},"geometry":{"type":"Point","coordinates":[81,6.9]}},{"type":"Feature","properties":{"name":"Jaffna–Kilinochchi Water Supply & Sanitation","type":"flood-mitigation","status":"under-construction","stages":{"proposed":"2010","approved":"2011","construction":"2013","operational":"2025 (target)"},"note":"ADB-funded piped, treated water for ~300,000 people across Jaffna, Poonakari and the islands (except Delft).","source":"NWSDB / ADB","source_url":"https://www.adb.org/projects/37378-013/main","updated":"2026-08-16"},"geometry":{"type":"Point","coordinates":[80.015,9.665]}},{"type":"Feature","properties":{"name":"Kankesanthurai (KKS) Harbour rehabilitation","type":"port-terminal","status":"approved","stages":{"proposed":"2023","approved":"2024","construction":"2025 (target)","operational":"—"},"cost":"US$61.5M (India grant)","note":"Rehabilitation & modernisation of the northern harbour to improve connectivity with southern India. Cabinet-approved under an Indian grant.","source":"SLPA / High Commission of India","source_url":"https://www.hcicolombo.gov.in/page/ongoing-projects/","updated":"2026-08-16"},"geometry":{"type":"Point","coordinates":[80.043,9.815]}},{"type":"Feature","properties":{"name":"Palaly Airport rehabilitation (Jaffna)","type":"airport","status":"approved","stages":{"proposed":"2023","approved":"2024","construction":"2025 (target)","operational":"—"},"note":"India-funded rehabilitation of Palaly airport to expand northern air connectivity (alongside KKS harbour).","source":"AASL / High Commission of India","source_url":"https://www.hcicolombo.gov.in/page/ongoing-projects/","updated":"2026-08-16"},"geometry":{"type":"Point","coordinates":[80.07,9.792]}},{"type":"Feature","properties":{"name":"Hambantota International Port","type":"port-terminal","status":"operational","stages":{"proposed":"2006","approved":"2008","construction":"2008","operational":"2010"},"note":"Deep-water port on the east–west shipping lane, operated by China Merchants under a 99-year lease; ongoing industrial-zone build-out (incl. the Sinopec refinery).","source":"Hambantota International Port Group","source_url":"https://www.hipg.lk/","updated":"2026-08-16"},"geomet