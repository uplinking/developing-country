{
  "schema_version": 1,
  "country": "LK",
  "dataset_id": "electricity-generation-quarter-hourly",
  "source_ids": [
    "nso-generation-api"
  ],
  "title": "Electricity generation and battery power",
  "description": "Stored NSO national generation and aggregate battery active-power readings in MW.",
  "grain": "One row per source quarter-hour timestamp.",
  "vintage": "2026-09-11–2026-09-11",
  "primary_key": [
    "timestamp"
  ],
  "notes": [
    "Source timestamps are retained verbatim without inventing a UTC offset.",
    "Refreshes replace only successfully validated dates and retain older report dates. Raw response revisions are archived by checksum."
  ],
  "caveats": [
    "BESS is a signed aggregate power reading, not nameplate capacity or stored energy.",
    "Source solar coverage includes estimation; consult the operator dashboard notes.",
    "Dates may have fewer than 96 quarter-hour observations. Missing readings are not filled with zero; confirm interval and timezone semantics before integrating MW into MWh."
  ],
