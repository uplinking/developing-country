{
  "name": "@developing-country/explore",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode explore",
    "build": "tsc -b && vite build",
    "build:explore": "tsc -b && vite build --mode explore",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.worker.json",
    "test": "bun test ./src/*.test.ts ./src/worker/*.test.ts ./src/map/*.test.ts ./test/ ./scripts/",
    "cf:dev": "env -u CLOUDFLARE_ACCOUNT_ID -u CLOUDFLARE_API_TOKEN wrangler dev",
    "check:ontology": "bun scripts/check-ontology.mjs",
    "check:dataset-versions": "bun scripts/check-dataset-versions.mjs",
    "build:dataset-versions": "bun scripts/build-dataset-versions.mjs",
    "check:gap": "bun scripts/check-gap-colombo.mjs",
    "db:migrate:local": "env -u CLOUDFLARE_ACCOUNT_ID -u CLOUDFLARE_API_TOKEN wrangler d1 migrations apply developing-country-platform --local",
    "db:migrate:remote": "env -u CLOUDFLARE_ACCOUNT_ID -u CLOUDFLARE_API_TOKEN wrangler d1 migrations apply developing-country-platform --remote",
    "deploy": "bun run build:explore && env -u CLOUDFLARE_ACCOUNT_ID -u CLOUDFLARE_API_TOKEN wrangler deploy",
    "dry-run": "bun run build:explore && env -u CLOUDFLARE_ACCOUNT_ID -u CLOUDFLARE_API_TOKEN wrangler deploy --dry-run --outdir .wrangler/dry-run-explore"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.18",
    "@better-auth/mcp": "1.7.18",
    "@better-auth/oauth-provider": "1.7.18",
    "@developing-country/countries": "workspace:*",
    "@developing-country/datasets": "workspace:*",
    "@developing-country/domain": "workspace:*",
    "@developing-country/figures": "workspace:*",
    "@developing-country/ui": "workspace:*",
    "@developing-country/views": "workspace:*",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@protomaps/basemaps": "^5.7.2",
    "better-auth": "1.7.18",
    "echarts": "6.1.0",
    "flint-chart": "0.5.1",
    "maplibre-gl": "^5.24.0",
    "pmtiles": "^4.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "suncalc": "^2.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260710.1",
    "@types/bun": "^1.4.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/suncalc": "^1.9.2",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "wrangler": "^4.110.0"
  }
}
