{"type":"FeatureCollection","features":[{"type":"Feature","properties":{"name":"Colombo Port City","type":"special-economic-zone","status":"under-construction","source":"Colombo Port City Economic Commission (CPCEC)","source_url":"https://www.portcitycolombo.gov.lk/port-city-colombo","updated":"2026-11-21","stages":{"proposed":"2014","approved":"2016","construction":"2019","operational":"2040 (target)"},"cost":"US$1.4B initial · ~US$20B at build-out","note":"269 ha sea-reclamation SEZ beside the Colombo CBD — five precincts, ~273,000 residents at completion. Land reclamation completed Jan 2019; marina open since 2022."},"geometry":{"type":"Point","coordinates":[79.838,6.945]}},{"type":"Feature","properties":{"name":"Colombo West International Terminal (CWIT)","type":"port-terminal","status":"operational","source":"Adani Ports / SLPA — CWIT","source_url":"https://www.maritimegateway.com/adanis-colombo-west-international-terminal-doubles-capacity-to-3-2-million-teus-with-phase-ii-launch/","updated":"2026-11-21","stages":{"proposed":"2021","approved":"2021","construction":"2022","operational":"2025"},"cost":"US$800M","note":"Deep-water terminal (1,400 m quay, 20 m draught, 3.2M TEU/yr). Adani Ports / John Keells / SLPA. Phase I opened Apr 2025; full quay (Phase II) opened Oct 2026."},"geometry":{"type":"Point","coordinates":[79.842,6.958]}},{"type":"Feature","properties":{"name":"East Container Terminal (ECT)","type":"port-terminal","status":"under-construction","source":"Sri Lanka Ports Authority — ECT","source_url":"https://news.slpa.lk/index.php/2026/01/23/third-berth-at-colombo-east-container-terminal-enters-service-marking-a-new-phase-of-operational-scale/","updated":"2026-11-21","stages":{"proposed":"2019","approved":"2021","construction":"2021","operational":"—"},"cost":"US$475M","note":"SLPA-funded deep-water terminal (1,300 m quay). Third berth in service Jan 2026; full operation awaits straddle-carrier procurement after four failed tenders."},"geometry":{"type":"Point","coordinates":[79.849,6.966]}},{"type":"Feature","properties":{"name":"Bandaranaike Int’l Airport — Phase 2 (Terminal 2)","type":"airport","status":"under-construction","source":"AASL / JICA — BIA Phase 2 (via Sunday Times)","source_url":"https://www.sundaytimes.lk/260726/news/jica-okays-taiseis-selection-for-second-terminal-at-bia-650432.html","updated":"2026-11-21","stages":{"proposed":"2016","approved":"2020","construction":"2020","operational":"2029 (target)"},"cost":"Rs 170bn (JICA loan)","note":"New main terminal, two piers and elevated roadway, JICA-financed. Halted Dec 2022 at ~6%; Taisei re-confirmed Jul 2026, restart targeted Nov 2026; ~30-month build."},"geometry":{"type":"Point","coordinates":[79.884,7.176]}},{"type":"Feature","properties":{"name":"Colombo Light Rail Transit (LRT) — Fort–Malabe","type":"rail","status":"proposed","source":"Ministry of Transport / JICA (revival)","source_url":"https://www.ft.lk/top-story/SL-to-roll-out-Japan-funded-2-2-b-LRT-projectagain/26-746444","updated":"2026-11-21","stages":{"proposed":"2019","approved":"2019","construction":"—","operational":"2030s (target)"},"cost":"US$2.2B (US$1.85B JICA loan)","note":"15.8 km elevated light rail, 16 stations, Colombo Fort ↔ Malabe. Cancelled 2020; revival under discussion with Japan/JICA — not yet re-committed."},"geometry":{"type":"Point","coordinates":[79.894,6.909]}},{"type":"Feature","properties":{"name":"Colombo Suburban Railway — electrification","type":"rail","status":"approved","source":"Ministry of Transport — Cabinet decision (via Daily FT)","source_url":"https://www.ft.lk/business/Cabinet-approves-next-steps-for-railway-electrification-program/34-793734","updated":"2026-11-21","stages":{"proposed":"2020","approved":"2026","construction":"2027 (target)","operational":"—"},"cost":"Rs 1.2tn programme (Rs 80bn Phase 1 in 2027 Budget)","note":"Electrify Maradana–Ragama, Maradana–Panadura and Kelani Valley (Maradana–Makumbura/Homagama) first. Cabinet-approved Jun 2026; Phase 1 funded in 2027 Budget; works from 2027."},"geometry":{"type":"Point","coordinates":[79.864,6.929]}},{"type":"Feature","properties":{"name":"Hambantota Oil Refinery (Sinopec)","type":"energy","status":"approved","source":"Cabinet committee / Sinopec (via Sunday Times)","source_url":"https://www.sundaytimes.lk/261108/business-times/cabinet-committee-recommends-termination-of-sinopec-deal-662904.html","updated":"2026-11-21","stages":{"proposed":"2019","approved":"2025","construction":"—","operational":"—"},"cost":"US$3.7B","note":"200,000 bpd refinery planned in the Hambantota port zone. Fast-tracked Jan 2025 but no final deal; a Cabinet negotiating committee recommended ending talks (Nov 2026)."},"geometry":{"type":"Point","coordinates":[81.075,6.145]}},{"type":"Feature","properties":{"name":"Trincomalee Energy Hub — oil tank farm","type":"energy","status":"proposed","source":"Ministry of Energy (India–SL–UAE)","source_url":"https://www.lowyinstitute.org/the-interpreter/three-way-energy-play-india-sri-lanka-uae-deal-trincomalee","updated":"2026-11-21","stages":{"proposed":"2022","approved":"2025","construction":"—","operational":"—"},"note":"India–Sri Lanka–UAE agreement (Apr 2025) to develop Trincomalee as a regional energy hub, including the WWII-era oil tank farm."},"geometry":{"type":"Point","coordinates":[81.205,8.556]}},{"type":"Feature","properties":{"name":"Mannar–Pooneryn Wind Power","type":"energy","status":"proposed","source":"Presidential / Cabinet decision (via Daily FT)","source_url":"https://www.ft.lk/news/President-halts-new-Mannar-wind-projects-pending-public-consent/56-783969","updated":"2026-11-21","stages":{"proposed":"2019","approved":"—","construction":"—","operational":"—"},"note":"~484 MW wind. Adani withdrew (Feb 2025); fresh international tenders were pledged (Aug 2025) but none issued. New Mannar Island wind needs residents’ consent (Nov 2025)."},"geometry":{"type":"Point","coordinates":[79.92,8.98]}},{"type":"Feature","properties":{"name":"Sampur Solar Power Park","type":"energy","status":"approved","source":"Ceylon Electricity Board · NTPC","source_url":"https://www.themorning.lk/articles/wZg1n1IYYRgYamA7EW34","updated":"2026-11-21","stages":{"proposed":"2022","approved":"2025","construction":"2026 (target)","operational":"—"},"note":"50 MW solar park, Sampur (Trincomalee district). CEB–NTPC joint venture; permit issued."},"geometry":{"type":"Point","coordinates":[81.27,8.45]}},{"type":"Feature","properties":{"name":"Sobadhanavi LNG Power Plant (Kerawalapitiya)","type":"energy","status":"operational","source":"CEB / LTL — Sobadhanavi (via Daily Mirror)","source_url":"https://www.dailymirror.lk/breaking-news/Sri-Lanka-s-LNG-plans-under-fire-as-plants-cost-50m-a-year-in-standby-mode/108-342594","updated":"2026-11-21","stages":{"proposed":"2019","approved":"2021","construction":"2022","operational":"2025"},"note":"350 MW combined-cycle plant built for LNG. Phase 1 (220 MW) Aug 2024; steam phase (130 MW) Jun 2025. Runs on diesel: no LNG terminal yet (Jun 2026)."},"geometry":{"type":"Point","coordinates":[79.902,6.981]}},{"type":"Feature","properties":{"name":"North Central Province Canal (Mahaweli WSIP)","type":"flood-mitigation","status":"under-construction","source":"Mahaweli Authority / ADB","source_url":"https://www.adb.org/news/adb-approves-200-million-improve-water-food-security-north-central-sri-lanka","updated":"2026-11-21","stages":{"proposed":"2013","approved":"2015","construction":"2016","operational":"2030 (target)"},"cost":"US$200M (ADB Stage 2)","note":"Links Moragahakanda to the North Central dry-zone reservoirs (Huruluwewa, Manankattiya…). 27.7 km main tunnel dug by Jul 2026; ADB Stage 2 benefits ~35,600 farming households."},"geometry":{"type":"Point","coordinates":[80.72,7.85]}},{"type":"Feature","properties":{"name":"Uma Oya Multipurpose Project","type":"energy","status":"operational","source":"Ministry of Irrigation — Uma Oya","source_url":"https://economynext.com/iran-president-to-open-sri-lanka-514mn-irrigation-hydro-power-project-159760/","updated":"2026-11-21","stages":{"proposed":"2008","approved":"2010","construction":"2011","operational":"2024"},"cost":"US$529M","note":"Two dams + a 120 MW hydropower plant, inaugurated 2024. Adds ~231 GWh/yr and irrigates ~4,500 ha of the south-eastern dry zone."},"geometry":{"type":"Point","coordinates":[81,6.9]}},{"type":"Feature","properties":{"name":"Jaffna–Kilinochchi Water Supply & Sanitation","type":"flood-mitigation","status":"operational","source":"NWSDB / ADB (via Sunday Times)","source_url":"https://www.sundaytimes.lk/260830/news/15000-northern-homes-benefit-from-lankas-first-large-scale-desalination-plant-653626.html","updated":"2026-11-21","stages":{"proposed":"2010","approved":"2011","construction":"2013","operational":"2024"},"note":"ADB-funded Thalaiyadi desalination plant (24,000 m³/day) running since Oct 2024; ~15,000 of ~60,000 target households connected by Aug 2026."},"geometry":{"type":"Point","coordinates":[80.015,9.665]}},{"type":"Feature","properties":{"name":"Kankesanthurai (KKS) Harbour rehabilitation","type":"port-terminal","status":"approved","source":"SLPA / High Commission of India","source_url":"https://www.hcicolombo.gov.in/page/ongoing-projects/","updated":"2026-11-21","stages":{"proposed":"2023","approved":"2024","construction":"—","operational":"—"},"cost":"US$61.5M (India grant)","note":"Rehabilitation & modernisation of the northern harbour, Cabinet-approved 2024 under an Indian grant. The bilateral agreement still awaited both Cabinets in Nov 2026; construction has not begun."},"geometry":{"type":"Point","coordinates":[80.043,9.815]}},{"type":"Feature","properties":{"name":"Palaly Airport rehabilitation (Jaffna)","type":"airport","status":"under-construction","source":"AASL (via Jaffna Monitor)","source_url":"https://www.jaffnamonitor.com/india-funded-kks-port-deal-nears-signing-as-palaly-airport-expansion-stalls/","updated":"2026-11-21","stages":{"proposed":"2023","approved":"2025","construction":"2026","operational":"2027 (target)"},"note":"AASL-funded passenger-terminal expansion at Jaffna Int’l (Palaly); Stage 1 under way, completion targeted Jul 2027. Runway extension and land acquisition unresolved."},"geometry":{"type":"Point","coordinates":[80.07,9.792]}},{"type":"Feature","properties":{"name":"Hambantota International Port","type":"port-terminal","status":"operational","source":"Hambantota International Port Group","source_url":"https://www.hipg.lk/","updated":"2026-11-21","stages":{"proposed":"2006","approved":"2008","construction":"2008","operational":"2010"},"note":"Deep-water port on the east–west shipping lane, operated by China Merchants under a 99-year lease; ongoing industrial-zone build-out (the Sinopec refinery is still unconfirmed)."},"geometry":{"type":"Point","coordinates":[81.118,6.122]}},{"type":"Feature","properties":{"name":"Paranthan Chemical Zone","type":"industrial-zone","status":"proposed","source":"Board of Investment (2025 budget)","source_url":"https://investsrilanka.com/","updated":"2026-08-16","stages":{"proposed":"2025","approved":"—","construction":"—","operational":"—"},"cost":"Rs 500M (2025 budget)","note":"Dedicated chemical manufacturing zone at Paranthan (Kilinochchi), seeded by a 2025 budget allocation."},"geometry":{"type":"Point","coordinates":[80.402,9.37]}},{"type":"Feature","properties":{"name":"Kandy Multimodal Transport Terminal (KMTT)","type":"transport-hub","status":"under-construction","source":"Kandy Development Plan 2025–2035 (UDA)","source_url":"https://www.uda.gov.lk/attachments/dev-plans-2025-2035/KandyDevelopmentPlan-English.pdf","updated":"2026-08","page":28},"geometry":{"type":"Point","coordinates":[80.634,7.293]}},{"type":"Feature","properties":{"name":"Getambe Junction Flyover","type":"road","status":"under-construction","source":"Kandy Development Plan 2025–2035 (UDA)","source_url":"https://www.uda.gov.lk/attachments/dev-plans-2025-2035/KandyDevelopme