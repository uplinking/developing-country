---
/**
 * The loading sign for the dashboards: a row of four lamps lighting in turn, like a station
 * indicator, beside what is loading. No skeletons. The page removes the sign when its data
 * arrives, or swaps the words for an error. The same look is available inline through the
 * `.loadsign.inline` classes for small waits (a company's accounts).
 */
interface Props { id: string; label: string }
const { id, label } = Astro.props
---
<div class="loadsign" id={id} role="status" aria-live="polite">
  <span class="ls-lamps" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
  <span class="ls-text">{label}</span>
</div>

<style is:global>
.loadsign{display:flex;align-items:center;justify-content:center;gap:14px;padding:56px 16px;
  font:500 12px/1.3 var(--dc-font-data,'M PLUS 1 Code',ui-monospace,monospace);letter-spacing:.12em;text-transform:uppercase;color:var(--dim,#5f5d56)}
.loadsign.inline{justify-content:flex-start;padding:14px 0;gap:10px;font-size:11px}
.loadsign .ls-lamps{display:inline-flex;gap:4px;padding:6px;border:1px solid var(--ink,#050505);border-radius:2px;background:var(--raised,#fff)}
.loadsign .ls-lamps i{display:block;width:10px;height:10px;border-radius:1px;background:var(--quiet,rgba(5,5,5,.22));animation:ls-lamp 1.2s steps(1,end) infinite}
.loadsign.inline .ls-lamps{padding:3px;gap:3px}
.loadsign.inline .ls-lamps i{width:6px;height:6px}
.loadsign .ls-lamps i:nth-child(2){animation-delay:.3s}
.loadsign .ls-lamps i:nth-child(3){animation-delay:.6s}
.loadsign .ls-lamps i:nth-child(4){animation-delay:.9s}
@keyframes ls-lamp{0%{background:var(--route-system,#00a191)}25%,100%{background:var(--quiet,rgba(5,5,5,.22))}}
.loadsign.failed .ls-lamps i{animation:none;background:var(--route-flag,#d14321)}
@media (prefers-reduced-motion:reduce){
  .loadsign .ls-lamps i{animation:none}
  .loadsign .ls-lamps i:first-child{background:var(--route-system,#00a191)}
}
</style>
