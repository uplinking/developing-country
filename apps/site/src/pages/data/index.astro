---
import { publishedEntries } from '../../lib/cmsCollections'
import { gapFields, linkedGaps } from '../../lib/claims'
import MissingDataCard from '../../components/MissingDataCard.astro'
import DatasetCard from '../../components/DatasetCard.astro'
import SiteLayout from '../../layouts/SiteLayout.astro'
import { articleFields } from '../../lib/content'
import { datasetSearchDocument, gapSearchDocument } from '@developing-country/datasets/search'
import { loadSiteDatasetCatalog } from '../../lib/datasetCatalogCloudflare'
import { EMPTY_STATE, dataIndexView, noun, type DataIndexPayload } from '../../lib/dataIndex'
import { PUBLISHER_TYPES, PUBLIC_DATA_THEMES, datasetMeta, datasetNotes, isDatasetId } from '../../lib/datasets'

// One document for every visitor: filters and search run in the browser from the URL fragment
// (see lib/dataIndex.ts), so this page renders once per cache period, not once per filter.
// EmDash purges these tags whenever an article or data gap changes, so a long life is safe.
if (Astro.cache?.enabled) Astro.cache.set({ tags: ['articles', 'data_gaps'], maxAge: 300, swr: 86400 })

const [entries, gapEntries, catalog] = await Promise.all([
  publishedEntries('articles'),
  publishedEntries('data_gaps'),
  loadSiteDatasetCatalog(),
])
const claims = entries.map((entry) => ({ slug: entry.id, data: articleFields(entry.data) }))
  .filter(({ data }) => data.format === 'analysis' && data.analysisKind === 'tracked_claim')
  .filter(({ data }) => data.claimSourceUrl)
  .map(({ data }) => ({ id: data.id, title: data.claimSourceTitle || data.title, href: data.claimSourceUrl!, missingDataIds: data.missingDataIds, countryCode: data.countryCode, summary: data.dek, sourceTitle: data.claimSourceTitle, sourceUrl: data.claimSourceUrl }))
const gaps = linkedGaps(gapEntries.flatMap((entry) => {
  const gap = gapFields(String((entry.data as Record<string, unknown>).id || entry.id), entry.data)
  return gap ? [gap] : []
}), claims)
const notesByDataset = new Map(
  entries
    .map((entry) => ({ id: entry.id, data: articleFields(entry.data) }))
    .filter((entry) => entry.data.format === 'dataset_note' && isDatasetId(entry.data.datasetId))
    .map((entry) => [entry.data.datasetId!, entry]),
)
const allNotes = datasetNotes.flatMap((dataset) => {
  const article = notesByDataset.get(dataset.id)
  return article ? [{ dataset: datasetMeta(catalog, dataset.id), article }] : []
})
const allRows = [
  ...allNotes.map((row) => ({
    kind: 'available' as const, dataset: row.dataset, article: row.article, gap: null, claims: [],
    document: datasetSearchDocument({
      ...row.dataset,
      title: row.article.data.title,
      dek: row.article.data.dek,
      question: row.article.data.researchQuestion,
      terms: catalog.search.datasets[row.dataset.id],
    }),
  })),
  ...gaps.map((row) => ({
    kind: 'missing' as const, dataset: row.gap, article: null, gap: row.gap, claims: row.claims,
    document: gapSearchDocument(row.gap, row.claims),
  })),
]

const payload: DataIndexPayload = {
  rows: allRows.map(({ kind, dataset, document }) => ({
    id: document.id,
    kind,
    themeIds: [...dataset.themeIds],
    publisherTypeId: dataset.publisher.type.id,
    publisherId: dataset.publisher.id,
    publisherName: dataset.publisher.name,
  })),
  documents: allRows.map((row) => row.document),
  synonyms: catalog.search.synonyms,
  themeIds: PUBLIC_DATA_THEMES.map((theme) => theme.id),
  publisherTypeIds: PUBLISHER_TYPES.map((type) => type.id),
}
// The default view, so the page reads correctly before (or without) JavaScript.
const view = dataIndexView(payload, EMPTY_STATE)
const visible = new Set(view.visibleIds)
const themeLabels = new Map<string, string>(PUBLIC_DATA_THEMES.map((theme) => [theme.id, theme.label]))
const typeLabels = new Map<string, string>(PUBLISHER_TYPES.map((type) => [type.id, type.label]))
// Every publisher across both tabs; the script hides the ones the current filters rule out.
const allPublishers = [...new Map(payload.rows.map((row) => [row.publisherId, row.publisherName])).entries()]
  .sort(([, left], [, right]) => left.localeCompare(right))
const publisherCounts = new Map(view.publishers.map((option) => [option.id, option.count]))
const exampleQueries = ['school dropouts', 'electricity outages', 'Colombo rent', 'Central Bank', 'Jaffna']
// JSON inside <script> must not contain "</": escape it so a CMS string cannot end the element.
const payloadJson = JSON.stringify(payload).replace(/</g, '\\u003c')
---

<SiteLayout
  title="Data"
  description="Explore available datasets and the missing records needed to verify public claims."
>
  <div class="page-shell data-index" id="data-index">
    <section class="data-index__available" aria-labelledby="available-data-title">
      <div class="section-rule">
        <h1 id="available-data-title">Available data</h1>
        <span id="data-count">{view.visibleIds.length} of {view.tabCount} datasets</span>
      </div>

      <form class="data-search" id="data-search" method="get" action="/data" role="search" aria-label="Search data">
        <label for="data-search-input" id="data-search-label">Search datasets</label>
        <div class="data-search__row">
          <input
            id="data-search-input"
            type="search"
            name="q"
            value=""
            maxlength="200"
            autocomplete="off"
            enterkeyhint="search"
            placeholder="Topic, place, publisher or field"
            aria-describedby="data-search-hint"
          />
          <button type="submit">Search</button>
        </div>
        <p class="data-search__hint" id="data-search-hint" aria-live="polite">
          Try {exampleQueries.map((example, index) => <>{index > 0 && ', '}<a data-nav href={`#q=${encodeURIComponent(example)}`}>{example}</a></>)}.
        </p>
      </form>

      <nav class="catalogue-tabs" aria-label="Data availability">
        <a data-nav data-tab="available" href="#" aria-current="page">Available data <span>{view.totals.available}</span></a>
        <a data-nav data-tab="missing" href="#tab=missing">Missing data <span>{view.totals.missing}</span></a>
      </nav>
      <div class="data-index__catalogue" id="data-catalogue">
        <nav class="dataset-filters" aria-label="Filter data">
          <div class="dataset-filters__header">
            <strong>Filter</strong>
            <a data-nav id="data-filter-reset" href="#" hidden>Reset all</a>
          </div>

          <section class="dataset-filter-group" data-filter="theme" aria-labelledby="theme-filter-title">
            <h2 id="theme-filter-title">Theme</h2>
            <ul>
              <li>
                <a data-nav data-filter="theme" data-value="" href="#" aria-current="true">
                  <i aria-hidden="true"></i><span>All themes</span><small>{view.activeCount}</small>
                </a>
              </li>
              {view.themes.map((theme) => (
                <li>
                  <a data-nav data-filter="theme" data-value={theme.id} href={`#theme=${theme.id}`}>
                    <i aria-hidden="true"></i><span>{themeLabels.get(theme.id)}</span><small>{theme.count}</small>
                  </a>
                </li>
              ))}
            </ul>
          </section>

          <section class="dataset-filter-group" data-filter="publisher_type" aria-labelledby="publisher-type-filter-title">
            <h2 id="publisher-type-filter-title">Publisher type</h2>
            <ul>
              <li>
                <a data-nav data-filter="publisherType" data-value="" href="#" aria-current="true">
                  <i aria-hidden="true"></i><span>All types</span><small>{view.activeCount}</small>
                </a>
              </li>
              {view.publisherTypes.map((type) => (
                <li>
                  <a data-nav data-filter="publisherType" data-value={type.id} href={`#publisher_type=${type.id}`}>
                    <i aria-hidden="true"></i><span>{typeLabels.get(type.id)}</span><small>{type.count}</small>
                  </a>
                </li>
              ))}
            </ul>
          </section>

          <section class="dataset-filter-group" data-filter="publisher" aria-labelledby="publisher-filter-title">
            <h2 id="publisher-filter-title">Publisher</h2>
            <ul>
              <li>
                <a data-nav data-filter="publisher" data-value="" href="#" aria-current="true">
                  <i aria-hidden="true"></i><span>All publishers</span><small>{view.activeCount}</small>
                </a>
              </li>
              {allPublishers.map(([id, name]) => (
                <li hidden={!publisherCounts.has(id)}>
                  <a data-nav data-filter="publisher" data-value={id} href={`#publisher=${encodeURIComponent(id)}`}>
                    <i aria-hidden="true"></i><span>{name}</span><small>{publisherCounts.get(id) ?? 0}</small>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        </nav>

        <div class="data-index__results">
          <p class="data-search__notice" id="data-search-notice" hidden></p>
          <div class="dataset-card-grid data-index__grid" id="data-grid">
            {allRows.map(({ dataset, article, gap, claims, document }) => {
              const attrs = { 'data-row-id': document.id, hidden: !visible.has(document.id) }
              return gap ? <MissingDataCard gap={gap} claims={claims} attrs={attrs} /> : article && (
                <DatasetCard
                  href={`/data/${dataset.id}`}
                  title={article.data.title}
                  dek={article.data.dek}
                  country={dataset.version.country}
                  refreshedAt={dataset.version.refreshedAt}
                  themes={dataset.themes}
                  publisher={dataset.publisher}
                  sources={dataset.sources}
                  attrs={attrs}
                />
              )
            })}
          </div>
          <div class="dataset-filter-empty data-search__empty" id="data-empty" hidden></div>
        </div>
      </div>
    </section>
  </div>
  <script type="application/json" id="data-index-payload" set:html={payloadJson} />
</SiteLayout>

<script>
import { dataIndexView, noun, parseState, stateFragment, type DataIndexPayload, type DataIndexState, type DataTab } from '../../lib/dataIndex'

const root = document.getElementById('data-index')
const payloadElement = document.getElementById('data-index-payload')
if (root && payloadElement?.textContent) {
  const payload = JSON.parse(payloadElement.textContent) as DataIndexPayload
  const byId = <T extends HTMLElement>(id: string) => document.getElementById(id) as T
  const grid = byId<HTMLElement>('data-grid')
  const cards = new Map([...grid.querySelectorAll<HTMLElement>('[data-row-id]')].map((card) => [card.dataset.rowId!, card]))
  const input = byId<HTMLInputElement>('data-search-input')
  const hint = byId<HTMLElement>('data-search-hint')
  const exampleHint = [...hint.childNodes].map((node) => node.cloneNode(true))
  const notice = byId<HTMLElement>('data-search-notice')
  const empty = byId<HTMLElement>('data-empty')

  let current: DataIndexState = parseState(location.hash)
  const href = (patch: Partial<DataIndexState>) => {
    const fragment = stateFragment({ ...current, ...patch })
    return fragment ? `#${fragment}` : '#'
  }
  const link = (text: string, patch: Partial<DataIndexState>) => {
    const anchor = document.createElement('a')
    anchor.dataset.nav = ''
    anchor.href = href(patch)
    anchor.textContent = text
    return anchor
  }
  const quoted = (text: string) => `“${text}”`
  const matchWord = (count: number) => count === 1 ? 'matches' : 'match'
  const otherOf = (tab: DataTab): DataTab => tab === 'missing' ? 'available' : 'missing'
  const clearFilters = { theme: '', publisherType: '', publisher: '' }

  function render() {
    const view = dataIndexView(payload, current)
    current = view.state
    const { tab, q } = current
    const other = otherOf(tab)
    const query = view.query

    byId('available-data-title').textContent = tab === 'missing' ? 'Missing data' : 'Available data'
    byId('data-count').textContent = `${view.visibleIds.length} of ${view.tabCount} ${noun(tab, 2)}`
    byId('data-search-label').textContent = `Search ${tab === 'missing' ? 'missing data' : 'datasets'}`
    byId('publisher-type-filter-title').textContent = tab === 'missing' ? 'Data holder type' : 'Publisher type'
    byId('publisher-filter-title').textContent = tab === 'missing' ? 'Expected data holder' : 'Publisher'
    if (document.activeElement !== input) input.value = q
    byId('data-catalogue').toggleAttribute('data-searching', Boolean(query))

    // Search hint.
    hint.replaceChildren()
    if (!query) {
      hint.append(...exampleHint.map((node) => node.cloneNode(true)))
    } else {
      if (view.activeCount === 0) {
        hint.append(`No ${noun(tab, 2)} match ${quoted(q)}.`)
      } else {
        const strong = document.createElement('strong')
        strong.textContent = String(view.activeCount)
        const verb = view.partial ? 'partly match' : matchWord(view.activeCount)
        const filtered = view.filtersActive && view.visibleIds.length !== view.activeCount
          ? `, ${view.visibleIds.length} with these filters`
          : ''
        hint.append(strong, ` ${noun(tab, view.activeCount)} ${verb} ${quoted(q)}${filtered}.`)
      }
      hint.append(' ', link('Clear search', { q: '' }))
      if (query.expansions.length > 0) {
        const related = document.createElement('span')
        related.className = 'data-search__related'
        related.textContent = `Also searched for: ${query.expansions.join(', ')}`
        hint.append(related)
      }
    }

    // Tabs.
    for (const anchor of root!.querySelectorAll<HTMLAnchorElement>('a[data-tab]')) {
      const kind = anchor.dataset.tab as DataTab
      anchor.href = href({ tab: kind })
      if (kind === tab) anchor.setAttribute('aria-current', 'page')
      else anchor.removeAttribute('aria-current')
      anchor.querySelector('span')!.textContent = String(query ? view.fullMatches[kind] : view.totals[kind])
    }

    // Filters.
    const reset = byId<HTMLAnchorElement>('data-filter-reset')
    reset.hidden = !view.filtersActive
    reset.href = href(clearFilters)
    const counts = {
      theme: new Map(view.themes.map((option) => [option.id, option.count])),
      publisherType: new Map(view.publisherTypes.map((option) => [option.id, option.count])),
      publisher: new Map(view.publishers.map((option) => [option.id, option.count])),
    }
    for (const anchor of root!.querySelectorAll<HTMLAnchorElement>('a[data-filter]')) {
      const filter = anchor.dataset.filter as 'theme' | 'publisherType' | 'publisher'
      const value = anchor.dataset.value ?? ''
      const patch: Partial<DataIndexState> = filter === 'publisherType' ? { publisherType: value, publisher: '' } : { [filter]: value }
      anchor.href = href(patch)
      if (current[filter] === value) anchor.setAttribute('aria-current', 'true')
      else anchor.removeAttribute('aria-current')
      const count = value
        ? counts[filter].get(value)
        : filter === 'publisher' && current.publisherType ? counts.publisherType.get(current.publisherType) : view.activeCount
      anchor.parentElement!.hidden = count === undefined
      anchor.querySelector('small')!.textContent = String(count ?? 0)
    }

    // Results, in ranked order.
    const shown = new Set(view.visibleIds)
    for (const id of view.visibleIds) grid.append(cards.get(id)!)
    for (const [id, card] of cards) card.hidden = !shown.has(id)

    // Partial-match notice.
    notice.replaceChildren()
    notice.hidden = !(query && view.partial && view.visibleIds.length > 0)
    if (!notice.hidden) {
      notice.append(`No ${tab === 'missing' ? 'data gap' : 'dataset'} matches every word in ${quoted(q)}. These match some of them.`)
      const full = view.fullMatches[other]
      if (full > 0) {
        notice.append(' ', link(`See ${full} ${noun(other, full)} that ${matchWord(full)} every word`, { tab: other, ...clearFilters }), '.')
      }
    }

    // Empty state.
    empty.replaceChildren()
    empty.hidden = view.visibleIds.length > 0
    if (!empty.hidden) {
      const message = document.createElement('p')
      if (!query) {
        message.textContent = `No ${noun(tab, 2)} match these filters. Try another theme or data holder.`
        empty.append(message)
      } else {
        message.textContent = view.activeCount > 0
          ? `No ${noun(tab, 2)} match ${quoted(q)} with these filters.`
          : `No ${noun(tab, 2)} match ${quoted(q)}.`
        const list = document.createElement('ul')
        const item = (...content: (Node | string)[]) => {
          const li = document.createElement('li')
          li.append(...content)
          list.append(li)
        }
        if (view.activeCount > 0) item(link('Search all themes and publishers', clearFilters))
        const full = view.fullMatches[other]
        if (full > 0) item(link(`See ${full} ${noun(other, full)} that ${matchWord(full)}`, { tab: other, ...clearFilters }))
        item('Try fewer or broader words, or search by publisher (Central Bank), place (Jaffna) or field (tenure).')
        item(link('Clear search', { q: '' }))
        empty.append(message, list)
      }
    }
  }

  function go(state: DataIndexState) {
    current = state
    const fragment = stateFragment(state)
    history.pushState(null, '', `${location.pathname}${fragment ? `#${fragment}` : ''}`)
    render()
  }

  root.addEventListener('click', (event) => {
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
    const anchor = (event.target as Element).closest<HTMLAnchorElement>('a[data-nav]')
    if (!anchor) return
    event.preventDefault()
    go(parseState(new URL(anchor.href).hash))
  })
  byId<HTMLFormElement>('data-search').addEventListener('submit', (event) => {
    event.preventDefault()
    go({ ...current, q: input.value })
  })
  addEventListener('popstate', () => { current = parseState(location.hash); render() })
  addEventListener('hashchange', () => { current = parseState(location.hash); render() })
  if (location.hash.length > 1) render()
}
</script>
