---
import { getEmDashCollection, getEmDashEntry } from 'emdash'
import { COUNTRY_PROFILES, DEFAULT_COUNTRY, isCountryCode } from '@developing-country/countries'
import ArticleCard from '../components/ArticleCard.astro'
import ConnectorFilm from '../components/ConnectorFilm.astro'
import CountryScene from '../components/CountryScene.astro'
import ExplorerFilm from '../components/ExplorerFilm.astro'
import LibraryFilm from '../components/LibraryFilm.astro'
import ShowcasePanel from '../components/ShowcasePanel.astro'
import SiteLayout from '../layouts/SiteLayout.astro'
import { articleFields, countryFields, pageFields } from '../lib/content'
import { loadSiteDatasetCatalog } from '../lib/datasetCatalogCloudflare'
import { datasetMeta, datasetNotes } from '../lib/datasets'
import { CANONICAL_EXPLORER_ORIGIN, resolveExplorerHref } from '../lib/explorer'
import { ASSISTANT_LINKS } from '../lib/assistants'
import { COLOMBO_SHOT, FUNDING_SHOT } from '../lib/films'

const [{ entry: home, cacheHint }, { entries: articles }, { entries: countries }, datasetCatalog] = await Promise.all([
  getEmDashEntry('pages', 'home'),
  getEmDashCollection('articles', { orderBy: { published_at: 'desc' }, limit: 100 }),
  getEmDashCollection('countries', { limit: 6 }),
  loadSiteDatasetCatalog(),
])
if (Astro.cache?.enabled) Astro.cache.set({ ...cacheHint, maxAge: 60, swr: 0 })

const homeData = home ? pageFields(home.data) : null
const articleCards = articles
  .map((entry) => ({ id: entry.id, data: articleFields(entry.data) }))
  .filter((article) => article.data.format === 'analysis' && article.data.analysisKind === 'essay')
  .slice(0, 3)
const countryCards = countries
  .map((entry) => ({ id: entry.id, data: countryFields(entry.data) }))
  .filter((entry) => isCountryCode(entry.data.code))

const featuredCountry = countryCards[0]
const heroCountry = featuredCountry && isCountryCode(featuredCountry.data.code) ? featuredCountry.data.code : DEFAULT_COUNTRY
const heroCountryName = COUNTRY_PROFILES[heroCountry].name
const localExplorerOrigin = import.meta.env.DEV ? 'http://127.0.0.1:5173' : undefined
const explore = (url: string) => resolveExplorerHref(url, localExplorerOrigin)
const explorerHref = explore(`${CANONICAL_EXPLORER_ORIGIN}/`)
const indicatorCount = datasetNotes.filter((note) => note.preview?.kind === 'chart').length
/** The datasets panel films these cards exactly as /data renders them. */
const libraryIds = [
  'census-age-sex-dsd',
  'ccpi-monthly',
  'labour-force',
  'merchandise-trade-monthly',
  'government-fiscal-operations-annual',
  'electricity-customers-sales',
  'poverty-headcount-district',
  'water-supply-connections-coverage',
  'gdp-by-industry',
] as const satisfies readonly Parameters<typeof datasetMeta>[1][]
const noteDeks = new Map(articles.map((entry) => [entry.id, articleFields(entry.data).dek]))
const libraryCards = libraryIds.map((id) => {
  const dataset = datasetMeta(datasetCatalog, id)
  return {
    href: `/data/${id}`,
    title: dataset.title,
    dek: noteDeks.get(id) ?? null,
    country: dataset.version.country,
    refreshedAt: dataset.version.refreshedAt,
    themes: dataset.themes,
    publisher: dataset.publisher,
    sources: dataset.sources,
  }
})
/** What the app is made of, one panel each: what we built and why it helps. More will join as they are built. */
const showcase = [
  {
    title: 'Datasets',
    summary: 'We gather the public datasets that show how the country is doing, on urban development, the economy, prices, jobs, public finances and social conditions, so you can keep an eye on what is changing in one place.',
    actions: [{ href: '/data', label: 'Datasets' }],
    tone: 'lilac' as const,
    film: 'library' as const,
  },
  {
    title: 'Geospatial data',
    summary: 'We put that data on a map, in layers for people, transport, schools, hospitals, land cover and planned developments, so you can see where things are happening and how they connect.',
    actions: [{ href: explorerHref, label: 'Geospatial data' }],
    tone: 'pink' as const,
    film: 'map' as const,
  },
  {
    title: 'Funding dashboard',
    summary: 'We track public projects and the money behind them, from announcement to approval, contract and payment, so you can see who is funding what and how far it has got.',
    actions: [{ href: '/funding', label: 'Funding dashboard' }],
    tone: 'peach' as const,
    film: 'funding' as const,
  },
  {
    title: 'MCP',
    summary: 'We publish all of this as an MCP connector, so you can ask Claude or ChatGPT about the country in plain language and get answers that cite their source.',
    actions: ASSISTANT_LINKS.map((link) => ({ ...link, external: true })),
    tone: 'sky' as const,
    film: 'connector' as const,
  },
]
---

<SiteLayout
  title="developing-country.org"
  description={homeData?.description || 'Sri Lanka’s public data, brought together and explained.'}
  header={false}
>
  {home && homeData ? (
    <div class="report-home" {...home.edit.content}>
      <section class="report-hero" aria-labelledby="report-title">
        <CountryScene code={heroCountry} class="report-hero__scene" />
        <div class="report-hero__content">
          <div class="report-hero__title-wrap">
            <h1 id="report-title"><span>Developing</span><span>country<sup class="report-hero__badge">{heroCountryName}</sup></span></h1>
          </div>
        </div>
      </section>

      <section class="mission-fold" aria-label="Why I’m building Developing Country">
        <div class="mission-fold__inner">
          <figure class="mission-fold__quote">
            <blockquote>“I want to help build the data infrastructure that developing countries need to grow. What an achievement it would be to go from developing to developed in a lifetime.”</blockquote>
          </figure>
        </div>
      </section>

      <section class="showcase" aria-label="What is here">
        {showcase.map(({ film, ...panel }, index) => (
          <ShowcasePanel index={index + 1} {...panel}>
            {film === 'library' && <LibraryFilm slot="film" class="showcase-panel__film" cards={libraryCards} count={indicatorCount} />}
            {film === 'map' && (
              <ExplorerFilm
                slot="film"
                class="showcase-panel__film"
                shot={COLOMBO_SHOT}
                label="The explorer map of Colombo with Metro Bus lines, walking coverage, schools and hospitals switched on, and a selected street's walking readout open."
              />
            )}
            {film === 'funding' && (
              <ExplorerFilm
                slot="film"
                class="showcase-panel__film"
                shot={FUNDING_SHOT}
                plate="developing-country.org/funding"
                label="The funding dashboard: money by stage from announced to paid, a weekly timeline of events, and the feed of funding decisions with their funders."
              />
            )}
            {film === 'connector' && <ConnectorFilm slot="film" class="showcase-panel__film" />}
          </ShowcasePanel>
        ))}
      </section>

      {articleCards.length > 0 && <section class="research-showcase">
        <div class="research-showcase__inner">
          <div class="research-showcase__heading">
            <p class="report-label">Writing</p>
            <h2>Read the argument. Check the source.</h2>
            <a class="text-link" href="/analysis">Read our thoughts <span aria-hidden="true">→</span></a>
          </div>
          <div class="article-grid article-grid--showcase">
            {articleCards.map((article) => (
              <ArticleCard
                href={article.data.format === 'dataset_note' ? `/data/${article.id}` : `/analysis/${article.id}`}
                title={article.data.title}
                dek={article.data.dek}
                country={article.data.countryCode}
                publishedAt={article.data.publishedAt}
                format={article.data.format}
                analysisKind={article.data.analysisKind}
                claimStatus={article.data.claimStatus}
              />
            ))}
          </div>
        </div>
      </section>}
    </div>
  ) : (
    <div class="page-shell empty-state">The public site is waiting for its EmDash seed.</div>
  )}
</SiteLayout>
