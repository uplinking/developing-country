<script>
// @ts-nocheck -- plain DOM code; the filtering rules it relies on are typed and tested in src/lib/companyFilter.ts.
import { COMPANY_SECTOR_FAMILIES, COMPANY_SECTOR_TAGS, COMPANY_SECTOR_BY_TAG } from '@developing-country/datasets/company-sectors'
import * as FIG from '../lib/companyFigures'
import { ABROAD_KEYS, ABROAD_LABEL, EMPTY_FILTER, countBy, ownershipOf, filterToParams, matches, parseFilter, searchText, sortRows, summarize, tagsOf, toQuery } from '../lib/companyFilter'

const root = document.getElementById('cmap')
const BASE = root.dataset.base
const $ = id => document.getElementById(id)
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c])
const FAMILY = new Map(COMPANY_SECTOR_TAGS.map(t => [t.tag, t.family]))
const tagLabel = t => COMPANY_SECTOR_BY_TAG.get(t)?.label ?? t
const OWNER = { listed: 'Listed on the CSE', state_owned: 'State-owned', family_group: 'Family-owned', foreign_multinational: 'Foreign-owned',
  private_local: 'Privately owned (Sri Lankan)', private: 'Privately owned (Sri Lankan)', joint_venture: 'Joint venture', listed_elsewhere: 'Part of a listed group',
  in_group: 'Owned by a group', unknown: 'Not classified', '': 'Not classified' }
const REL = { ultimate_parent: 'Parent company', subsidiary: 'Subsidiary', associate: 'Associate', joint_venture: 'Joint venture',
  member_per_web_sources: 'Part', named_in_report_only: 'Named in the annual report', former_holding: 'Formerly held', investment_not_consolidated: 'Minority investment' }
// How a company relates to its group, as a phrase: “Subsidiary of X”, “Part of X”, “Named in X’s annual report”.
const relPhrase = (r, name) => r.relation_to_group === 'named_in_report_only' ? `Named in ${name}’s annual report`
  : r.relation_to_group === 'former_holding' ? `Formerly held by ${name}` : `${REL[r.relation_to_group] ?? 'Part'} of ${name}`
const ISIC_LABEL = new Map()

function fmtLkr(v) {
  if (v === null || v === undefined) return '<span class="dash">–</span>'
  const a = Math.abs(v)
  if (a >= 1e12) return 'LKR ' + (v / 1e12).toPrecision(3) + 'tn'
  if (a >= 1e9) return 'LKR ' + +(v / 1e9).toPrecision(3) + 'bn'
  if (a >= 1e6) return 'LKR ' + +(v / 1e6).toPrecision(3) + 'm'
  return 'LKR ' + Math.round(v).toLocaleString('en')
}
const plural = (n, w) => `${n.toLocaleString('en')} ${n === 1 ? w : w === 'company' ? 'companies' : w + 's'}`
const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']
const fmtDate = d => /^\d{4}-\d{2}-\d{2}$/.test(d) ? `${+d.slice(8)} ${MONTHS[+d.slice(5, 7) - 1]} ${d.slice(0, 4)}` : d
// revenue_basis for web-researched companies is stored as “press_report (2009)”: say it in words
const BASIS = { reported_by_company: 'Company’s own figure', regulator_filing: 'Regulator filing', rating_agency: 'Rating agency report', press_report: 'Press report', ranking: 'Published ranking', estimate_range: 'Estimate' }
function basisText(b) {
  if (!b) return 'Source linked below'
  const m = b.match(/^([a-z_]+)(?: \((.*)\))?$/)
  if (!m || !BASIS[m[1]]) return b
  const yr = m[2] && m[2] !== 'None' ? (m[2].match(/\d{4}/) ?? [''])[0] : ''
  return BASIS[m[1]] + (yr ? `, ${yr}` : '')
}
const fmtPctPlain = v => v === null || v === undefined ? '–' : `${v > 0 ? '+' : ''}${v.toFixed(1)}%`
const fmtInt = v => v === null || v === undefined ? '<span class="dash">–</span>' : Math.round(v).toLocaleString('en')
const fmtPct = v => v === null || v === undefined ? '<span class="dash">–</span>'
  : `<span class="${v > 0 ? 'up' : v < 0 ? 'down' : ''}">${v > 0 ? '+' : ''}${v.toFixed(1)}%</span>`

let ROWS = [], BYID = new Map(), TEXT = new Map(), RELS = { from: new Map(), to: new Map() }, SECT = null
let F = parseFilter(new URLSearchParams(location.search))
let shown = 50, openId = null, menuOpen = null

/* ---------- filter menus ---------- */
const GROWTH = [['', 'Any growth', null, null], ['g0', 'Up', 0.0001, null], ['g10', 'Up more than 10%', 10, null], ['g25', 'Up more than 25%', 25, null], ['d0', 'Down', null, -0.0001]]
const PERF = { profitable_growing: 'Profitable and growing in real terms', profitable_shrinking: 'Profitable but shrinking in real terms', profitable: 'Profitable',
  back_to_profit: 'Back to profit', fell_into_loss: 'Fell into loss', loss_both_years: 'Loss in both years', negative_equity: 'Negative equity (owes more than it owns)' }
const PERF_SHORT = { profitable_growing: 'Profitable · growing', profitable_shrinking: 'Profitable · shrinking', profitable: 'Profitable', back_to_profit: 'Back to profit', fell_into_loss: 'Fell into loss', loss_both_years: 'Loss both years', negative_equity: 'Negative equity' }
const PERF_TONE = { profitable_growing: 'good', back_to_profit: 'good', profitable_shrinking: 'warn', profitable: '', fell_into_loss: 'bad', loss_both_years: 'bad', negative_equity: 'bad' }
const SIZE = [['', 'Any revenue', null], ['1', 'LKR 1bn or more', 1], ['10', 'LKR 10bn or more', 10], ['50', 'LKR 50bn or more', 50], ['100', 'LKR 100bn or more', 100]]
const STAFF = [['', 'Any number', null], ['100', '100+ employees', 100], ['500', '500+ employees', 500], ['1000', '1,000+ employees', 1000], ['5000', '5,000+ employees', 5000]]
const LISTED = [['', 'Listed and unlisted'], ['yes', 'Listed on the CSE'], ['no', 'Unlisted']]

function counts(key) {
  // option counts under every other active filter, so a menu shows what picking it would leave
  const g = { ...F, [key]: Array.isArray(F[key]) ? [] : EMPTY_FILTER[key] }
  if (key === 'growth') { g.growthMin = null; g.growthMax = null }
  if (key === 'performance') g.performance = []
  return ROWS.filter(r => matches(r, g, FAMILY, TEXT.get(r.company_id)))
}

const MENUS = {
  sector: {
    label: () => F.sectors.length + F.families.length ? 'Sector · ' + (F.sectors.length + F.families.length) : 'Sector',
    on: () => F.sectors.length + F.families.length > 0,
    items() {
      const base = counts('sectors').filter(r => matches(r, { ...EMPTY_FILTER, scope: 'all', families: [] }, FAMILY))
      const fam = new Map(countBy(base, r => tagsOf(r).map(t => FAMILY.get(t))))
      const tag = new Map(countBy(base, tagsOf))
      const out = []
      for (const [fk, fl] of Object.entries(COMPANY_SECTOR_FAMILIES)) {
        out.push({ id: 'f:' + fk, text: fl, n: fam.get(fk) ?? 0, sel: F.families.includes(fk), cls: 'fam' })
        for (const t of COMPANY_SECTOR_TAGS.filter(t => t.family === fk && (tag.get(t.tag) ?? 0) > 0))
          out.push({ id: 't:' + t.tag, text: t.label, n: tag.get(t.tag), sel: F.sectors.includes(t.tag), cls: 'sub', title: t.meaning })
      }
      return out
    },
    pick(id) {
      const [k, v] = id.split(':'), arr = k === 'f' ? F.families : F.sectors
      const i = arr.indexOf(v); i >= 0 ? arr.splice(i, 1) : arr.push(v)
    }, multi: true,
  },
  ownership: {
    label: () => F.ownership.length ? 'Ownership · ' + F.ownership.length : 'Ownership', on: () => F.ownership.length > 0,
    items: () => countBy(counts('ownership'), r => [ownershipOf(r)]).map(([k, n]) => ({ id: k, text: OWNER[k] ?? k, n, sel: F.ownership.includes(k) })),
    pick(id) { const i = F.ownership.indexOf(id); i >= 0 ? F.ownership.splice(i, 1) : F.ownership.push(id) }, multi: true,
  },
  listed: {
    label: () => F.listed ? LISTED.find(x => x[0] === F.listed)[1] : 'Listed', on: () => !!F.listed,
    items: () => LISTED.map(([k, t]) => ({ id: k, text: t, sel: F.listed === k })), pick(id) { F.listed = id },
  },
  size: {
    label: () => F.revenueMinBn !== null ? `Revenue LKR ${F.revenueMinBn}bn+` : 'Revenue', on: () => F.revenueMinBn !== null,
    items: () => SIZE.map(([k, t, v]) => ({ id: k, text: t, sel: (F.revenueMinBn ?? null) === v })),
    pick(id) { F.revenueMinBn = SIZE.find(x => x[0] === id)[2] },
  },
  growth: {
    label: () => { const g = GROWTH.find(x => x[2] === F.growthMin && x[3] === F.growthMax), b = F.growthBasis === 'real' ? 'Real growth' : 'Nominal growth'
      return g && g[0] ? `${b}: ${g[1].toLowerCase()}` : (F.growthMin !== null || F.growthMax !== null ? `${b} (custom)` : 'Revenue growth') },
    on: () => F.growthMin !== null || F.growthMax !== null,
    items: () => [{ id: 'b:real', text: 'Real growth (after inflation)', sel: F.growthBasis === 'real', cls: 'fam' }, { id: 'b:nominal', text: 'Nominal growth (in rupees, as reported)', sel: F.growthBasis === 'nominal', cls: 'fam' },
      ...GROWTH.map(([k, t, lo, hi]) => ({ id: k, text: t, sel: F.growthMin === lo && F.growthMax === hi, cls: 'sub' }))],
    pick(id) { if (id.startsWith('b:')) { F.growthBasis = id.slice(2); return } const g = GROWTH.find(x => x[0] === id); F.growthMin = g[2]; F.growthMax = g[3] },
    multi: true,
    note: 'Revenue growth compares the latest financial year with the one before, from the same annual report (listed companies only). Real growth removes inflation, using the average change in the Colombo Consumer Price Index over each company’s financial year.',
  },
  performance: {
    label: () => F.performance.length ? 'Performance · ' + F.performance.length : 'Performance', on: () => F.performance.length > 0,
    items: () => { const b = new Map(countBy(counts('performance'), r => [r.performance ?? ''])); return Object.entries(PERF).map(([k, t]) => ({ id: k, text: t, n: b.get(k) ?? 0, sel: F.performance.includes(k) })) },
    pick(id) { const i = F.performance.indexOf(id); i >= 0 ? F.performance.splice(i, 1) : F.performance.push(id) }, multi: true,
    note: 'From profit after tax and real revenue growth in the latest two annual reports. Listed companies only.',
  },
  staff: {
    label: () => F.employeesMin !== null ? `${F.employeesMin.toLocaleString('en')}+ employees` : 'Employees', on: () => F.employeesMin !== null,
    items: () => STAFF.map(([k, t, v]) => ({ id: k, text: t, sel: (F.employeesMin ?? null) === v })),
    pick(id) { F.employeesMin = STAFF.find(x => x[0] === id)[2] },
  },
  abroad: {
    label: () => F.abroad.length ? 'Exports and overseas · ' + F.abroad.length : 'Exports and overseas', on: () => F.abroad.length > 0,
    items() { const b = counts('abroad'); return ABROAD_KEYS.map(k => ({ id: k, text: ABROAD_LABEL[k], n: b.filter(r => k === 'foreign_subsidiaries' ? r.foreign_subsidiaries > 0 : r[k] === true).length, sel: F.abroad.includes(k) })) },
    pick(id) { const i = F.abroad.indexOf(id); i >= 0 ? F.abroad.splice(i, 1) : F.abroad.push(id) }, multi: true,
  },
  isic: {
    label: () => F.isic.length ? 'Industry · ' + F.isic.length : 'Industry (UN classification)', on: () => F.isic.length > 0,
    items: () => countBy(counts('isic'), r => [r.isic_section ?? '']).filter(([k]) => k).sort((a, b) => a[0].localeCompare(b[0]))
      .map(([k, n]) => ({ id: k, text: ISIC_LABEL.get(k) ?? k, n, sel: F.isic.includes(k) })),
    pick(id) { const i = F.isic.indexOf(id); i >= 0 ? F.isic.splice(i, 1) : F.isic.push(id) }, multi: true,
  },
}

function drawFilters() {
  $('filters').innerHTML = Object.entries(MENUS).map(([k, m]) =>
    `<span class="fbtn-w"><button type="button" class="fbtn${m.on() ? ' on' : ''}" data-menu="${k}" aria-haspopup="listbox" aria-expanded="${menuOpen === k}">${esc(m.label())}<span class="car">▼</span></button></span>`).join('')
  if (menuOpen) openMenu(menuOpen, false)
}

function openMenu(key, focus = true) {
  const host = $('filters').querySelector(`[data-menu="${key}"]`)?.parentElement
  if (!host) return
  const m = MENUS[key]
  const items = m.items()
  const ul = document.createElement('ul')
  ul.className = 'menu'; ul.setAttribute('role', 'listbox'); ul.setAttribute('aria-multiselectable', m.multi ? 'true' : 'false')
  ul.innerHTML = (m.note ? `<li class="grp" role="presentation" style="text-transform:none;letter-spacing:0;white-space:normal;max-width:280px">${esc(m.note)}</li>` : '') +
    items.map(it => `<li role="option" tabindex="-1" data-id="${esc(it.id)}" aria-selected="${it.sel}" class="${it.cls ?? ''}"${it.title ? ` title="${esc(it.title)}"` : ''}><span>${esc(it.text)}</span>${it.n !== undefined ? `<span class="n">${it.n}</span>` : ''}</li>`).join('')
  host.appendChild(ul)
  host.querySelector('.fbtn').setAttribute('aria-expanded', 'true')
  const opts = [...ul.querySelectorAll('[role=option]')]
  ul.addEventListener('click', e => {
    const li = e.target.closest('[role=option]'); if (!li) return
    m.pick(li.dataset.id); shown = 50
    if (!m.multi) menuOpen = null
    update(); if (m.multi) ul.ownerDocument.querySelector(`[data-menu="${key}"]`)?.parentElement.querySelector(`[data-id="${CSS.escape(li.dataset.id)}"]`)?.focus()
  })
  ul.addEventListener('keydown', e => {
    const i = opts.indexOf(document.activeElement)
    if (e.key === 'ArrowDown') { e.preventDefault(); opts[Math.min(i + 1, opts.length - 1)]?.focus() }
    else if (e.key === 'ArrowUp') { e.preventDefault(); opts[Math.max(i - 1, 0)]?.focus() }
    else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); document.activeElement.click() }
    else if (e.key === 'Escape') { closeMenu(true) }
  })
  if (focus) (opts.find(o => o.getAttribute('aria-selected') === 'true') ?? opts[0])?.focus()
}
function closeMenu(refocus) {
  const k = menuOpen; menuOpen = null
  document.querySelectorAll('.cmap .menu').forEach(u => u.remove())
  document.querySelectorAll('.cmap .fbtn').forEach(b => b.setAttribute('aria-expanded', 'false'))
  if (refocus && k) $('filters').querySelector(`[data-menu="${k}"]`)?.focus()
}
$('filters').addEventListener('click', e => {
  const b = e.target.closest('.fbtn'); if (!b) return
  const k = b.dataset.menu
  if (menuOpen === k) { closeMenu(); return }
  closeMenu(); menuOpen = k; b.setAttribute('aria-expanded', 'true'); openMenu(k)
})
document.addEventListener('click', e => { if (menuOpen && !e.target.closest('.fbtn-w')) closeMenu() })
document.addEventListener('keydown', e => { if (e.key === 'Escape' && menuOpen) closeMenu(true) })

/* ---------- chips ---------- */
function chips() {
  const c = []
  if (F.group) c.push(['group', 'Group: ' + (BYID.get(F.group)?.name ?? F.group)])
  if (F.q) c.push(['q', `“${F.q}”`])
  F.families.forEach(v => c.push(['family:' + v, COMPANY_SECTOR_FAMILIES[v] ?? v]))
  F.sectors.forEach(v => c.push(['sector:' + v, tagLabel(v)]))
  F.ownership.forEach(v => c.push(['ownership:' + v, OWNER[v] ?? v]))
  if (F.listed) c.push(['listed', LISTED.find(x => x[0] === F.listed)[1]])
  F.isic.forEach(v => c.push(['isic:' + v, 'Industry: ' + (ISIC_LABEL.get(v) ?? v)]))
  if (F.revenueMinBn !== null) c.push(['size', `Revenue LKR ${F.revenueMinBn}bn or more`])
  if (F.growthMin !== null || F.growthMax !== null) c.push(['growth', MENUS.growth.label()])
  F.performance.forEach(v => c.push(['performance:' + v, PERF[v] ?? v]))
  if (F.employeesMin !== null) c.push(['staff', `${F.employeesMin.toLocaleString('en')}+ employees`])
  F.abroad.forEach(v => c.push(['abroad:' + v, ABROAD_LABEL[v]]))
  $('chips').innerHTML = c.map(([k, t]) => `<span class="chip">${esc(t)}<button type="button" data-chip="${esc(k)}" aria-label="Remove ${esc(t)}">×</button></span>`).join('') +
    (c.length > 1 ? '<button type="button" class="clear" data-chip="*">Clear all</button>' : '')
}
$('chips').addEventListener('click', e => {
  const b = e.target.closest('[data-chip]'); if (!b) return
  const [k, v] = b.dataset.chip.split(/:(.*)/s)
  const drop = (arr, x) => arr.splice(arr.indexOf(x), 1)
  if (k === '*') { const scope = F.scope; F = { ...EMPTY_FILTER, families: [], sectors: [], ownership: [], isic: [], abroad: [], performance: [], scope: scope === 'all' && !F.group ? 'all' : 'groups' }; $('fq').value = '' }
  else if (k === 'group') { F.group = ''; F.scope = 'groups' }
  else if (k === 'q') { F.q = ''; $('fq').value = '' }
  else if (k === 'family') drop(F.families, v)
  else if (k === 'sector') drop(F.sectors, v)
  else if (k === 'ownership') drop(F.ownership, v)
  else if (k === 'isic') drop(F.isic, v)
  else if (k === 'abroad') drop(F.abroad, v)
  else if (k === 'performance') drop(F.performance, v)
  else if (k === 'listed') F.listed = ''
  else if (k === 'size') F.revenueMinBn = null
  else if (k === 'growth') { F.growthMin = null; F.growthMax = null }
  else if (k === 'staff') F.employeesMin = null
  shown = 50; update()
})

/* ---------- scope, search, sort ---------- */
root.querySelectorAll('[data-scope]').forEach(b => b.addEventListener('click', () => { F.scope = b.dataset.scope; F.group = ''; shown = 50; update() }))
let qTimer = 0
$('fq').addEventListener('input', () => { clearTimeout(qTimer); qTimer = setTimeout(() => { F.q = $('fq').value.trim(); shown = 50; update(true) }, 120) })
$('find').addEventListener('submit', e => { e.preventDefault(); F.q = $('fq').value.trim(); update() })
$('fqx').addEventListener('click', () => { $('fq').value = ''; F.q = ''; update(); $('fq').focus() })
root.querySelectorAll('[data-sort]').forEach(b => b.addEventListener('click', () => {
  const k = b.dataset.sort
  if (F.sort === k) F.desc = !F.desc; else { F.sort = k; F.desc = k !== 'name' }
  update()
}))
$('more').addEventListener('click', () => { shown += 100; drawRows(current) })

/* ---------- drawing ---------- */
let current = []
function update(replace = false) {
  current = sortRows(ROWS.filter(r => matches(r, F, FAMILY, TEXT.get(r.company_id))), F.sort, F.desc)
  const qs = filterToParams(F).toString()
  history[replace ? 'replaceState' : 'pushState'](null, '', qs ? '?' + qs : location.pathname)
  root.querySelectorAll('[data-scope]').forEach(b => b.setAttribute('aria-pressed', String(!F.group && b.dataset.scope === F.scope)))
  root.querySelectorAll('[data-sort]').forEach(b => b.dataset.sort === F.sort ? b.setAttribute('aria-sort', F.desc ? 'descending' : 'ascending') : b.removeAttribute('aria-sort'))
  $('fqx').hidden = !F.q
  drawFilters(); chips(); drawSummary(); drawBreaks(); drawRows(current)
  $('copyta').hidden = true
}

function drawSummary() {
  const s = summarize(current)
  const head = F.group ? `<b>${s.companies.toLocaleString('en')}</b> ${s.companies === 1 ? 'company' : 'companies'} in ${esc(BYID.get(F.group)?.name ?? 'this group')}`
    : F.scope === 'groups' ? `<b>${s.groups_with_members.toLocaleString('en')}</b> ${s.groups_with_members === 1 ? 'group' : 'groups'} and <b>${(s.companies - s.groups_with_members).toLocaleString('en')}</b> ${s.companies - s.groups_with_members === 1 ? 'company' : 'companies'} outside any group` : `<b>${s.companies.toLocaleString('en')}</b> ${s.companies === 1 ? 'company' : 'companies'} in <b>${s.groups.toLocaleString('en')}</b> ${s.groups === 1 ? 'group' : 'groups'}`
  $('lead').innerHTML = head
  const k = (l, v, sub) => `<div class="kpi"><p class="lbl">${l}</p><span class="v">${v}</span><span class="s">${sub}</span></div>`
  const top = F.scope === 'groups' && !F.group
  $('kpis').innerHTML =
    (top ? k('Groups', s.groups_with_members.toLocaleString('en'), `plus ${plural(s.companies - s.groups_with_members, 'company')} outside any group`)
      : k('Companies', s.companies.toLocaleString('en'), `in ${plural(s.groups, 'group')}`)) +
    k('Combined revenue', s.revenueCount ? fmtLkr(s.revenueLkr) : '–', `${s.revenueCount.toLocaleString('en')} report it; subsidiaries counted once, inside their group`) +
    k('Median real growth', s.medianRealGrowth === null ? '–' : fmtPct(s.medianRealGrowth), s.growthCount ? `after inflation; ${fmtPctPlain(s.medianNominalGrowth)} nominal. ${s.growthCount} listed companies` : 'listed companies only') +
    k('Employees', s.employeesCount ? fmtInt(s.employees) : '–', `${s.employeesCount.toLocaleString('en')} report a headcount`) +
    k('Loss-making', s.loss.toLocaleString('en'), 'loss or negative equity in the latest report') +
    k('Exporters', s.exporters.toLocaleString('en'), `plus ${s.overseas.toLocaleString('en')} with overseas subsidiaries or operations`)
}

function drawBreaks() {
  const fam = countBy(current, r => r.primary_sector ? [FAMILY.get(r.primary_sector)] : []).slice(0, 12)
  const max = Math.max(1, ...fam.map(x => x[1]))
  $('bySector').innerHTML = fam.length ? fam.map(([k, n]) => `<li><button type="button" data-fam="${esc(k)}" aria-pressed="${F.families.includes(k)}"><span class="t">${esc(COMPANY_SECTOR_FAMILIES[k] ?? k)}</span><span class="b"><i style="width:${(n / max * 100).toFixed(1)}%;background:var(--sec-${esc(k)}, var(--teal))"></i></span><span class="c">${n}</span></button></li>`).join('')
    : '<li class="empty">No companies with a sector match.</li>'
  const own = countBy(current, r => [ownershipOf(r)]).slice(0, 8)
  const m2 = Math.max(1, ...own.map(x => x[1]))
  $('byOwner').innerHTML = own.map(([k, n]) => `<li><button type="button" data-own="${esc(k)}" aria-pressed="${F.ownership.includes(k)}"><span class="t">${esc(OWNER[k] ?? k)}</span><span class="b"><i style="width:${(n / m2 * 100).toFixed(1)}%"></i></span><span class="c">${n}</span></button></li>`).join('')
}
$('bySector').addEventListener('click', e => { const b = e.target.closest('[data-fam]'); if (!b) return; MENUS.sector.pick('f:' + b.dataset.fam); shown = 50; update() })
$('byOwner').addEventListener('click', e => { const b = e.target.closest('[data-own]'); if (!b) return; MENUS.ownership.pick(b.dataset.own); shown = 50; update() })

function abroadFlags(r) {
  const f = []
  if (r.exports) f.push('exporter')
  if (r.foreign_subsidiaries > 0) f.push(`${r.foreign_subsidiaries} overseas subsidiar${r.foreign_subsidiaries === 1 ? 'y' : 'ies'}`)
  if (r.foreign_owned) f.push('foreign parent')
  if (!f.length && r.operates_abroad) f.push(r.country && r.country !== 'Sri Lanka' ? 'registered in ' + esc(r.country) : 'operates overseas')
  return f.join(' · ')
}

function drawRows(list) {
  const body = $('rows')
  if (!list.length) { body.innerHTML = '<tr><td colspan="7" class="empty">No companies match these filters.</td></tr>'; $('more').hidden = true; return }
  body.innerHTML = list.slice(0, shown).map(r => {
    const grp = r.is_group_head ? (r.group_companies > 1 ? `Parent of a group of ${r.group_companies} companies` : (r.ownership && r.ownership !== 'unknown' ? OWNER[r.ownership] ?? '' : '')) : relPhrase(r, esc(r.group_name))
    const tags = tagsOf(r).slice(0, 2).map(badge).join('')
    const row = `<tr class="r${openId === r.company_id ? ' open' : ''}" data-id="${esc(r.company_id)}" tabindex="0" aria-expanded="${openId === r.company_id}">
      <td><span class="nm">${esc(r.name)}</span>${r.cse_symbol ? `<span class="sym">${esc(r.cse_symbol.split('.')[0])}</span>` : ''}<span class="grp-n">${grp}</span>${r.performance ? `<span class="perf ${PERF_TONE[r.performance]}" title="${esc(PERF[r.performance])}">${esc(PERF_SHORT[r.performance])}</span>` : ''}</td>
      <td class="hide-s">${tags || '<span class="dash">–</span>'}</td>
      <td class="num">${fmtLkr(r.revenue_lkr)}${revenueNote(r) ? `<span class="sub">${revenueNote(r)}</span>` : ''}</td>
      <td class="num">${fmtPct(r.revenue_growth_real_pct)}${r.revenue_growth_nominal_pct !== null ? `<span class="sub">${fmtPctPlain(r.revenue_growth_nominal_pct)} nominal</span>` : ''}</td>
      <td class="num hide-s">${r.net_profit_margin_pct !== null ? r.net_profit_margin_pct.toFixed(1) + '%' : '<span class="dash">–</span>'}</td>
      <td class="num hide-s">${fmtInt(r.employees)}</td>
      <td class="hide-s flags">${abroadFlags(r)}</td></tr>`
    return row + (openId === r.company_id ? `<tr class="d"><td colspan="7">${detail(r)}</td></tr>` : '')
  }).join('')
  fitWeb()
  $('more').hidden = list.length <= shown
  $('more').textContent = `Show more (${(list.length - shown).toLocaleString('en')} more)`
}

/* ---------- detail ---------- */
const KIND_LABEL = { sales: 'Revenue', sales_incl_excise: 'Revenue (including excise duty)', gross_income: 'Gross income', insurance_premium: 'Gross written premium', interest_income: 'Interest income', as_reported: 'Revenue' }
const HOLDER_TYPE = { person: 'person', company: 'company', state: 'the state', state_enterprise: 'state enterprise', pension_fund: 'pension fund', fund: 'investment fund', nominee_or_custodian: 'custodian for investors', other: 'other', group: 'group' }
/** Why a revenue figure should not be compared directly, in a few words; '' when it can be. */
function revenueNote(r) {
  if (r.revenue_lkr === null) return ''
  if (r.revenue_comparable === false) return r.revenue_year ? `${r.revenue_year} figure` : 'older or part-year figure'
  if (r.revenue_kind === 'gross_income') return 'gross income'
  if (r.revenue_kind === 'insurance_premium') return 'premium'
  if (r.revenue_kind === 'interest_income') return 'interest income'
  if (r.revenue_kind === 'sales_incl_excise') return 'incl. excise'
  return ''
}
function holderList(r) {
  const hs = HOLD ? (HOLD.get(r.company_id) ?? []) : null
  if (!hs || !hs.length) return ''
  return `<h3>Largest shareholders <span class="cnt">${hs.length}</span></h3><ul class="hlist hlist-s">${hs.map(h => `<li><span class="p">${h.pct !== null ? h.pct + '%' : ''}</span>
    <span class="hn">${h.holder_in_map && BYID.has(h.holder_id) ? `<button type="button" class="linkbtn" data-goto="${esc(h.holder_id)}">${esc(h.holder_name)}</button>` : esc(h.holder_name)}
    <span class="hm">${esc(HOLDER_TYPE[h.holder_type] ?? h.holder_type)}${h.share_class ? ` · ${h.share_class === 'non_voting' ? 'non-voting' : 'voting'} shares` : ''}${h.holder_country && h.holder_country !== 'Sri Lanka' ? ' · ' + esc(h.holder_country) : ''}${HOLDINGS_OF.get(h.holder_id)?.length > 1 ? ` · <button type="button" class="linkbtn" data-holder="${esc(h.holder_id)}">holds ${HOLDINGS_OF.get(h.holder_id).length} listed companies</button>` : ''}</span></span>
    <span class="hs"></span><span class="hr"></span></li>`).join('')}</ul>`
}
// Holdings: what this company holds directly, and (for a group head) every company in its group.
const KIND = { holding: 'Subsidiary', other_group_holding: 'Stake', member_of_group: 'Group company', member_per_web_sources: 'Group company',
  associate: 'Associate', joint_venture: 'Joint venture', investment_not_consolidated: 'Minority investment', former_holding: 'Formerly held', major_shareholder: 'Stake',
  subsidiary: 'Subsidiary', named_in_report_only: 'Named in the annual report' }
// a “holding” link is the largest stated shareholder; below 50% that is not a subsidiary
const kindLabel = h => h.kind === 'holding' && h.pct !== null && h.pct < 50 ? 'Largest shareholder' : KIND[h.kind] ?? h.kind
const KIND_GROUP = k => k === 'associate' || k === 'joint_venture' ? 'aj' : k === 'former_holding' ? 'former' : k === 'major_shareholder' || k === 'investment_not_consolidated' || k === 'other_group_holding' ? 'stake' : 'sub'
let hold = { id: null, q: '', kind: 'all' }

function badge(t) {
  const fam = FAMILY.get(t)
  return `<span class="theme-tag" data-fam="${esc(fam ?? '')}" title="${esc(COMPANY_SECTOR_FAMILIES[fam] ?? '')}">${esc(tagLabel(t))}</span>`
}

/** Path up the ownership tree: this company, its largest holder, that holder's, … to the group head. */
function chainOf(r) {
  const path = [], seen = new Set([r.company_id])
  let cur = r.company_id
  for (let i = 0; i < 8; i++) {
    const up = (RELS.to.get(cur) ?? []).filter(x => x.type === 'holding' || x.type === 'member_of_group' || x.type === 'member_per_web_sources')
      .sort((a, b) => (b.direct_pct ?? -1) - (a.direct_pct ?? -1))[0]
    if (!up || seen.has(up.from_id)) break
    path.push(up); seen.add(up.from_id); cur = up.from_id
  }
  return path
}

function holdingsOf(r) {
  const direct = (RELS.from.get(r.company_id) ?? []).filter(x => x.type !== 'named_in_report')
  const map = new Map(direct.map(x => [x.to_id, { id: x.to_id, name: x.to_name, pct: x.direct_pct, kind: x.type, direct: true }]))
  if (r.is_group_head) for (const m of ROWS) if (m.group_id === r.company_id && m.company_id !== r.company_id && !map.has(m.company_id))
    map.set(m.company_id, { id: m.company_id, name: m.name, pct: null, kind: m.relation_to_group === 'subsidiary' ? 'holding' : m.relation_to_group, direct: false })
  return [...map.values()].map(h => ({ ...h, row: BYID.get(h.id) }))
    .sort((a, b) => (b.row?.revenue_lkr ?? -1) - (a.row?.revenue_lkr ?? -1) || (b.pct ?? -1) - (a.pct ?? -1) || a.name.localeCompare(b.name))
}

function holdingsList(r) {
  const all = holdingsOf(r)
  const q = hold.id === r.company_id ? hold.q.toLowerCase() : ''
  const kind = hold.id === r.company_id ? hold.kind : 'all'
  const counts = { all: all.length, sub: 0, aj: 0, stake: 0, former: 0 }
  for (const h of all) counts[KIND_GROUP(h.kind)]++
  const shownH = all.filter(h => (kind === 'all' || KIND_GROUP(h.kind) === kind) &&
    (!q || (h.name + ' ' + (h.row?.sector_tags ?? '') + ' ' + (h.row?.country ?? '')).toLowerCase().includes(q)))
  const tabs = [['all', 'All'], ['sub', 'Subsidiaries'], ['aj', 'Associates and joint ventures'], ['stake', 'Other stakes'], ['former', 'Formerly held']]
    .filter(([k]) => k === 'all' || counts[k]).map(([k, l]) => `<button type="button" data-hkind="${k}" aria-pressed="${kind === k}">${l} <span>${counts[k]}</span></button>`).join('')
  const items = shownH.map(h => {
    const m = h.row, abroad = m?.country && m.country !== 'Sri Lanka'
    return `<li><span class="p">${h.pct !== null ? h.pct + '%' : ''}</span>
      <span class="hn">${BYID.has(h.id) ? `<button type="button" class="linkbtn" data-goto="${esc(h.id)}">${esc(h.name)}</button>` : esc(h.name)}
        <span class="hm">${esc(kindLabel(h))}${h.direct ? '' : ' · held through the group'}${abroad ? ' · ' + esc(m.country) : ''}</span></span>
      <span class="hs">${m ? tagsOf(m).slice(0, 1).map(badge).join('') : ''}</span>
      <span class="hr">${m?.revenue_lkr != null ? fmtLkr(m.revenue_lkr) : ''}</span></li>`
  }).join('')
  return `<div class="holds" data-holds="${esc(r.company_id)}">
    <div class="htabs" role="group" aria-label="Kind of holding">${tabs}</div>
    <input type="search" class="hq" placeholder="Search ${all.length} companies" value="${esc(q)}" aria-label="Search holdings">
    <ul class="hlist">${items || '<li class="note">No companies match.</li>'}</ul></div>`
}

/* ---------- ownership web ---------- */
// A walkable diagram: who owns the centre company (left; the chain of parents further left) and what it holds (right).
// Clicking a box re-centres the web on it, so a reader can follow the connections across groups.
const WEB = { w: 184, h: 48, gx: 88, gy: 10, top: 26, maxOwners: 8, maxHeld: 12 }
let web = { root: null, centre: null, all: false }
const SKIP_LINK = new Set(['named_in_report', 'former_holding'])
const isControl = (type, pct) => type === 'member_of_group' || type === 'member_per_web_sources' || ((type === 'holding' || type === 'shareholder') && (pct ?? 0) >= 50)

function ownersOf(id) {
  const m = new Map()
  const links = (RELS.to.get(id) ?? []).filter(x => !SKIP_LINK.has(x.type) && x.from_id !== id)
  // “member of group” is a roll-up to the group head; when a direct parent is known the head sits further up the chain instead
  const direct = links.some(x => x.type === 'holding')
  for (const x of links) {
    if (direct && (x.type === 'member_of_group' || x.type === 'member_per_web_sources')) continue
    m.set(x.from_id, { id: x.from_id, name: x.from_name, pct: x.direct_pct, ctl: isControl(x.type, x.direct_pct) })
  }
  // voting stakes first: a holder with only non-voting shares is shown, but never as control
  for (const h of [...(HOLD?.get(id) ?? [])].sort((a, b) => (a.share_class === 'non_voting') - (b.share_class === 'non_voting'))) {
    if (h.holder_id === id) continue
    const nv = h.share_class === 'non_voting'
    const o = m.get(h.holder_id)
    if (o) { if (o.pct === null && !nv) o.pct = h.pct } else m.set(h.holder_id, { id: h.holder_id, name: h.holder_name, pct: h.pct, ctl: !nv && isControl('shareholder', h.pct), nv, holder: h })
  }
  return [...m.values()].sort((a, b) => b.ctl - a.ctl || (b.pct ?? -1) - (a.pct ?? -1))
}
function heldBy(id) {
  const m = new Map()
  for (const x of RELS.from.get(id) ?? []) {
    if (SKIP_LINK.has(x.type) || x.to_id === id) continue
    // a group roll-up to a company that another company holds directly: shown one step down, not here
    if ((x.type === 'member_of_group' || x.type === 'member_per_web_sources') && (RELS.to.get(x.to_id) ?? []).some(y => y.type === 'holding' && y.from_id !== id)) continue
    m.set(x.to_id, { id: x.to_id, name: x.to_name, pct: x.direct_pct, ctl: isControl(x.type, x.direct_pct) })
  }
  for (const h of HOLDINGS_OF.get(id) ?? []) if (!m.has(h.company_id) && h.company_id !== id)
    m.set(h.company_id, { id: h.company_id, name: h.company_name, pct: h.pct, ctl: isControl('shareholder', h.pct) })
  return [...m.values()].sort((a, b) => b.ctl - a.ctl || (BYID.get(b.id)?.revenue_lkr ?? -1) - (BYID.get(a.id)?.revenue_lkr ?? -1) || (b.pct ?? -1) - (a.pct ?? -1))
}
/** What a box says: name, then a measured line (CSE symbol, revenue, country, how many it holds). */
function webNode(id, name, holder) {
  const r = BYID.get(id), n = heldBy(id).length
  if (r) {
    const meta = [r.cse_symbol?.split('.')[0], r.revenue_lkr !== null ? fmtLkr(r.revenue_lkr) : null, r.country && r.country !== 'Sri Lanka' ? r.country : null, n ? `holds ${n}` : null].filter(Boolean)
    return { id, name: r.name, meta: meta.join(' · ') || OWNER[ownershipOf(r)] || '', fam: r.sector_family ?? '', walk: true }
  }
  const h = holder ?? HOLDINGS_OF.get(id)?.[0]
  const type = h ? HOLDER_TYPE[h.holder_type] ?? '' : ''
  return { id, name: name ?? h?.holder_name ?? id, meta: [type && type[0].toUpperCase() + type.slice(1), h?.holder_country && h.holder_country !== 'Sri Lanka' ? h.holder_country : null, n > 1 ? `holds ${n}` : null].filter(Boolean).join(' · '), fam: '', walk: n > 0 }
}

function webBox(r) {
  if (web.root !== r.company_id) web = { root: r.company_id, centre: r.company_id, all: false }
  const maxO = web.all ? Infinity : WEB.maxOwners, maxH = web.all ? Infinity : WEB.maxHeld
  const cid = web.centre
  const owners = ownersOf(cid), held = heldBy(cid)
  // the chain of parents beyond the first owner, one column each, aligned with that owner
  const chain = BYID.has(cid) ? chainOf(BYID.get(cid)).slice(1, 3) : []
  const placed = new Set([cid, ...owners.slice(0, maxO).map(o => o.id), ...held.slice(0, maxH).map(h => h.id)])
  const up = []
  for (const x of chain) { if (placed.has(x.from_id)) break; placed.add(x.from_id); up.push(x) }

  const cols = [] // left to right: each { label, nodes: [{node, y?}] }
  for (const x of [...up].reverse()) cols.push({ label: '', nodes: [{ ...webNode(x.from_id, x.from_name), chainTo: x.to_id, pct: x.direct_pct, ctl: isControl(x.type, x.direct_pct) }] })
  const oShown = owners.slice(0, maxO)
  if (owners.length) cols.push({ label: 'Owned by', nodes: [...oShown.map(o => ({ ...webNode(o.id, o.name, o.holder), pct: o.pct, ctl: o.ctl, nv: o.nv, edge: 'out' })),
    ...(owners.length > oShown.length ? [{ more: owners.length - oShown.length, kind: 'owners' }] : [])] })
  const ci = cols.length
  cols.push({ label: '', nodes: [{ ...webNode(cid), centre: true }] })
  const hShown = held.slice(0, maxH)
  if (held.length) cols.push({ label: 'Holds', nodes: [...hShown.map(h => ({ ...webNode(h.id, h.name), pct: h.pct, ctl: h.ctl, edge: 'in' })),
    ...(held.length > hShown.length ? [{ more: held.length - hShown.length, kind: 'held' }] : [])] })

  // layout: every column centred on the tallest; chain columns sit level with the parent they lead to
  const rowsMax = Math.max(...cols.map(c => c.nodes.length))
  const H = rowsMax * (WEB.h + WEB.gy) - WEB.gy
  const pos = new Map()
  cols.forEach((c, i) => {
    const x = i * (WEB.w + WEB.gx), y0 = WEB.top + (H - c.nodes.length * (WEB.h + WEB.gy) + WEB.gy) / 2
    c.x = x
    c.nodes.forEach((n, j) => { n.x = x; n.y = y0 + j * (WEB.h + WEB.gy) })
  })
  for (const c of cols) for (const n of c.nodes) if (n.id) pos.set(n.id, n)
  // pull chain boxes level with the box they lead to (right to left so a chain stays straight)
  for (let i = ci - 2; i >= 0; i--) for (const n of cols[i].nodes) { const t = pos.get(n.chainTo); if (t) n.y = t.y }
  const W = cols.length * (WEB.w + WEB.gx) - WEB.gx, Ht = WEB.top + H

  const centre = pos.get(cid)
  const edges = [], labels = []
  const curve = (a, b) => { const x1 = a.x + WEB.w, y1 = a.y + WEB.h / 2, x2 = b.x, y2 = b.y + WEB.h / 2, mx = (x1 + x2) / 2; return `M${x1} ${y1}C${mx} ${y1} ${mx} ${y2} ${x2} ${y2}` }
  const pctTxt = p => p === null || p === undefined ? '' : `<b>${+p.toFixed(p < 1 ? 2 : 1)}%</b>`
  for (const c of cols) for (const n of c.nodes) {
    if (!n.id || n.centre) continue
    if (n.edge === 'out') { edges.push([curve(n, centre), n.ctl]); labels.push(`<span class="wp l" style="left:${n.x + WEB.w + 1}px;top:${n.y + WEB.h / 2 - 7}px"${n.nv ? ' title="Non-voting shares"' : ''}>${pctTxt(n.pct)}${n.nv ? '<b>NV</b>' : ''}</span>`) }
    else if (n.edge === 'in') { edges.push([curve(centre, n), n.ctl]); labels.push(`<span class="wp" style="left:${n.x - 47}px;top:${n.y + WEB.h / 2 - 7}px">${pctTxt(n.pct)}</span>`) }
    else if (n.chainTo && pos.get(n.chainTo)) { const t = pos.get(n.chainTo); edges.push([curve(n, t), n.ctl]); labels.push(`<span class="wp l" style="left:${n.x + WEB.w + 1}px;top:${n.y + WEB.h / 2 - 7}px">${pctTxt(n.pct)}</span>`) }
  }
  const box = n => {
    if (n.more) return `<button type="button" class="wn more" data-webmore="${n.kind}" style="left:${n.x}px;top:${n.y}px"><span class="n">and ${n.more} more</span><span class="m">show them all</span></button>`
    const style = `left:${n.x}px;top:${n.y}px${n.fam ? `;--stripe:var(--sec-${n.fam})` : ''}`
    const inner = `<span class="n">${esc(n.name)}</span><span class="m">${esc(n.meta)}</span>`
    if (n.centre) return `<div class="wn c" style="${style}" title="${esc(n.name)}" tabindex="-1" data-webc>${inner}</div>`
    return n.walk ? `<button type="button" class="wn" data-web="${esc(n.id)}" style="${style}" title="${esc(n.name)}: centre the web here">${inner}</button>`
      : `<div class="wn plain" style="${style}" title="${esc(n.name)}">${inner}</div>`
  }
  const heads = cols.map(c => c.label ? `<span class="webcol" style="left:${c.x}px">${c.label}</span>` : '').join('')
  const cname = pos.get(cid).name
  const moved = cid !== r.company_id
  return `<div class="web" data-webroot="${esc(r.company_id)}">
    <div class="webhd"><h3>Ownership web</h3>
      <p class="note">${moved ? `Centred on <b>${esc(cname)}</b>. <button type="button" class="linkbtn" data-webreset>Back to ${esc(r.name)}</button>${BYID.has(cid) ? ` · <button type="button" class="linkbtn" data-goto="${esc(cid)}">Open ${esc(cname)} in the table</button>` : ''}`
        : 'Click a company to put it at the centre and follow the connections.'}</p></div>
    ${owners.length || held.length ? `<div class="webkey"><span><i></i>Majority stake or group company</span><span><i class="min"></i>Smaller stake, associate or joint venture</span><span>Box edge colour: broad sector</span>${owners.some(o => o.nv) ? '<span>NV: non-voting shares</span>' : ''}</div>
    <div class="webwrap"><div class="webcan" style="width:${W}px;height:${Ht}px">
      <svg width="${W}" height="${Ht}" aria-hidden="true">${edges.map(([d, maj]) => `<path d="${d}"${maj ? ' class="maj"' : ''}/>`).join('')}</svg>
      ${heads}${labels.join('')}${cols.flatMap(c => c.nodes).map(box).join('')}
    </div></div>` : '<p class="note">The sources name no owners or holdings for this company.</p>'}
  </div>`
}
/** Keep the centre box in view when the web is wider than the panel. */
function fitWeb() {
  const wrap = document.querySelector('.web .webwrap'), c = wrap?.querySelector('[data-webc]')
  if (wrap && c && wrap.scrollWidth > wrap.clientWidth) wrap.scrollLeft = c.offsetLeft + WEB.w / 2 - wrap.clientWidth / 2
}
function redrawWeb(focusCentre) {
  const el = document.querySelector('.web[data-webroot]')
  if (!el) return
  el.outerHTML = webBox(BYID.get(el.dataset.webroot))
  fitWeb()
  if (focusCentre) document.querySelector('.web [data-webc]')?.focus({ preventScroll: true })
}

/* ---------- detail: Figures and Ownership tabs ---------- */
let dtab = { id: null, tab: 'figures' }
const stat = (l, v, sub = '') => `<div class="st"><span class="sl">${l}</span><span class="sv">${v}</span>${sub ? `<span class="ss">${sub}</span>` : ''}</div>`
const linkTo = (id, name) => BYID.has(id) ? `<button type="button" class="linkbtn" data-goto="${esc(id)}">${esc(name)}</button>` : esc(name)

function headline(r) {
  return `<div class="stats">
    ${stat(KIND_LABEL[r.revenue_kind] ?? 'Revenue', fmtLkr(r.revenue_lkr), r.revenue_growth_nominal_pct !== null ? `${fmtPct(r.revenue_growth_real_pct)} real · ${fmtPctPlain(r.revenue_growth_nominal_pct)} nominal` : (revenueNote(r) || ''))}
    ${stat('Net profit (after tax)', fmtLkr(r.profit_after_tax_lkr), r.net_profit_margin_pct !== null ? `${r.net_profit_margin_pct.toFixed(1)}% net profit margin` : (r.pretax_margin_pct !== null ? `${r.pretax_margin_pct.toFixed(1)}% pre-tax margin` : ''))}
    ${stat('Return on equity', r.return_on_equity_pct !== null ? r.return_on_equity_pct.toFixed(1) + '%' : '–', r.equity_to_assets_pct !== null ? `equity is ${r.equity_to_assets_pct.toFixed(0)}% of assets` : (r.total_equity_lkr !== null && r.total_equity_lkr < 0 ? 'equity is negative' : ''))}
    ${r.market_cap_lkr !== null ? stat('Market value', fmtLkr(r.market_cap_lkr), r.pe_ratio !== null ? `${r.pe_ratio.toFixed(1)} times earnings` : '') : stat('Employees', fmtInt(r.employees), r.revenue_per_employee_lkr ? fmtLkr(r.revenue_per_employee_lkr) + ' revenue per employee' : '')}
  </div>`
}

function aboutBlock(r) {
  const tags = tagsOf(r)
  const ev = SECT ? (SECT.get(r.company_id) ?? []) : null
  const sectors = tags.length ? `<ul class="secs">${tags.map(t => {
    const e = ev?.find(x => x.sector === t)
    return `<li>${badge(t)}${e ? `<span class="ev">“${esc(e.evidence)}”</span>` : ''}</li>`
  }).join('')}</ul>` : '<p class="note">No sector yet. The sources do not say what this company does.</p>'
  const abroad = [r.countries_of_operation && ['Operates in', esc(r.countries_of_operation)], r.export_markets && ['Export markets', esc(r.export_markets)],
    r.revenue_outside_sri_lanka_lkr !== null && ['Revenue from outside Sri Lanka', fmtLkr(r.revenue_outside_sri_lanka_lkr)], r.foreign_parent && ['Foreign parent or shareholder', esc(r.foreign_parent)],
    r.foreign_subsidiaries > 0 && ['Overseas subsidiaries', String(r.foreign_subsidiaries)]].filter(Boolean)
  return `<div class="cols">
    <div>${r.what_it_does ? `<h3>What it does</h3><p class="what">${esc(r.what_it_does)}</p>` : ''}<h3>Sectors</h3>${sectors}</div>
    <div>${abroad.length ? `<h3>Exports and overseas operations</h3><dl class="kv">${abroad.map(([k, v]) => `<dt>${k}</dt><dd>${v}</dd>`).join('')}</dl>` : ''}
      ${r.financial_notes ? `<h3>Notes on the figures</h3><p class="note">${esc(r.financial_notes)}</p>` : ''}
      <h3>Source</h3><p>${r.source_url ? `<a href="${esc(r.source_url)}" rel="noopener nofollow" target="_blank">${esc(r.source_name || 'Source')}</a>` : '<span class="note">Named as a shareholder in another company’s annual report.</span>'}${r.registration_no ? ` <span class="note">· Reg. no. ${esc(r.registration_no)}</span>` : ''}</p></div>
  </div>`
}

/* charts: small multiples of one measure each, never two scales on one chart */
function miniBars(points, { per = false } = {}) {
  if (points.length < 2) return '<p class="note">Fewer than two years printed.</p>'
  const W = 240, H = 78, gap = 3, n = points.length, bw = (W - gap * (n - 1)) / n
  const max = Math.max(0, ...points.map(p => p.value)), min = Math.min(0, ...points.map(p => p.value))
  const span = max - min || 1, zero = H * max / span
  const bars = points.map((p, i) => {
    const h = Math.max(1, Math.abs(p.value) / span * H), y = p.value >= 0 ? zero - h : zero
    const label = `${p.year}: ${per ? 'LKR ' + p.value.toFixed(2) : fmtLkr(p.value).replace(/<[^>]+>/g, '')}`
    return `<rect x="${(i * (bw + gap)).toFixed(1)}" y="${y.toFixed(1)}" width="${bw.toFixed(1)}" height="${h.toFixed(1)}" rx="1.5" class="${p.value < 0 ? 'neg' : ''}${i === n - 1 ? ' last' : ''}"><title>${esc(label)}</title></rect>`
  }).join('')
  return `<svg class="mini" viewBox="0 0 ${W} ${H + 1}" preserveAspectRatio="none" role="img" aria-label="${esc(points.map(p => `${p.year} ${per ? p.value.toFixed(2) : Math.round(p.value)}`).join(', '))}">
    <line x1="0" x2="${W}" y1="${zero.toFixed(1)}" y2="${zero.toFixed(1)}" class="base"/>${bars}</svg>
    <div class="miniax"><span>${points[0].year}</span><span>${points[n - 1].year}</span></div>`
}

function historyGrid(r, rows, basis) {
  const lender = r.industry_kind === 'bank' || r.industry_kind === 'finance_company'
  const panels = [
    ['revenue', KIND_LABEL[r.revenue_kind] ?? 'Revenue'], ['profit_after_tax', 'Profit after tax'],
    [lender ? 'total_assets' : 'total_equity', lender ? 'Total assets' : 'Total equity'], ['dividend_per_share', 'Dividend per share'],
  ].map(([m, label]) => {
    const pts = FIG.series(rows, m, basis, { real: true })
    if (!pts.length) return ''
    const last = pts[pts.length - 1], per = m === 'dividend_per_share'
    const growth = m === 'revenue' || m === 'total_equity' || m === 'total_assets'
    const g = growth ? FIG.cagr(pts) : null
    const nom = growth ? FIG.cagr(FIG.series(rows, m, basis)) : null
    return `<div class="hpanel"><p class="hl">${esc(label)}</p>
      <p class="hv">${per ? 'LKR ' + last.value.toFixed(2) : fmtLkr(last.value)}<span class="hs">${last.year}${g !== null ? ` · ${fmtPct(g)} a year since ${pts[0].year} after inflation${nom !== null ? ` (${fmtPctPlain(nom)} in rupees)` : ''}` : ''}</span></p>
      ${miniBars(pts, { per })}</div>`
  }).filter(Boolean)
  if (!panels.length) return ''
  return `<h3>Over the years</h3><div class="hgrid">${panels.join('')}</div>
    <p class="note">In rupees of ${esc(String(FIG.series(rows, 'revenue', basis, { real: true }).at(-1)?.year ?? 'the latest year'))}: each year is adjusted for consumer price inflation, so the bars compare like with like (Sri Lanka’s prices rose about 2.4 times between 2016 and 2026). From the annual report’s multi-year summary and its latest statements.</p>`
}

const ORD = n => n + (n % 100 >= 11 && n % 100 <= 13 ? 'th' : ['th', 'st', 'nd', 'rd'][n % 10] ?? 'th')
function strip(st, v) {
  const lo = st.values[Math.floor(st.values.length * 0.05)], hi = st.values[Math.ceil(st.values.length * 0.95) - 1]
  const x = val => 4 + Math.max(0, Math.min(1, (val - lo) / ((hi - lo) || 1))) * 112
  return `<svg class="strip" viewBox="0 0 120 14" aria-hidden="true"><line x1="4" x2="116" y1="7" y2="7"/>
    ${st.values.map(val => `<circle cx="${x(val).toFixed(1)}" cy="7" r="1.8" class="peer"/>`).join('')}
    <line x1="${x(st.median).toFixed(1)}" x2="${x(st.median).toFixed(1)}" y1="2" y2="12" class="med"/>
    <circle cx="${x(v).toFixed(1)}" cy="7" r="4" class="me"/></svg>`
}

function ratioTable(r) {
  const lender = r.industry_kind === 'bank' || r.industry_kind === 'finance_company', insurer = r.industry_kind === 'insurer'
  const P = (v, d = 1) => v === null || v === undefined ? '–' : `${v.toFixed(d)}%`, X = v => v === null || v === undefined ? '–' : `${v.toFixed(1)}×`
  const all = lender ? [
    ['revenue_growth_real_pct', 'Growth in gross income, after inflation', P, 'higher'], ['return_on_equity_pct', 'Return on equity', P, 'higher'],
    ['npl_ratio_pct', 'Stage 3 (bad) loans', P, 'lower'], ['total_capital_ratio_pct', 'Total capital ratio', P, 'higher'],
    ['cost_to_income_pct', 'Cost to income', P, 'lower'], ['net_interest_margin_pct', 'Net interest margin', P, 'higher'],
    ['loans_to_deposits_pct', 'Loans to deposits', P, null], ['loan_growth_pct', 'Loan growth (nominal)', P, 'higher'],
    ['dividend_yield_pct', 'Dividend yield', P, 'higher'], ['pb_ratio', 'Price to book', v => v === null ? '–' : `${v.toFixed(2)}×`, null],
  ] : [
    ['revenue_growth_real_pct', `Growth in ${insurer ? 'premium' : 'revenue'}, after inflation`, P, 'higher'],
    ['revenue_cagr_5y_real_pct', 'Growth a year over five years, after inflation', P, 'higher'],
    ...(insurer ? [] : [['gross_margin_pct', 'Gross margin', P, 'higher'], ['operating_margin_pct', 'Operating margin', P, 'higher'], ['net_profit_margin_pct', 'Net profit margin', P, 'higher']]),
    ['return_on_equity_pct', 'Return on equity', P, 'higher'],
    ...(insurer ? [['insurance_capital_adequacy_pct', 'Capital adequacy ratio', v => v === null ? '–' : `${v.toFixed(0)}%`, 'higher']] :
      [['debt_to_equity_pct', 'Debt to equity', P, 'lower'], ['interest_cover', 'Interest cover', X, 'higher'], ['cash_conversion_pct', 'Cash from operations ÷ profit', v => v === null ? '–' : `${v.toFixed(0)}%`, 'higher']]),
    ['dividend_yield_pct', 'Dividend yield', P, 'higher'], ['pe_ratio', 'Price to earnings', X, null],
  ]
  const peers = FIG.peersOf(ROWS, r)
  const fam = COMPANY_SECTOR_FAMILIES[r.sector_family] ?? 'its sector'
  const rows = all.map(([field, label, fmt, better]) => {
    const v = r[field]
    if (v === null || v === undefined) return ''
    const st = FIG.peerStats(peers, r, field, better ?? 'higher')
    return `<tr><th>${esc(label)}</th><td class="v">${fmt(v)}</td>
      <td class="m">${st ? fmt(st.median) : ''}</td>
      <td class="k">${st ? (better ? `${ORD(st.rank)} of ${st.n}` : `${st.n} companies`) : ''}</td>
      <td class="s">${st ? strip(st, v) : ''}</td></tr>`
  }).join('')
  if (!rows) return ''
  return `<h3>Against other listed companies in ${esc(lender ? 'banking and finance' : fam.toLowerCase())}</h3>
    <table class="ratios"><thead><tr><th></th><th>This company</th><th class="m">Median</th><th class="k">Rank</th><th class="s"><span class="sr">Spread</span></th></tr></thead><tbody>${rows}</tbody></table>
    <p class="note">Rank 1 is the best on that measure. Dots are the other listed companies; the line is the median.${r.market_cap_lkr !== null ? ' Prices are from the Colombo Stock Exchange in November 2026.' : ''}</p>`
}

function moneyBlock(r) {
  const lender = r.industry_kind === 'bank' || r.industry_kind === 'finance_company'
  const L = v => v === null || v === undefined ? null : fmtLkr(v)
  const kv = items => { const xs = items.filter(([, v]) => v !== null && v !== undefined && v !== '–'); return xs.length ? `<dl class="kv">${xs.map(([k, v]) => `<dt>${k}</dt><dd>${v}</dd>`).join('')}</dl>` : '' }
  const value = kv([['Market value', L(r.market_cap_lkr)], ['Share price', r.share_price_lkr !== null ? `LKR ${r.share_price_lkr.toFixed(2)}` : null],
    ['Earnings per share', r.eps_lkr !== null ? `LKR ${r.eps_lkr.toFixed(2)}` : null], ['Dividend per share', r.dividend_per_share_lkr !== null ? `LKR ${r.dividend_per_share_lkr.toFixed(2)}` : null],
    ['Dividend payout', r.dividend_payout_pct !== null ? `${r.dividend_payout_pct.toFixed(0)}% of earnings` : null], ['Net assets per share', r.net_assets_per_share_lkr !== null ? `LKR ${r.net_assets_per_share_lkr.toFixed(2)}` : null],
    ['Price to book', r.pb_ratio !== null ? `${r.pb_ratio.toFixed(2)}×` : null]])
  const cash = lender ? kv([['Loans and advances', L(r.loans_lkr)], ['Customer deposits', L(r.deposits_lkr)], ['Deposit growth (nominal)', r.deposit_growth_pct !== null ? fmtPctPlain(r.deposit_growth_pct) : null],
      ['Tier 1 capital ratio', r.tier_1_capital_ratio_pct !== null ? `${r.tier_1_capital_ratio_pct.toFixed(1)}%` : null], ['Cash from operations', L(r.operating_cash_flow_lkr)], ['Effective tax rate', r.effective_tax_rate_pct !== null ? `${r.effective_tax_rate_pct.toFixed(0)}%` : null]])
    : kv([['Borrowings and leases', L(r.borrowings_lkr)], ['Cash', L(r.cash_lkr)], ['Net debt', r.net_debt_lkr !== null ? (r.net_debt_lkr < 0 ? `${fmtLkr(-r.net_debt_lkr)} net cash` : fmtLkr(r.net_debt_lkr)) : null],
      ['Current ratio', r.current_ratio !== null ? `${r.current_ratio.toFixed(2)}` : null], ['Cash from operations', L(r.operating_cash_flow_lkr)], ['Capital spending', L(r.capex_lkr)],
      ['Free cash flow', L(r.free_cash_flow_lkr)], ['EBITDA', L(r.ebitda_lkr)], ['Staff costs', r.staff_costs_lkr !== null ? `${fmtLkr(r.staff_costs_lkr)}${r.staff_cost_share_pct !== null ? ` · ${r.staff_cost_share_pct.toFixed(0)}% of revenue` : ''}` : null],
      ['Effective tax rate', r.effective_tax_rate_pct !== null ? `${r.effective_tax_rate_pct.toFixed(0)}%` : null]])
  if (!value && !cash) return ''
  return `<div class="cols">${value ? `<div><h3>Value and dividends</h3>${value}</div>` : '<div></div>'}${cash ? `<div><h3>${lender ? 'Lending and capital' : 'Borrowing and cash'}</h3>${cash}</div>` : ''}</div>`
}

function shareBars(items, total, fmtV) {
  return `<ul class="shares">${items.map(x => {
    const share = total > 0 ? Math.max(0, x.value / total * 100) : 0
    return `<li><span class="sn">${esc(x.name)}</span><span class="sb"><i style="width:${share.toFixed(1)}%"></i></span><span class="sp">${share.toFixed(0)}%</span><span class="sx">${fmtV(x)}</span></li>`
  }).join('')}</ul>`
}

function mixBlock(r, rows, basis) {
  const segs = (SEGS?.get(r.company_id) ?? []).filter(s => s.revenue_lkr > 0)
  const segTotal = segs.reduce((a, s) => a + s.revenue_lkr, 0), profitTotal = segs.reduce((a, s) => a + Math.max(0, s.profit_lkr ?? 0), 0)
  const seg = segs.length >= 2 ? `<div><h3>Where the money comes from</h3>${shareBars(segs.sort((a, b) => b.revenue_lkr - a.revenue_lkr).map(s => ({ name: s.segment, value: s.revenue_lkr, s })), segTotal,
    x => `${fmtLkr(x.value)}${x.s.profit_lkr !== null && x.s.profit_lkr !== undefined ? ` · profit ${fmtLkr(x.s.profit_lkr)}${profitTotal > 0 && x.s.profit_lkr > 0 ? ` (${(x.s.profit_lkr / profitTotal * 100).toFixed(0)}% of profit)` : ''}` : ''}`)}
    <p class="note">Share of revenue by operating segment, from the segment note.</p></div>` : ''
  const reg = rows ? FIG.regions(rows, basis) : []
  const regTotal = reg.reduce((a, x) => a + x.value, 0)
  const where = reg.length >= 2 ? `<div><h3>Where it sells</h3>${shareBars(reg.map(x => ({ name: x.region, value: x.value })), regTotal, x => fmtLkr(x.value))}
    <p class="note">Revenue by region, from the geographical information in the report.</p></div>` : ''
  return seg || where ? `<div class="cols">${seg || '<div></div>'}${where}</div>` : ''
}

const LINES = [
  ['Income statement', ['revenue', 'cost_of_sales', 'gross_profit', 'interest_income', 'interest_expense', 'net_interest_income', 'net_fee_and_commission_income', 'gross_written_premium', 'net_earned_premium', 'net_benefits_and_claims', 'impairment_charges', 'other_operating_income', 'distribution_and_selling_expenses', 'administrative_expenses', 'staff_costs', 'depreciation_and_amortisation', 'operating_profit', 'finance_income', 'finance_costs', 'share_of_associates_and_jvs', 'profit_before_tax', 'income_tax_expense', 'profit_after_tax', 'profit_attributable_to_owners', 'profit_attributable_to_non_controlling_interests']],
  ['Balance sheet', ['total_assets', 'non_current_assets', 'property_plant_and_equipment', 'investment_property', 'intangible_assets', 'current_assets', 'inventories', 'trade_and_other_receivables', 'loans_and_advances', 'cash_and_cash_equivalents', 'short_term_investments', 'total_liabilities', 'current_liabilities', 'trade_and_other_payables', 'customer_deposits', 'borrowings_current', 'borrowings_non_current', 'lease_liabilities', 'total_equity', 'equity_attributable_to_owners', 'non_controlling_interests', 'stated_capital', 'retained_earnings']],
  ['Cash flow', ['cash_from_operating_activities', 'cash_from_investing_activities', 'cash_from_financing_activities', 'purchase_of_ppe_and_intangibles', 'dividends_paid', 'interest_paid', 'tax_paid']],
  ['Per share and people', ['basic_eps', 'dividend_per_share', 'net_assets_per_share', 'market_price_year_end', 'shares_in_issue', 'employees']],
  ['Ratios as reported', ['stage_3_or_npl_ratio_pct', 'tier_1_capital_ratio_pct', 'total_capital_ratio_pct', 'cost_to_income_ratio_pct', 'net_interest_margin_pct', 'capital_adequacy_margin_pct']],
]
function accounts(rows, basis) {
  const pairs = FIG.statementPairs(rows, basis)
  const unit = new Map(rows.map(x => [x.metric, x.unit]))
  const fmt = (m, v) => v === null ? '<span class="dash">–</span>' : unit.get(m) === 'LKR per share' ? `LKR ${v.toFixed(2)}` : unit.get(m) === '%' ? `${v}%` : unit.get(m) === 'people' || unit.get(m) === 'shares' ? fmtInt(v) : fmtLkr(v)
  let n = 0, cur = null, prev = null
  const body = LINES.map(([sec, ms]) => {
    const trs = ms.filter(m => pairs.has(m)).map(m => {
      const p = pairs.get(m); n++; cur ??= p.currentEnd; prev ??= p.priorEnd
      const ch = p.current !== null && p.prior !== null && p.prior > 0 && p.current >= 0 && unit.get(m) !== '%' ? fmtPct((p.current - p.prior) / p.prior * 100) : ''
      return `<tr><th>${esc(FIG.METRIC_LABEL[m] ?? m)}</th><td>${fmt(m, p.current)}</td><td>${fmt(m, p.prior)}</td><td>${ch}</td><td>${p.source ? `<a href="${esc(p.source)}" target="_blank" rel="noopener nofollow" title="The page in the annual report">p.</a>` : ''}</td></tr>`
    }).join('')
    return trs ? `<tr class="sec"><th colspan="5">${sec}</th></tr>${trs}` : ''
  }).join('')
  if (!n) return ''
  return `<details class="accts"><summary><h3>The accounts <span class="cnt">${n} lines</span></h3></summary>
    <table class="fin"><thead><tr><th>${basis === 'group' ? 'Group (consolidated)' : 'Company'}</th><th>${cur ? 'Year to ' + esc(fmtDate(cur)) : 'Latest year'}</th><th>${prev ? 'Year to ' + esc(fmtDate(prev)) : 'Year before'}</th><th>Change</th><th></th></tr></thead><tbody>${body}</tbody></table>
    <p class="note">Every figure is printed on the page it links to, or is the sum of lines printed there. Expenses and outflows are negative. Changes are nominal.</p></details>`
}

function figuresPane(r) {
  const f = FINS.get(r.company_id)
  if (!r.listed) return `${headline(r)}<p class="note">${r.revenue_lkr !== null ? `Revenue: ${esc(basisText(r.revenue_basis))}. ` : ''}This company is not listed and does not publish financial statements, so the sources give no more figures.</p>${aboutBlock(r)}`
  if (!f || f.status === 'loading') return `${headline(r)}<p class="note loading">Loading the accounts…</p>${aboutBlock(r)}`
  const rows = f.status === 'ok' ? f.rows : null
  const basis = rows ? FIG.basisOf(rows) : null
  return `${headline(r)}
    ${rows && basis ? historyGrid(r, rows, basis) : ''}
    ${ratioTable(r)}
    ${moneyBlock(r)}
    ${mixBlock(r, rows, basis)}
    ${rows && basis ? accounts(rows, basis) : f.status === 'error' ? '<p class="note">The accounts could not be loaded. The figures above come from the company table.</p>' : ''}
    ${aboutBlock(r)}`
}

function ownershipPane(r) {
  const holdsCount = holdingsOf(r).length
  const where = r.is_group_head ? (r.group_companies > 1 ? `Parent company of a group of ${r.group_companies} companies.` : 'Not part of any group in this map.') : `${relPhrase(r, linkTo(r.group_id, r.group_name))}.`
  return `<p class="own">${where}
      ${r.controller_name && r.controller_type !== 'group' ? ` Largest shareholder: <b>${esc(r.controller_name)}</b>${r.controller_pct !== null ? ` (${r.controller_pct}%)` : ''} <span class="note">· ${esc(HOLDER_TYPE[r.controller_type] ?? r.controller_type)}${r.controller_country && r.controller_country !== 'Sri Lanka' ? ', ' + esc(r.controller_country) : ''}</span>.` : ''}
      ${r.state_holding_pct ? ` <span class="note">The state and state enterprises hold ${r.state_holding_pct}% among the largest shareholders.</span>` : ''}</p>
    ${webBox(r)}
    <div class="cols"><div>${holderList(r) || '<p class="note">The sources list no shareholders for this company.</p>'}
      ${(r.is_group_head ? r.group_companies : 2) > 1 ? `<p><button type="button" class="linkbtn" data-group="${esc(r.group_id)}">Show every company in the ${esc(r.is_group_head ? r.name : r.group_name)} group in the table</button></p>` : ''}</div>
    <div>${holdsCount ? `<h3>${r.is_group_head ? 'Companies in the group' : 'Companies it owns shares in'} <span class="cnt">${holdsCount}</span></h3>${holdingsList(r)}` : ''}</div></div>`
}

function detail(r) {
  const tab = dtab.id === r.company_id ? dtab.tab : 'figures'
  return `<div class="detail">
    <div class="dtabs" role="tablist" aria-label="${esc(r.name)}">
      <button type="button" role="tab" data-dtab="figures" aria-selected="${tab === 'figures'}">Figures</button>
      <button type="button" role="tab" data-dtab="ownership" aria-selected="${tab === 'ownership'}">Ownership</button>
    </div>
    <div role="tabpanel">${tab === 'figures' ? figuresPane(r) : ownershipPane(r)}</div></div>`
}

function redrawHoldings(id) {
  const box = document.querySelector(`.holds[data-holds="${CSS.escape(id)}"]`)
  if (!box) return
  const pos = box.querySelector('.hq').selectionStart
  box.outerHTML = holdingsList(BYID.get(id))
  const q = document.querySelector(`.holds[data-holds="${CSS.escape(id)}"] .hq`)
  if (document.activeElement === document.body || pos !== null) { q.focus(); q.setSelectionRange(pos, pos) }
}
$('rows').addEventListener('input', e => {
  if (!e.target.matches('.hq')) return
  const id = e.target.closest('.holds').dataset.holds
  hold = { id, q: e.target.value, kind: hold.id === id ? hold.kind : 'all' }
  redrawHoldings(id)
})

$('rows').addEventListener('click', e => {
  const wb = e.target.closest('[data-web]')
  if (wb) { web = { ...web, centre: wb.dataset.web, all: false }; redrawWeb(true); return }
  if (e.target.closest('[data-webreset]')) { web = { ...web, centre: web.root, all: false }; redrawWeb(true); return }
  if (e.target.closest('[data-webmore]')) { web = { ...web, all: true }; redrawWeb(false); return }
  const dt = e.target.closest('[data-dtab]')
  if (dt) { dtab = { id: openId, tab: dt.dataset.dtab }; drawRows(current); document.querySelector(`.dtabs [data-dtab="${dt.dataset.dtab}"]`)?.focus(); return }
  const hk = e.target.closest('[data-hkind]')
  if (hk) { const id = hk.closest('.holds').dataset.holds; hold = { id, q: hold.id === id ? hold.q : '', kind: hk.dataset.hkind }; const box = hk.closest('.holds'); box.outerHTML = holdingsList(BYID.get(id)); return }
  if (e.target.closest('.holds .hq, .detail')) { if (!e.target.closest('button, a')) return }
  const g = e.target.closest('[data-group]')
  if (g) { F = { ...F, group: g.dataset.group, scope: 'all' }; openId = null; shown = 50; update(); root.scrollIntoView({ behavior: 'smooth' }); return }
  const hb = e.target.closest('[data-holder]')
  if (hb) { const list = HOLDINGS_OF.get(hb.dataset.holder) ?? []; const box = hb.closest('li'); if (box.querySelector('.also')) { box.querySelector('.also').remove(); return }
    box.insertAdjacentHTML('beforeend', `<div class="also">${list.sort((a, b) => (b.pct ?? 0) - (a.pct ?? 0)).map(x => `<span><button type="button" class="linkbtn" data-goto="${esc(x.company_id)}">${esc(x.company_name)}</button> ${x.pct !== null ? x.pct + '%' : ''}</span>`).join('')}</div>`); return }
  const go = e.target.closest('[data-goto]')
  if (go) { const r = BYID.get(go.dataset.goto); F = { ...EMPTY_FILTER, families: [], sectors: [], ownership: [], isic: [], abroad: [], performance: [], group: r.group_id, scope: 'all' }; openId = r.company_id; shown = 2000; $('fq').value = ''; update(); document.querySelector(`tr.r[data-id="${CSS.escape(r.company_id)}"]`)?.scrollIntoView({ block: 'center' }); return }
  if (e.target.closest('a')) return
  const tr = e.target.closest('tr.r'); if (!tr) return
  toggle(tr.dataset.id)
})
$('rows').addEventListener('keydown', e => { if ((e.key === 'Enter' || e.key === ' ') && e.target.matches('tr.r')) { e.preventDefault(); toggle(e.target.dataset.id) } })
function toggle(id) {
  openId = openId === id ? null : id
  hold = { id: null, q: '', kind: 'all' }
  drawRows(current)
  document.querySelector(`tr.r[data-id="${CSS.escape(id)}"]`)?.focus()
  if (openId && !SECT) loadSectors()
  if (openId && !HOLD) loadHolders()
  if (openId && !SEGS) loadSegments()
  if (openId && BYID.get(openId)?.listed && !FINS.has(openId)) loadFin(openId)
}

/* ---------- AI hand-off ---------- */
$('copy').addEventListener('click', async () => {
  const q = toQuery(F)
  const words = $('lead').textContent + (current.length ? '' : ' (none match)')
  const call = { op: 'select', dataset_id: q.dataset_id, fields: q.dataset_id === 'lk-companies'
    ? ['name', 'group_name', 'primary_sector', 'revenue_lkr', 'revenue_kind', 'revenue_growth_real_pct', 'revenue_growth_nominal_pct', 'net_profit_margin_pct', 'performance', 'employees', 'source_url']
    : ['name', 'group_name', 'sector', 'revenue_lkr', 'revenue_growth_real_pct', 'revenue_growth_nominal_pct', 'net_profit_margin_pct', 'performance', 'employees', 'source_url'], where: q.where, order_by: q.order_by, limit: 200 }
  const text = `Using the developing-country.org data (MCP query_data), list Sri Lankan companies matching: ${[...$('chips').querySelectorAll('.chip')].map(c => c.firstChild.textContent).join('; ') || 'all groups and companies outside any group'}. ${words}.\n` +
    (q.unsupported.length ? `The query cannot apply these, so check them yourself: ${q.unsupported.join('; ')}.\n` : '') +
    `query_data ${JSON.stringify(call)}\nCite the source_url of each company.`
  const ta = $('copyta'); ta.value = text
  try { await navigator.clipboard.writeText(text); $('copy').textContent = 'Copied' ; setTimeout(() => { $('copy').textContent = 'Copy as a question' }, 1600) }
  catch { ta.hidden = false; ta.select() }
})

addEventListener('popstate', () => { F = parseFilter(new URLSearchParams(location.search)); $('fq').value = F.q; shown = 50; update(true) })

/* ---------- data ---------- */
let HOLD = null, HOLDINGS_OF = new Map()
async function loadHolders() {
  try {
    const t = await (await fetch(`${BASE}/lk-company-shareholders.json`)).json()
    HOLD = new Map()
    for (const r of t.rows) {
      if (!HOLD.has(r.company_id)) HOLD.set(r.company_id, []); HOLD.get(r.company_id).push(r)
      // one entry per company: a holder with voting and non-voting rows still holds one company
      if (!HOLDINGS_OF.has(r.holder_id)) HOLDINGS_OF.set(r.holder_id, [])
      const list = HOLDINGS_OF.get(r.holder_id), same = list.findIndex(x => x.company_id === r.company_id)
      if (same < 0) list.push(r); else if (list[same].share_class === 'non_voting' && r.share_class !== 'non_voting') list[same] = r
    }
    drawRows(current)
  } catch { HOLD = new Map() }
}
// The accounts come from the platform's query API, one company at a time: the full table is too large to download.
const EXPLORE = BASE.replace(/\/data\/?$/, '')
const FINS = new Map()
const FIN_FIELDS = ['company_id', 'basis', 'year_end', 'fiscal_year', 'metric', 'region', 'value', 'unit', 'page', 'source_url']
async function finQuery(dataset, where) {
  const fields = dataset === 'lk-company-history' ? [...FIN_FIELDS.filter(f => f !== 'region'), 'value_real', 'price_index'] : FIN_FIELDS
  const res = await fetch(`${EXPLORE}/api/query`, { method: 'POST', headers: { 'content-type': 'application/json' },
    body: JSON.stringify({ op: 'select', dataset_id: dataset, fields, where, limit: 200 }) })
  if (!res.ok) throw new Error(String(res.status))
  return (await res.json()).rows ?? []
}
async function loadFin(id) {
  FINS.set(id, { status: 'loading' })
  try {
    const own = { field: 'company_id', op: 'eq', value: id }
    const [g, hist] = await Promise.all([finQuery('lk-company-financials', [own, { field: 'basis', op: 'eq', value: 'group' }]), finQuery('lk-company-history', [own])])
    const st = g.length ? g : await finQuery('lk-company-financials', [own, { field: 'basis', op: 'eq', value: 'company' }])
    const tag = (rows, source) => rows.map(x => ({ ...x, source, region: x.region ?? null }))
    FINS.set(id, { status: 'ok', rows: [...tag(st, 'statements'), ...tag(hist, 'multi_year_summary')] })
  } catch { FINS.set(id, { status: 'error' }) }
  if (openId === id) drawRows(current)
}
let SEGS = null
async function loadSegments() {
  try {
    const t = await (await fetch(`${BASE}/lk-company-segments.json`)).json()
    SEGS = new Map()
    for (const r of t.rows) { if (!SEGS.has(r.company_id)) SEGS.set(r.company_id, []); SEGS.get(r.company_id).push(r) }
    if (openId) drawRows(current)
  } catch { SEGS = new Map() }
}
async function loadSectors() {
  try {
    const t = await (await fetch(`${BASE}/lk-company-sectors.json`)).json()
    SECT = new Map()
    for (const r of t.rows) { if (!SECT.has(r.company_id)) SECT.set(r.company_id, []); SECT.get(r.company_id).push(r) }
    drawRows(current)
  } catch { SECT = new Map() }
}

async function start() {
  try {
    const [c, rel] = await Promise.all([`${BASE}/lk-companies.json`, `${BASE}/lk-company-relationships.json`].map(u => fetch(u).then(r => { if (!r.ok) throw new Error(u); return r.json() })))
    ROWS = c.rows
    for (const r of ROWS) if (r.isic_section && r.isic_section_label) ISIC_LABEL.set(r.isic_section, r.isic_section_label)
    BYID = new Map(ROWS.map(r => [r.company_id, r]))
    for (const r of ROWS) TEXT.set(r.company_id, searchText(r))
    for (const x of rel.rows) {
      if (!RELS.from.has(x.from_id)) RELS.from.set(x.from_id, []); RELS.from.get(x.from_id).push(x)
      if (!RELS.to.has(x.to_id)) RELS.to.set(x.to_id, []); RELS.to.get(x.to_id).push(x)
    }
    for (const xs of RELS.from.values()) xs.sort((a, b) => (b.direct_pct ?? -1) - (a.direct_pct ?? -1))
    $('fq').value = F.q
    update(true)
  } catch (e) {
    $('rows').innerHTML = '<tr><td colspan="7" class="empty">The company map could not be loaded. Please try again.</td></tr>'
  }
}
start()
</script>
