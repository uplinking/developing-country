---
import SiteLayout from '../../layouts/SiteLayout.astro'
import LoadingSign from '../../components/LoadingSign.astro'
import { CANONICAL_EXPLORER_ORIGIN } from '../../lib/explorer'

// The tables are the queryable lk-company* datasets on the explorer (built by
// scripts/companies/build.ts). Fetched in the browser so the page stays light.
// PUBLIC_EXPLORER_DEV_ORIGIN points a local preview at an explorer dev server on another port.
const explorer = import.meta.env.DEV ? (import.meta.env.PUBLIC_EXPLORER_DEV_ORIGIN || 'http://127.0.0.1:5173') : CANONICAL_EXPLORER_ORIGIN
const base = `${explorer}/data`
---

<SiteLayout
  title="Enterprises"
  description="Sri Lanka's companies and the groups that own them: what each does, its sector, revenue and growth, employees, and whether it exports or operates overseas."
>
<div class="cmap wrap" id="cmap" data-base={base}>
  <header>
    <h1>Enterprises</h1>
    <p class="lead" id="lead">Sri Lanka’s companies and the groups that own them.</p>
    <p class="howline"><button type="button" class="linkbtn" data-method>How this was made</button> <span class="note">· sources, checks and assumptions</span></p>
    <form class="find" id="find" role="search" action="/dashboard/enterprise" method="get">
      <label class="sr" for="fq">Search companies</label>
      <svg class="find-ico" viewBox="0 0 16 16" aria-hidden="true"><circle cx="6.5" cy="6.5" r="5" fill="none" stroke="currentColor" stroke-width="1.6"/><line x1="10.3" y1="10.3" x2="15" y2="15" stroke="currentColor" stroke-width="1.6"/></svg>
      <input id="fq" name="q" type="search" placeholder="Search companies, groups, products" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="search" maxlength="200">
      <button type="button" class="find-x" id="fqx" aria-label="Clear search" hidden>×</button>
    </form>
    <div class="lensbar"><p class="lbl">Ready-made views</p><div class="lenses" id="lenses" role="group" aria-label="Ready-made views"></div></div>
  </header>

  <div class="bar" role="toolbar" aria-label="Filters">
    <div class="seg" role="group" aria-label="Show">
      <button type="button" data-scope="groups" aria-pressed="true">By group</button>
      <button type="button" data-scope="all" aria-pressed="false">Every company</button>
    </div>
    <div class="filters" id="filters"></div>
  </div>
  <div class="chips" id="chips" aria-live="polite"></div>
  <p class="cov" id="coverage" hidden></p>

  <LoadingSign id="pageload" label="Loading the enterprises" />
  <section aria-label="Summary">
    <div class="kpis" id="kpis"></div>
  </section>
  <section aria-label="How the figures are spread" class="dists" id="dists"></section>

  <section aria-label="Breakdown" class="breaks">
    <div><div class="lblrow"><p class="lbl">By sector</p><div class="seg mini" id="sectorBy" role="group" aria-label="Measure"><button type="button" data-by="count" aria-pressed="true">Companies</button><button type="button" data-by="revenue" aria-pressed="false">Revenue</button></div></div><ol class="bars" id="bySector"></ol></div>
    <div><p class="lbl" id="ownLabel">By ownership</p><ol class="bars" id="byOwner"></ol></div>
  </section>

  <section aria-label="Companies">
    <!-- outside .tablewrap: a scrolling box clips focus rings at its edges -->
    <div class="tabletools"><label class="lbl" for="colset">Columns</label>
      <select id="colset"><option value="overview">Overview</option><option value="debt">Debt</option><option value="price">Dividends and price</option><option value="longrun">Long run</option><option value="banks">Banks and lenders</option><option value="ownership">Ownership</option></select></div>
    <div class="tablewrap">
      <table class="list" id="list">
        <thead id="thead"></thead>
        <tbody id="rows"></tbody>
      </table>
    </div>
    <button type="button" class="showmore" id="more" hidden>Show more</button>
    <div class="ai">
      <p>Want a different view? Ask an AI assistant. It can query the same tables through the developing-country.org connector.</p>
      <button type="button" class="copy" id="copy">Copy as a question</button>
    </div>
    <textarea class="copyta" id="copyta" readonly hidden aria-label="Question to paste into your AI"></textarea>
    <p class="foot">Sources: the latest annual reports (financial years ending December 2025 or March 2026) of all 262 companies listed on the Colombo Stock Exchange, and web research on about 850 large unlisted companies. Figures from the reports were extracted by software and each one checked against the page it cites. Revenue is in Sri Lankan rupees (LKR); US dollar figures are converted at LKR 300 to the dollar. For banks and finance companies revenue means gross income; for insurers, gross written premium. A parent company’s revenue already includes its subsidiaries. Data, free to reuse under CC BY 4.0: <a href="/data/lk-companies">Sri Lankan companies and groups</a>, <a href="/data/lk-company-sectors">Company sectors</a>, <a href="/data/lk-company-relationships">Company ownership</a>, <a href="/data/lk-company-segments">Company operating segments</a>.</p>
    <p class="foot"><button type="button" class="linkbtn" data-method>How this was made: sources, checks, definitions and limits</button></p>
  </section>

  <dialog class="drawer" id="drawer" aria-labelledby="drawer-title">
    <div class="mhead"><h2 id="drawer-title">Filters</h2><button type="button" class="mclose" data-dclose aria-label="Close">Close</button></div>
    <div class="dbody" id="dbody"></div>
    <div class="dfoot"><button type="button" class="clear" id="dclear">Clear these filters</button><button type="button" class="dshow" id="dshow" data-dclose>Show companies</button></div>
  </dialog>

  <dialog class="method ddlg" id="spread" aria-labelledby="spread-title">
    <div class="mhead"><h2 id="spread-title">How the figures are spread</h2><button type="button" class="mclose" data-close aria-label="Close">Close</button></div>
    <div class="dtabs" role="tablist" aria-label="Figure"></div>
    <div class="mbody" role="tabpanel" id="spread-panel"></div>
  </dialog>
  <dialog class="method" id="method" aria-labelledby="method-title">
    <div class="mhead">
      <h2 id="method-title">How this was made</h2>
      <button type="button" class="mclose" data-close aria-label="Close">Close</button>
    </div>
    <div class="mbody">
      <p class="mlead">Every figure on this page comes from a company’s own annual report or from a web source linked on its row. This is how we read those sources, how we checked them, and the choices we made along the way.</p>

      <h3>Where the data comes from</h3>
      <ul>
        <li><b>Listed companies.</b> All 262 companies with ordinary shares on the Colombo Stock Exchange (CSE). For each we downloaded the latest annual report from the CSE: financial years ending December 2025 or March 2026. The list of companies, share prices and market values come from the CSE in November 2026.</li>
        <li><b>Companies inside groups.</b> The subsidiaries, associates and joint ventures that each annual report names, with the stake it states.</li>
        <li><b>Large unlisted companies.</b> About 850 more, found by web research: state enterprises, banks, exporters, family groups and multinationals. Each row links the web source it came from. These facts were not checked against a filing.</li>
        <li><b>Prices.</b> The Colombo Consumer Price Index (Department of Census and Statistics), the inflation reported in the World Bank’s Sri Lanka Development Updates, and the World Bank consumer price index for years before 2018.</li>
      </ul>

      <h3>How the figures were read</h3>
      <ul>
        <li>Each report was turned into text page by page, keeping the page number.</li>
        <li>A large language model (OpenAI’s GPT through Codex; Anthropic’s Claude for some earlier passes) read each report and copied figures into a fixed form: the income statement, balance sheet and cash flow for the latest and prior year, per-share figures, bank and insurer ratios, the five or ten-year summary, operating segments, revenue by region, the largest shareholders and the companies it holds.</li>
        <li>The instruction was to copy figures exactly as printed and never to calculate or guess one. A line the report does not print is left empty, not set to zero.</li>
      </ul>

      <h3>How the figures were checked</h3>
      <ul>
        <li><b>Against the page.</b> Every figure cites the page it was read from. It is published only if that number is printed on the page (or the page either side), or is the sum of lines printed there. Of 52,593 figures read from the 262 reports, 98.5% pass; the other 1.5% are left out. Each figure in the accounts table links to its page.</li>
        <li><b>Against the accounts.</b> We test each company’s figures against accounting identities: assets equal liabilities plus equity, gross profit equals revenue less cost of sales, profit after tax equals profit before tax less tax, earnings per share times shares in issue equals profit to shareholders, and the summary’s latest year equals the statements.</li>
        <li><b>By a second model.</b> A different model (GPT-6.2 Astra) audited each listed company: the extracted accounts, the headline figures, the segments, the shareholders and the holdings, against the report, and explained or corrected every failed identity. A correction is applied only when the corrected number, or every word of a corrected name, is printed on the page it cites. The review raised 12,860 findings, most of them gaps (shareholders, subsidiaries and lines the first pass had missed); 10,960 corrections and additions passed that check and were applied (among them headcounts, holding and shareholder types, and export markets that were really tourists' home countries), and 1,134 did not and were set aside. 329 were not applied by design: where shares sit in a margin or nominee account we name the owner they are held for, and the controller field is the largest shareholder, which is not always a controlling one. The remaining 437, mostly holdings and group names the report does not settle, are left for a later pass.</li>
      </ul>

      <h3>Definitions and assumptions</h3>
      <ul>
        <li><b>Revenue</b> is the company’s own revenue line. For banks and finance companies it is gross income; for insurers, gross written premium. A parent company’s revenue is consolidated, so it already includes its subsidiaries: totals add up only top-level companies. Figures in US dollars are converted at LKR 300 to the dollar.</li>
        <li><b>Growth</b> is shown two ways. <i>Nominal</i> is the change in rupees, as reported. <i>Real</i> removes inflation: the latest year deflates by the average Colombo Consumer Price Index over the company’s own financial year, against the year before.</li>
        <li><b>History</b> is shown in rupees of the company’s latest year. The price index for each financial year averages the consumer price index over its twelve months (a year to March takes nine months of one calendar year and three of the next). It chains the Colombo index from 2023, the World Bank’s reported Colombo inflation for 2018 to 2022, and the World Bank consumer price index before that. It is the national index, not each company’s own prices.</li>
        <li><b>Signs.</b> Costs and cash outflows are shown as negative numbers however a report printed them; income tax and impairment keep their printed sign, because a tax credit or a reversal is a real positive. Cash is the “cash and cash equivalents” line the balance sheet prints.</li>
        <li><b>Margins</b> divide by revenue: net margin is profit after tax, operating margin is operating profit, gross margin is gross profit. They are left out for banks, finance companies and insurers, whose revenue is not sales, and where they exceed ±100%.</li>
        <li><b>Returns and balance sheet.</b> Return on equity is profit after tax over equity at the year end. Debt includes lease liabilities; net debt is debt less cash. Interest cover is operating profit over finance costs. Cash conversion is cash from operations over profit after tax. Free cash flow is cash from operations less capital spending.</li>
        <li><b>Value and dividends.</b> Price to earnings, price to book and dividend yield use the CSE share price in November 2026, not the price at the financial year end. Dividend payout is dividend per share over earnings per share.</li>
        <li><b>Comparisons</b> use listed companies of the same kind: banks with banks, finance companies with finance companies, insurers with insurers, and everyone else with its broad sector. Where fewer than ten in that sector report a figure, a company outside finance is compared with all listed companies outside finance, and a lender or insurer is not compared.</li>
        <li><b>The spreads under the headline figures</b> describe whatever companies the filters leave. Sums count a subsidiary once, inside its group when the group is in view; counts, medians and spreads use every company. With thirty or more values they show columns, with eight to twenty-nine a dot per company, and with three to seven a list. Only listed companies publish accounts, so profit, return, growth and debt describe listed companies only.</li>
        <li><b>Performance labels</b> (profitable and growing, fell into loss and so on) combine profit after tax in both years with real revenue growth; a company whose equity is negative is labelled so first.</li>
      </ul>

      <h3>Good, watch and weak marks</h3>
      <ul>
        <li>Each figure in a company’s detail carries a mark from a fixed rule, with the reason beside it. They are not a view on the company or its shares, and there is no overall score.</li>
        <li><b>Weak</b> is kept for a line that means the same for every company, or a regulator’s minimum: a loss; negative margins or returns; debt larger than equity; operating profit covering interest less than 1.5 times; revenue shrinking 5% or more after inflation; capital below the minimum. <b>Good</b> and <b>watch</b> mark the other side of the same lines (debt at 40% of equity or less is good, 40–100% is watch; cover of 3.5 times or more is good, 1.5–3.5 is watch).</li>
        <li>Capital minimums: banks need Tier 1 capital of 8.5% and total capital of 12.5% (CBSL Banking Act Directions No. 11 of 2019), plus a surcharge for a systemically important bank under Directions No. 2 of 2025 (Commercial Bank 1.5 points, Hatton National Bank and Sampath Bank 1.0, as each states in its 2025 annual report). Finance companies need 8.5% and 12.5%, or 10% and 14% with assets of LKR 100bn or more (Finance Business Act Directions No. 3 of 2018). Insurers need a capital adequacy ratio of 120% (IRCSL). Within 2 points of a bank’s or finance company’s minimum, or under 160% for an insurer, is watch.</li>
        <li>Where no line applies, a figure is compared with at least ten similar listed companies: the best quarter is good, the middle half is typical, the weakest quarter is watch. A comparison alone never marks a figure weak.</li>
        <li>Share valuation (price to earnings, price to book, dividend yield), dividend payout (unless more than the profit, or paid in a loss year), net interest margin, loan growth and gross margin are not marked.</li>
        <li>“Better” or “worse than last year” compares the same figure worked out from the prior year’s statements, ignoring small moves (1 point for margins and returns, half a point for capital ratios).</li>
      </ul>

      <h3>Ownership</h3>
      <ul>
        <li>A group is built from each company’s largest stated shareholder: one parent per company, followed upward to the top. A company only mentioned in another’s report, without a stake, does not shape the tree.</li>
        <li>The largest shareholder comes from each report’s table of the twenty largest shareholders. Margin and custodian accounts (“Bank PLC / Mr X”) are shown under the person or fund they are held for; a holder’s numbered accounts are added together; the same holder spelled different ways is one holder.</li>
        <li>Seven companies have voting and non-voting shares. Their stakes are kept apart and a stake is a percentage of its class; the largest shareholder counts voting shares only.</li>
        <li>Whether a shareholder is a person, a company, the state or a pension fund is read from the name and is not checked against a registry. People with the same name are not told apart.</li>
      </ul>

      <h3>Sectors</h3>
      <ul>
        <li>Each company has up to four of 81 sector tags in 14 broad sectors, assigned by a language model from the company’s own description. Every tag carries the words that justify it, and a tag whose words are not in the description is rejected. A company with no description has no sector.</li>
        <li>Industry codes follow the UN classification (ISIC Rev. 4).</li>
      </ul>

      <h3>Limits</h3>
      <ul>
        <li>This is not a census: small and medium companies are missing, and unlisted companies rarely publish figures.</li>
        <li>Seven listed companies have no usable report text (six files were errata notices and one a scanned image), so their figures are empty.</li>
        <li>Employee numbers and some lines are printed by only some reports. Empty means not known, not zero or false.</li>
        <li>Figures are as the companies published them. A multi-year summary may restate earlier years or round them differently from the statements of each year.</li>
      </ul>

      <h3>Use the data</h3>
      <p>The tables behind this page are free to reuse under CC BY 4.0, with the original publishers keeping their rights: <a href="/data/lk-companies">companies and groups</a>, <a href="/data/lk-company-financials">financial statements</a>, <a href="/data/lk-company-history">financial history</a>, <a href="/data/lk-company-sectors">sectors</a>, <a href="/data/lk-company-relationships">ownership</a>, <a href="/data/lk-company-segments">operating segments</a> and <a href="/data/lk-company-shareholders">shareholders</a>. An AI assistant can query all of them through the <a href="/connect">developing-country.org connector</a>.</p>
    </div>
  </dialog>
</div>
</SiteLayout>

<style is:global>
.cmap{--paper:#f7f6f4; --raised:#ffffff; --ink:#050505; --dim:#5f5d56;
  --hair:rgba(5,5,5,.16); --hair2:rgba(5,5,5,.07); --quiet:rgba(5,5,5,.22);
  --teal:#00a191; --teal-tint:rgba(0,161,145,.13); --on-teal:#ffffff;
  --blue:#2456c4; --amber:#e8930c; --verm:#d14321; --up:#0b7a4b; --down:#b3361b;
  --mono:'M PLUS 1 Code',ui-monospace,SFMono-Regular,Menlo,monospace;
  --sans:'Overpass',system-ui,-apple-system,'Segoe UI',sans-serif;color:var(--ink);font:400 15px/1.45 var(--sans);overflow-x:clip}
.cmap *{box-sizing:border-box}
.cmap [hidden]{display:none!important}
.cmap button{font:inherit;color:inherit}
.cmap a{color:var(--blue)}
.cmap :focus-visible{outline:2px solid var(--blue);outline-offset:2px} /* the one focus style for every control on the page */
.cmap .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.cmap.wrap{max-width:1440px;margin:0 auto;padding:0 clamp(16px,3vw,40px)}
.cmap h1{font:700 15px/1.3 var(--sans);color:var(--dim);margin:44px 0 10px}
.cmap .lead{font:600 clamp(22px,5vw,32px)/1.35 var(--sans);letter-spacing:-.01em;margin:0 0 20px;max-width:900px}
.cmap .lead b{font-family:var(--mono);font-weight:500}
.cmap .find{position:relative;max-width:560px;margin-bottom:22px}
.cmap .find input{display:block;width:100%;height:44px;margin:0;font:400 16px/1.2 var(--sans);color:var(--ink);background:var(--raised);
  border:1px solid var(--quiet);border-radius:2px;padding:0 44px 0 38px;-webkit-appearance:none;appearance:none}
.cmap .find input:hover{border-color:var(--dim)}
.cmap .find input:focus{border-color:var(--ink)}
.cmap .find input::placeholder{color:var(--dim);opacity:1}
.cmap .find input::-webkit-search-cancel-button{-webkit-appearance:none;appearance:none}
.cmap .find-ico{position:absolute;left:13px;top:14px;width:16px;height:16px;color:var(--dim);pointer-events:none}
.cmap .find-x{position:absolute;right:0;top:0;width:44px;height:44px;border:0;background:none;padding:0;cursor:pointer;font:400 24px/1 var(--sans);color:var(--dim)}
.cmap .bar{display:flex;flex-wrap:wrap;gap:8px 14px;align-items:center;padding:12px 0;border-top:1px solid var(--hair)}
.cmap .seg{display:flex;gap:4px}
.cmap .seg button{min-height:36px;font:500 12px/1 var(--mono);background:none;border:1px solid var(--hair);border-radius:2px;padding:0 12px;cursor:pointer;color:var(--dim)}
.cmap .seg button[aria-pressed="true"]{color:var(--paper);background:var(--ink);border-color:var(--ink)}
.cmap .filters{display:flex;flex-wrap:wrap;gap:6px}
.cmap .fbtn-w{position:relative}
.cmap .fbtn{min-height:36px;font:500 12px/1 var(--mono);background:var(--raised);border:1px solid var(--quiet);border-radius:2px;padding:0 10px;cursor:pointer}
.cmap .fbtn:hover{border-color:var(--ink)}
.cmap .fbtn[aria-expanded="true"]{border-color:var(--blue)}
.cmap .fbtn.on{border-color:var(--teal);box-shadow:inset 0 -2px 0 var(--teal)}
.cmap .fbtn .car{font-size:9px;margin-left:6px;color:var(--dim)}
.cmap .menu{position:absolute;top:calc(100% + 6px);left:0;z-index:30;list-style:none;margin:0;padding:6px 0;min-width:230px;max-width:calc(100vw - 32px);
  max-height:min(70vh,460px);overflow-y:auto;background:var(--raised);border:1px solid var(--ink);border-radius:2px;box-shadow:2px 2px 0 var(--ink);font:400 14px/1.3 var(--sans)}
.cmap .menu [role=option]{padding:7px 16px 7px 30px;cursor:pointer;position:relative;white-space:nowrap;display:flex;justify-content:space-between;gap:14px}
.cmap .menu [role=option] .n{font:500 11px/1.3 var(--mono);color:var(--dim)}
.cmap .menu [role=option][aria-selected="true"]::before{content:'✓';position:absolute;left:11px;color:var(--teal)}
.cmap .menu [role=option]:hover,.cmap .menu [role=option]:focus{outline:none;background:var(--teal-tint)}
.cmap .menu [role=option].fam{font-weight:600}
.cmap .menu [role=option].sub{padding-left:44px}
.cmap .menu [role=option].sub[aria-selected="true"]::before{left:25px}
.cmap .menu .grp{font:500 10px/1 var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--dim);padding:12px 16px 5px 30px}
.cmap .chips{display:flex;flex-wrap:wrap;gap:6px;min-height:8px;padding:0 0 12px}
.cmap .chip{display:inline-flex;align-items:center;gap:6px;font:500 12px/1 var(--mono);background:var(--teal-tint);border:1px solid var(--teal);border-radius:2px;padding:0 0 0 8px;min-height:30px}
.cmap .chip button{border:0;background:none;cursor:pointer;padding:0 9px;min-height:30px;font-size:15px;color:var(--dim)}
.cmap .chip button:hover{color:var(--ink)}
.cmap .clear{font:500 12px/1 var(--mono);background:none;border:0;color:var(--blue);text-decoration:underline;text-underline-offset:3px;cursor:pointer;min-height:30px}
.cmap section{border-top:1px solid var(--hair)}
.cmap .lbl{font:500 11px/1 var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--dim);margin:0 0 10px}
.cmap .kpis{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:0 24px;padding:16px 0 22px}
.cmap .kpi .v{display:block;font:500 24px/1.2 var(--mono);margin-top:8px}
.cmap .kpi .s{display:block;font:500 11px/1.5 var(--mono);color:var(--dim);margin-top:4px}
/* the second row: four tiles, each opening a note and a dialog */
.cmap .dists{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0 24px;padding:18px 0 14px;border-bottom:1px solid var(--hair)}
.cmap .dtile{position:relative;min-width:0;display:flex;flex-direction:column}
.cmap .dtile .lbl{margin:0;line-height:1.3}
.cmap .dnum{font:500 24px/1.2 var(--mono);margin:8px 0 0;white-space:nowrap}
.cmap .dnum small{font-size:13px;color:var(--dim)}
.cmap .dsay{font:400 12.5px/1.4 var(--sans);color:var(--dim);margin:4px 0 0;max-width:30ch}
.cmap .dsay b{font:500 12px/1 var(--mono);color:var(--ink)}
/* one small chart per tile, bottom-aligned so the four baselines agree */
.cmap .dviz{margin-top:auto;padding-top:12px}
.cmap .dbar{display:flex;gap:2px;height:14px}
.cmap .dbar i{display:block;min-width:3px;background:var(--quiet)}
.cmap .dcols{display:flex;align-items:flex-end;gap:3px;height:40px}
.cmap .dcols i{flex:1;display:block;min-height:2px;background:var(--quiet)}
.cmap .dviz i.hi{background:var(--teal)}   /* the share the headline names */
.cmap .dviz i.lo{background:var(--down)}   /* below a hard line: a loss, cover under 1.5 times, capital under the minimum */
.cmap .dviz i.mk{background:var(--dim)}    /* counted in the headline, but not below a line */
.cmap .dax{display:flex;justify-content:space-between;gap:8px;font:500 10px/1.3 var(--mono);color:var(--dim);margin-top:4px;white-space:nowrap}
.cmap .dcols + .dax{border-top:1px solid var(--ink);padding-top:4px;margin-top:0}
.cmap .dstrip{display:block;width:100%;height:40px}
.cmap .dstrip .ax{stroke:var(--quiet);stroke-width:1}
.cmap .dstrip .med{stroke:var(--ink);stroke-width:1.5}
.cmap .dstrip circle{fill:var(--dim);stroke:var(--paper);stroke-width:1.5}
.cmap .dstrip circle.lo{fill:var(--down)}
.cmap .dmini{list-style:none;margin:0;padding:0;font:400 12px/1.3 var(--sans)}
.cmap .dmini li{display:flex;justify-content:space-between;gap:8px;padding:3px 0;border-bottom:1px solid var(--hair2)}
.cmap .dmini li span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.cmap .dmini b{font:500 11.5px/1.3 var(--mono);white-space:nowrap}
/* the foot of a tile: who reports it (opens the note) and the way into the detail */
.cmap .dbase{display:flex;justify-content:space-between;align-items:center;gap:8px;margin:6px 0 0;min-height:32px}
.cmap .dinfo{position:relative;z-index:1;display:inline-flex;align-items:center;gap:6px;min-height:32px;padding:0;border:0;background:none;cursor:pointer;
  font:500 10.5px/1.2 var(--mono);color:var(--dim);text-align:left}
.cmap .dinfo .i{flex:none;display:inline-grid;place-items:center;width:14px;height:14px;border:1px solid var(--dim);border-radius:2px;font:500 9.5px/1 var(--mono);font-style:normal}
.cmap .dinfo:hover,.cmap .dinfo[aria-expanded="true"]{color:var(--ink)}
.cmap .dinfo[aria-expanded="true"] .i{background:var(--ink);border-color:var(--ink);color:var(--paper)}
.cmap .dmore{flex:none;min-height:32px;padding:0;border:0;background:none;cursor:pointer;font:500 11px/1 var(--mono);color:var(--blue);white-space:nowrap}
.cmap .dmore::after{content:'';position:absolute;inset:0 0 38px 0}   /* the whole tile above the foot opens the detail */
.cmap .dtile:hover .dmore,.cmap .dmore:focus-visible{text-decoration:underline;text-underline-offset:3px}
/* the note: a paper slab with the blue information stripe; never traps focus */
.cmap .dpop{position:absolute;z-index:20;left:0;top:calc(100% + 2px);width:300px;max-width:calc(100vw - 32px);background:var(--raised);border:1px solid var(--ink);border-top:3px solid var(--blue);
  border-radius:2px;box-shadow:3px 3px 0 var(--ink);padding:12px 14px 12px;font:400 13px/1.45 var(--sans);color:var(--ink)}
.cmap .dtile:last-child .dpop{left:auto;right:0}
.cmap .dpop p{margin:0 0 8px}
.cmap .dpop p:last-child{margin:0}
.cmap .dpop b{font:500 12px/1 var(--mono)}
.cmap .dpop .linkbtn{font-size:12.5px}

/* tablet: two by two */
@media (max-width:899px){
  .cmap .dists{grid-template-columns:repeat(2,minmax(0,1fr));gap:0 24px;padding:0 0 4px}
  .cmap .dtile{padding:16px 0 8px;border-top:1px solid var(--hair2)}
  .cmap .dtile:nth-child(-n+2){border-top:0}
  .cmap .dtile:nth-child(even) .dpop{left:auto;right:0}
}
/* phone: a ledger, one row per finding, chart beside the figure */
@media (max-width:559px){
  .cmap .dists{grid-template-columns:minmax(0,1fr)}
  .cmap .dtile{display:grid;grid-template-columns:minmax(0,1fr) 132px;column-gap:14px;padding:14px 0 4px;
    grid-template-areas:"lbl lbl" "num viz" "say viz" "base base"}
  .cmap .dtile:nth-child(2){border-top:1px solid var(--hair2)}
  .cmap .dtile .lbl{grid-area:lbl}
  .cmap .dnum{grid-area:num;font-size:22px}
  .cmap .dsay{grid-area:say}
  .cmap .dviz{grid-area:viz;align-self:end;margin:0;padding:0}
  .cmap .dbase{grid-area:base;min-height:40px}
  .cmap .dinfo,.cmap .dmore{min-height:40px}
  .cmap .dmore::after{inset:0 0 44px 0}
  .cmap .dax .mid{display:none}
  .cmap .dpop,.cmap .dtile:last-child .dpop,.cmap .dtile:nth-child(even) .dpop{left:0;right:0;width:auto}
}

/* ---------- the detail dialog (reuses dialog.method, .mhead, .mclose, .mbody, .dtabs, .seg) ---------- */
.cmap dialog.method.ddlg{width:min(720px,calc(100vw - 32px))}
.cmap .ddlg .dtabs{margin:0;padding:10px 22px 0;overflow-x:auto;scrollbar-width:none;flex:none}
.cmap .ddlg .dtabs button{white-space:nowrap;padding:11px 13px 10px}
.cmap .ddlg .mbody{padding:18px 22px 22px}
.cmap .ddsay{font:600 20px/1.3 var(--sans);letter-spacing:-.005em;margin:0 0 6px;max-width:32ch}
.cmap .ddsub{margin:0 0 14px;color:var(--dim);font-size:14px;max-width:62ch}
.cmap .ddsub b,.cmap .ddnotes b,.cmap .ddsay .m{font-family:var(--mono);font-weight:500;color:var(--ink)}
.cmap .ddsay .m{font-size:.92em}
.cmap .ddlg .seg{margin:0 0 14px}
.cmap .ddlg .mbody h3{font:500 11px/1 var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--dim);margin:22px 0 8px}
.cmap .ddcols{display:flex;align-items:flex-end;gap:6px;height:132px;border-bottom:1px solid var(--ink)}
.cmap .ddcols .col{flex:1;min-width:0;height:100%;display:flex;flex-direction:column;justify-content:flex-end}
.cmap .ddcols .c{font:500 12px/1 var(--mono);text-align:center;margin-bottom:4px}
.cmap .ddcols i{display:block;min-height:2px;background:var(--quiet)}
.cmap .ddcols i.lo{background:var(--down)} .cmap .ddcols i.mk{background:var(--dim)}
.cmap .ddcolax{display:flex;gap:6px;margin-top:5px}
.cmap .ddcolax span{flex:1;min-width:0;font:500 10.5px/1.25 var(--mono);color:var(--dim);text-align:center}
.cmap .ddbar{display:flex;gap:2px;height:26px}
.cmap .ddbar i{display:block;min-width:3px;background:var(--quiet)}
.cmap .ddbar i.hi{background:var(--teal)} .cmap .ddbar i.lo{background:var(--down)}
.cmap .ddt{width:100%;border-collapse:collapse;font:400 13.5px/1.3 var(--sans);margin-top:10px}
.cmap .ddt th,.cmap .ddt td{padding:7px 12px 7px 0;border-bottom:1px solid var(--hair2);text-align:right;vertical-align:middle}
.cmap .ddt th:first-child,.cmap .ddt td:first-child{text-align:left}
.cmap .ddt th:last-child,.cmap .ddt td:last-child{padding-right:0}
.cmap .ddt thead th{font:500 10px/1.2 var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--dim);border-bottom:1px solid var(--hair)}
.cmap .ddt td.n{font:500 12.5px/1.3 var(--mono)}
.cmap .ddt td.b{width:34%}
.cmap .ddt .tk{display:inline-block;width:9px;height:9px;margin-right:7px;background:var(--quiet)}
.cmap .ddt .tk.hi{background:var(--teal)} .cmap .ddt .tk.lo{background:var(--down)}
.cmap .ddt .pr{display:flex;flex-direction:column;gap:2px}
.cmap .ddt .pr i{display:block;height:6px;min-width:1px;background:var(--quiet)}
.cmap .ddt .pr i.hi{background:var(--teal)}
.cmap .ddkey{display:flex;flex-wrap:wrap;gap:4px 16px;font:500 10.5px/1.3 var(--mono);color:var(--dim);margin:8px 0 0}
.cmap .ddkey i{display:inline-block;width:9px;height:9px;margin-right:6px;background:var(--quiet)}
.cmap .ddkey i.hi{background:var(--teal)}
.cmap .mbody .ddnotes{margin:0;padding-left:18px;font-size:13.5px;line-height:1.5;color:var(--dim);max-width:66ch}
.cmap .ddnotes li{margin:0 0 5px}
.cmap .ddfoot{margin:16px 0 0;font-size:13.5px}
/* phone */
@media (max-width:760px){
  .cmap .ddlg .mhead{padding:14px 14px 12px}
  .cmap .ddlg .dtabs{padding:8px 14px 0}
  .cmap .ddlg .dtabs button{padding:11px 10px 10px;letter-spacing:.04em}
  .cmap .ddlg .mbody{padding:16px 14px 20px}
  .cmap .ddsay{font-size:18px}
  .cmap .ddt td.b{width:26%}
