.cmap .cov{margin:-4px 0 12px;font:500 12px/1.5 var(--mono);color:var(--dim);max-width:900px}
.cmap .tabletools{display:flex;align-items:center;justify-content:flex-end;gap:10px;margin:0 0 6px}
.cmap .tabletools .lbl{margin:0}
.cmap .tabletools select{font:500 12px/1 var(--mono);min-height:34px;padding:0 8px;border:1px solid var(--quiet);border-radius:2px;background:var(--raised);color:var(--ink)}
