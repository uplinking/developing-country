.cmap .lblrow{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:10px}
.cmap .lblrow .lbl{margin:0}
.cmap .seg.mini button{min-height:26px;padding:0 8px;font-size:11px}
/* the filters drawer: a slab from the right, full screen on phones */
.cmap dialog.drawer{position:fixed;inset:0 0 0 auto;margin:0;width:min(520px,100vw);height:100dvh;max-height:100dvh;padding:0;border:0;border-left:1px solid var(--ink);border-top:4px solid var(--teal);border-radius:0;background:var(--raised);color:var(--ink);font:400 15px/1.5 var(--sans);box-shadow:-4px 0 0 var(--ink)}
