}
const segP = (key, opts) => `<div class="seg mini" role="group" aria-label="Show">${opts.map(([id, t]) => `<button type="button" data-dstate="${key}" data-v="${id}" aria-pressed="${DIST_STATE[key] === id}">${t}</button>`).join('')}</div>`
function bigCols(bins, tone, caption) {
  const max = Math.max(1, ...bins.map(b => b.n))
  return `<div class="ddcols" role="img" aria-label="${esc(caption + ': ' + bins.map(b => `${b.label} ${b.n}`).join(', '))}">${bins.map(b => `<div class="col"><span class="c">${b.n}</span><i class="${tone(b)}" style="height:${Math.max(b.n ? 2 : 0, b.n / max * 100).toFixed(0)}%"></i></div>`).join('')}</div>
    <div class="ddcolax">${bins.map(b => `<span>${esc(b.label)}</span>`).join('')}</div><p class="ddcap">${esc(caption)}</p>`
}
const midTone = b => b.max !== null ? b.max - 1e-9 : b.min + 1
const panel = (say, sub, body, notes) => `<p class="ddsay">${say}</p>${sub ? `<p class="ddsub">${sub}</p>` : ''}${body}
  <h3>What this counts</h3><ul class="ddnotes">${notes.map(n => `<li>${n}</li>`).join('')}</ul>
  <p class="ddfoot"><button type="button" class="linkbtn" data-method>How this was made: sources, checks, definitions and limits</button></p>`
const nameList = pts => `<ol class="ddnames">${pts.map(p => `<li>${linkTo(p.id, shortName(p.name))}<b>${p.v}</b></li>`).join('')}</ol>`
function spreadPanel(tab, d) {
  if (tab === 'size') {
    const sv = d.size, assets = sv.measure === 'assets', what = assets ? 'assets' : 'revenue', who = company(d.lenders)
    const say = sv.top ? `The ${sv.top.k} largest ${who} ${assets ? 'hold' : 'earn'} <span class="m">${pctS(sv.top.pct, 0)}</span> of the ${what}.` : `${plural(sv.n, d.lenders ? 'lender' : 'company')} report ${what}.`
    const big = sv.bands[sv.bands.length - 1], first = sv.largest[0]
    const sub = sv.n >= 6 ? `The largest, ${esc(shortName(first.name))}, ${assets ? 'holds' : 'earns'} ${B(pctS(first.value / sv.total * 100, 0))} on its own.${big.n ? ` The ${big.n} above ${esc(big.label.replace(' or more', ''))} are ${B(pctS(big.companiesPct, 0))} of the ${who} and ${assets ? 'hold' : 'earn'} ${B(pctS(big.valuePct, 0))} of the ${what}.` : ''}` : ''
    const body = DIST_STATE.size === 'dist' && sv.hist.length > 1
      ? bigCols(sv.hist.map(h => { const t = v => v >= 1e12 ? (v / 1e12).toFixed(0) + 'tn' : v >= 1e9 ? (v / 1e9).toFixed(0) + 'bn' : (v / 1e6).toFixed(0) + 'm'; return { label: t(h.lo), n: h.n, min: h.lo, max: h.hi } }), () => '', `Number of ${who} by ${what} in LKR; each column starts at the figure under it and covers about three times the one before`)
      : `<table class="ddt"><thead><tr><th>${assets ? 'Assets' : 'Revenue'}</th><th>${d.lenders ? 'Lenders' : 'Companies'}</th><th class="b"><span class="sr">Shares</span></th><th class="opt">Of ${who}</th><th>Of ${what}</th></tr></thead><tbody>
        ${sv.bands.filter(b => b.n).map(b => `<tr><td>${esc(b.label)}</td><td class="n">${b.n}</td><td class="b"><span class="pr"><i style="width:${b.companiesPct.toFixed(1)}%"></i><i class="hi" style="width:${b.valuePct.toFixed(1)}%"></i></span></td><td class="n opt">${pctS(b.companiesPct, 0)}</td><td class="n">${pctS(b.valuePct, 0)}</td></tr>`).join('')}</tbody></table>
        <p class="ddkey"><span><i></i>share of ${who}</span><span><i class="hi"></i>share of ${what}</span></p>`
    return panel(say, sub, (sv.n >= 6 ? segP('size', [['bands', 'Share by band'], ['dist', `${d.lenders ? 'Lenders' : 'Companies'} by size`]]) : '') + body
      + (sv.largest.length ? `<h3>Largest</h3>${nameList(sv.largest.map(p => ({ ...p, v: lkrShort(p.value) })))}` : ''),
      [`${B(reportIt(sv.n, sv.base))} report a ${what} figure that can be added up: ${B(fmtLkr(sv.total))} between them.`, 'A subsidiary is counted once, inside its group.',
        assets ? 'Lenders are measured by total assets, because their income moves with interest rates.' : 'For banks and finance companies revenue means gross income.'])
  }
  if (tab === 'profit') {
    const pp = d.pool, top = pp.top5Pct !== null ? pp.profitsLkr * pp.top5Pct / 100 : 0
    const say = `Companies made <span class="m">${fmtLkr(pp.profitsLkr)}</span> in profit${pp.lossesLkr ? ` and lost <span class="m">${fmtLkr(-pp.lossesLkr)}</span>` : ''}.`
    const sub = `${pp.lossesLkr ? `Losses are about ${B(pctS(-pp.lossesLkr / pp.profitsLkr * 100, 0))} of profits. ` : ''}${pp.top5Pct !== null ? `The 5 largest earners make ${B(pctS(pp.top5Pct, 0))} of the profit.` : ''}`
    const rows = [top ? ['hi', '5 largest earners', 5, top] : null, ['', top ? 'Everyone else in profit' : 'Companies in profit', pp.profitable - (top ? 5 : 0), pp.profitsLkr - top], pp.lossesLkr ? ['lo', 'Companies that made a loss', pp.lossMaking, pp.lossesLkr] : null].filter(Boolean)
    return panel(say, sub, `<div class="ddbar">${top ? `<i class="hi" style="flex:${top}"></i>` : ''}<i style="flex:${pp.profitsLkr - top}"></i>${pp.lossesLkr ? `<i class="lo" style="flex:${-pp.lossesLkr}"></i>` : ''}</div>
      <table class="ddt"><thead><tr><th>Who</th><th>Companies</th><th>LKR</th><th class="opt">Share of profit</th></tr></thead><tbody>
      ${rows.map(([c, w, n, v]) => `<tr><td><i class="tk ${c}"></i>${w}</td><td class="n">${n}</td><td class="n">${lkrShort(v)}</td><td class="n opt">${v > 0 ? pctS(v / pp.profitsLkr * 100, 0) : ''}</td></tr>`).join('')}</tbody></table>
      ${pp.biggestLosses.length ? `<h3>Largest losses</h3>${nameList(pp.biggestLosses.map(p => ({ ...p, v: lkrShort(-p.value) })))}` : ''}`,
      [`${B(reportIt(pp.n, pp.base, 'publish accounts'))}. Only listed companies do.`, 'Sums count a subsidiary once, inside its group.', 'The list of losses counts every company, so a subsidiary’s loss shows even when its group made a profit.', 'Profit is after tax.'])
  }
  if (tab === 'roe') {
    const sp = d.roe, who = d.lenders ? 'lender' : 'company', neg = sp.points.filter(p => p.value < 0).length, hi = sp.points.filter(p => p.value >= 20).length
    return panel(`The middle ${who} earns <span class="m">${pctS(sp.median)}</span> on its owners’ money.`,
      sp.n >= 8 ? `Half earn between ${B(pctS(sp.p25))} and ${B(pctS(sp.p75))}. ${neg} made a loss; ${hi} earned 20% or more.` : '',
      sp.n >= 8 ? bigCols(sp.bins, b => midTone(b) <= 0 ? 'lo' : '', `Number of ${d.lenders ? 'lenders' : 'companies'} in each band of return on equity`) : nameList(sp.points.map(p => ({ ...p, v: pctS(p.value) }))),
      [`${B(reportIt(sp.n, sp.base))}.`, 'Return on equity is profit after tax divided by shareholders’ equity at the year end.', 'Companies whose equity is negative are left out: the ratio means nothing for them.'])
  }
  if (tab === 'growth') {
    const five = DIST_STATE.growth === 'five', sp = d.growth, grew = sp.points.filter(p => p.value > 0).length
    return panel(sp.n ? `The middle company ${sp.median < 0 ? 'shrank' : 'grew'} <span class="m">${pctS(Math.abs(sp.median))}</span>${five ? ' a year' : ''} after inflation${five ? ' over five years' : ''}.` : 'Too few companies here report growth.',
      sp.n >= 8 ? `${grew} of ${sp.n} grew. Half fall between ${B(signed(sp.p25))} and ${B(signed(sp.p75))}.` : '',
      segP('growth', [['year', 'This year'], ['five', 'Five years']]) + (sp.n >= 8 ? bigCols(sp.bins, b => midTone(b) <= 0 ? 'lo' : '', 'Number of companies by change in revenue, after inflation') : sp.n ? nameList(sp.points.map(p => ({ ...p, v: signed(p.value) }))) : ''),
      [`${B(reportIt(sp.n, sp.base))} companies outside lending report it.`, 'Banks and finance companies are left out: their income moves with interest rates, not sales.',
        'Companies whose revenue jumped for a one-off reason are left out too, such as vehicle importers when imports reopened.', 'The headline row counts lenders as well, so its figure can differ.'])
  }
  if (tab === 'debt') {
    const dr = d.debt, weak = dr.bands[0].borrowingsPct + dr.bands[1].borrowingsPct, weakN = dr.bands[0].n + dr.bands[1].n
    const rows = [['lo', 'Less than 1.5 times', weakN, weak], ['', '1.5 to 3.5 times', dr.bands[2].n, dr.bands[2].borrowingsPct], ['', '3.5 times or more', dr.bands[3].n, dr.bands[3].borrowingsPct]]
    return panel(`<span class="m">${pctS(weak, 0)}</span> of borrowing sits with companies that barely cover their interest.`,
      `${weakN} ${weakN === 1 ? 'company earns' : 'companies earn'} less than 1.5 times their interest bill in operating profit.${dr.median !== null ? ` The middle company covers it ${B(dr.median.toFixed(1) + '×')}.` : ''}`,
      `<div class="ddbar">${rows.filter(r => r[3] > 0).map(r => `<i class="${r[0]}" style="flex:${r[3]}"></i>`).join('')}</div>
      <table class="ddt"><thead><tr><th>Operating profit covers interest</th><th>Companies</th><th>Share of borrowing</th></tr></thead><tbody>
      ${rows.map(([c, w, n, v]) => `<tr><td><i class="tk ${c}"></i>${w}</td><td class="n">${n}</td><td class="n">${pctS(v, 0)}</td></tr>`).join('')}</tbody></table>
      ${dr.atRisk.length ? `<h3>Largest borrowers under 1.5 times</h3>${nameList(dr.atRisk.slice(0, 8).map(p => ({ ...p, v: lkrShort(p.value) })))}` : ''}`,
      [`${B(reportIt(dr.n, dr.base))} companies outside finance report it. Between them they borrowed ${B(fmtLkr(dr.borrowingsLkr))}.`, 'Interest cover is operating profit divided by finance costs. Under 1.5 times is the line lenders treat as weak.',
        'A company with an operating loss and borrowings counts in the lowest band.', 'Banks, finance companies and insurers are left out: borrowing is their business.'])
  }
  if (tab === 'capital') {
    const sp = d.capital, close = sp.points.filter(p => p.value < 2), below = sp.points.filter(p => p.value < 0).length
    return panel(`<span class="m">${close.length} of ${sp.n}</span> lenders hold less than 2 points of capital above the minimum.`,
      `${below ? `${below} ${below === 1 ? 'is' : 'are'} below it. ` : ''}The middle lender is ${B(sp.median.toFixed(1))} points clear.`,
      (sp.n >= 8 ? bigCols(sp.bins, b => midTone(b) < 0 ? 'lo' : midTone(b) < 2 ? 'mk' : '', 'Number of lenders by points of total capital above their minimum') : '')
        + (close.length ? `<h3>Under 2 points</h3>${nameList(close.sort((a, b) => a.value - b.value).map(p => ({ ...p, v: (p.value >= 0 ? '+' : '−') + Math.abs(p.value).toFixed(1) })))}` : ''),
      [`${B(reportIt(sp.n, sp.base))}.`, 'Each lender’s total capital ratio less the minimum the Central Bank sets for it, in percentage points: 12.5% for banks (more for the three systemically important ones), 12.5% or 14% for finance companies by size.'])
