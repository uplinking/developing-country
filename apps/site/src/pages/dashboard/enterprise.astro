})
$('colset').addEventListener('change', () => { F.cols = $('colset').value; update() })
$('more').addEventListener('click', () => { shown += 100; drawRows(current) })

/* ---------- drawing ---------- */
let current = []
function update(replace = false) {
  EF = effectiveFilter(F)
  current = sortRows(rowsMatching(EF), F.sort, F.desc)
  const qs = filterToParams(F).toString()
  history[replace ? 'replaceState' : 'pushState'](null, '', (qs ? '?' + qs : location.pathname) + (location.hash === '#method' ? location.hash : ''))
  root.querySelectorAll('[data-scope]').forEach(b => b.setAttribute('aria-pressed', String(!EF.group && b.dataset.scope === EF.scope)))
  $('fqx').hidden = !F.q
  $('colset').value = F.cols
  drawLenses(); drawFilters(); chips(); drawCoverage(); drawSummary(); drawDists(); drawBreaks(); drawHead(); drawRows(current)
  if (DRAWER.open) drawDrawer()
  $('copyta').hidden = true
}

function drawCoverage() {
  const parts = coverage(ROWS, EF, FAMILY).filter(c => c.reporting < c.base)
    .map(c => `${c.reporting.toLocaleString('en')} of ${c.base.toLocaleString('en')} ${EF.listed === 'yes' ? 'listed ' : ''}companies report ${c.label.toLowerCase()}`)
  const forced = listedOnlyActive(F)
  const lines = []
  if (forced.length && F.listed !== 'yes') lines.push(`Showing listed companies, including those inside groups: only listed companies publish ${forced.map(x => x.toLowerCase()).join(', ')}.`)
  if (parts.length) lines.push(`${parts.join('; ')}. Companies without the figure are not counted, not ruled out.`)
  $('coverage').hidden = !lines.length
  $('coverage').textContent = lines.join(' ')
}

function drawSummary() {
  const s = summarize(current)
  // groups among the rows shown: a group counts once, whether the list shows its parent or its companies
  const groupsShown = new Set(current.filter(r => (BYID.get(r.group_id)?.group_companies ?? 0) > 1).map(r => r.group_id)).size
  const head = EF.group ? `<b>${s.companies.toLocaleString('en')}</b> ${s.companies === 1 ? 'company' : 'companies'} in ${esc(BYID.get(EF.group)?.name ?? 'this group')}`
    : `<b>${s.companies.toLocaleString('en')}</b> ${s.companies === 1 ? 'company' : 'companies'}${groupsShown ? ` <span class="incl">(including ${groupsShown.toLocaleString('en')} ${groupsShown === 1 ? 'group' : 'groups'})</span>` : ''}`
  $('lead').innerHTML = head
  const k = (l, v, sub) => `<div class="kpi"><p class="lbl">${l}</p><span class="v">${v}</span><span class="s">${sub}</span></div>`
  const top = EF.scope === 'groups' && !EF.group
  $('kpis').innerHTML =
    (top ? k('Groups', s.groups_with_members.toLocaleString('en'), `plus ${plural(s.companies - s.groups_with_members, 'company')} outside any group`)
      : k('Companies', s.companies.toLocaleString('en'), `in ${plural(s.groups, 'group')}`)) +
    k('Combined revenue', s.revenueCount ? fmtLkr(s.revenueLkr) : '–', `${s.revenueCount.toLocaleString('en')} report it; subsidiaries counted once, inside their group`) +
    k('Grew after inflation', s.growthCount ? `${s.grewReal.toLocaleString('en')} <small>of ${s.growthCount.toLocaleString('en')}</small>` : '–',
      s.growthCount ? `median ${fmtPctPlain(s.medianRealGrowth)} this year${s.growth5Count >= 20 ? `; ${s.grew5} of ${s.growth5Count} over five years` : ''}` : 'listed companies only') +
    k('Profit or loss', s.performanceCount ? `${s.profitable.toLocaleString('en')} <small>· ${s.loss.toLocaleString('en')} loss</small>` : '–',
      s.performanceCount ? `made a profit · made a loss, of ${s.performanceCount.toLocaleString('en')} that report` : 'listed companies only') +
    k('Employees', s.employeesCount ? fmtInt(s.employees) : '–', `${s.employeesCount.toLocaleString('en')} report a headcount`) +
    (EF.listed === 'yes' && s.marketCapCount ? k('Market value', fmtLkr(s.marketCapLkr), `${s.marketCapCount.toLocaleString('en')} listed companies, CSE, November 2026`)
      : k('Known exporters', s.exporters.toLocaleString('en'), `plus ${s.overseas.toLocaleString('en')} with overseas subsidiaries or operations`))
}

/* ---------- second row: how the figures are spread ----------
   Four tiles, each one number, one line, one small chart and who reports it. The "i" on the base line opens
   a short note; the tile opens a dialog with the full spread, the tables, the names and the caveats. */
const DIST_STATE = { size: 'bands', growth: 'year', tab: 'size' }
const lkrShort = v => fmtLkr(v).replace('LKR ', '')
const shortName = n => String(n).replace(/\s*\(.*\)\s*$/, '').replace(/ PLC$/, '')
const B = v => `<b>${v}</b>`
const pctS = (v, d = 1) => `${v.toFixed(d)}%`
const signed = v => `${v > 0 ? '+' : v < 0 ? '−' : ''}${Math.abs(v).toFixed(1)}%`
const reportIt = (n, base, verb = 'report it') => `${n.toLocaleString('en')} of ${base.toLocaleString('en')} ${verb}`
const METHOD_LINK = '<button type="button" class="linkbtn" data-method>How this was made</button>'
/** marks: hi the share the headline names (teal), lo below a hard line (red), mk counted but not below a line */
const bar = (parts, label) => `<div class="dbar" role="img" aria-label="${esc(label)}">${parts.filter(p => p.v > 0).map(p => `<i class="${p.c ?? ''}" style="flex:${p.v}"></i>`).join('')}</div>`
const ends = (...xs) => `<div class="dax">${xs.map((x, i) => `<span${xs.length === 3 && i === 1 ? ' class="mid"' : ''}>${esc(x)}</span>`).join('')}</div>`
function tileCols(bins, tone, label) {
  const max = Math.max(1, ...bins.map(b => b.n))
  return `<div class="dcols" role="img" aria-label="${esc(label)}">${bins.map(b => `<i class="${tone(b)}" style="height:${Math.max(b.n ? 5 : 0, b.n / max * 100).toFixed(0)}%"></i>`).join('')}</div>`
}
/** The small chart on a tile: columns from 30 values, a dot per company from 8, the top three from 3, else nothing. */
function tileSpread(sp, fmt, tone, what) {
  const label = sp.points.map(p => `${p.name} ${fmt(p.value)}`).join(', ')
  if (sp.form === 'bins') return tileCols(sp.bins, b => tone(b.max !== null ? b.max - 1e-9 : b.min + 1), `${what}: ${sp.bins.map(b => `${b.label} ${b.n}`).join(', ')}`) + ends(sp.bins[0].label, sp.bins[sp.bins.length - 1].label)
  if (sp.form === 'dots') {
    const vals = sp.points.map(p => p.value), lo = Math.min(...vals), hi = Math.max(...vals), x = v => 4 + (hi === lo ? 0.5 : (v - lo) / (hi - lo)) * 232
    return `<svg class="dstrip" viewBox="0 0 240 40" preserveAspectRatio="none" role="img" aria-label="${esc(label)}"><line class="ax" x1="4" x2="236" y1="20" y2="20"/>
      ${sp.median !== null ? `<line class="med" x1="${x(sp.median).toFixed(1)}" x2="${x(sp.median).toFixed(1)}" y1="6" y2="34"/>` : ''}
      ${sp.points.map(p => `<circle cx="${x(p.value).toFixed(1)}" cy="20" r="4.5" class="${tone(p.value)}"/>`).join('')}</svg>${ends(fmt(lo), fmt(hi))}`
  }
  if (sp.form === 'list') return `<ol class="dmini" aria-label="${esc(label)}">${sp.points.slice(0, 3).map(p => `<li><span>${esc(shortName(p.name))}</span><b>${fmt(p.value)}</b></li>`).join('')}</ol>${sp.points.length > 3 ? ends(`and ${sp.points.length - 3} more in Details`) : ''}`
  return ''
}
function tile(key, label, num, say, viz, base, note, more = true) {
  return `<div class="dtile" data-tile="${key}"><p class="lbl">${label}</p><p class="dnum">${num}</p><p class="dsay">${say}</p>
    <div class="dviz">${viz}</div>
    <p class="dbase"><button type="button" class="dinfo" aria-expanded="false" aria-controls="dpop-${key}"><span>${base}</span><i class="i" aria-hidden="true">i</i></button>
      ${more ? `<button type="button" class="dmore" data-spread="${key}">Details<span class="sr">: ${esc(label.toLowerCase())}</span> ›</button>` : ''}</p>
    <div class="dpop" id="dpop-${key}" hidden>${note.map(x => `<p>${x}</p>`).join('')}<p>${METHOD_LINK}</p></div></div>`
}

/* the figures for the current view, worked out once per draw */
let SPREAD = null
function spreadData() {
  const lenders = DIST.lendersOnly(current)
  return { lenders, size: DIST.sizeView(current), pool: DIST.profitPool(current), roe: DIST.roeSpread(current),
    growth: DIST.growthSpread(current, DIST_STATE.growth === 'five'), debt: DIST.debtAtRisk(current),
    capital: lenders ? DIST.capitalHeadroom(current) : null, stage3: lenders ? DIST.stage3Spread(current) : null }
}
const company = (lenders, n = 2) => lenders ? (n === 1 ? 'lender' : 'lenders') : (n === 1 ? 'company' : 'companies')

function sizeTile(d) {
  const sv = d.size, assets = sv.measure === 'assets', what = assets ? 'assets' : 'revenue', who = company(d.lenders)
  const note = [`The share of combined ${what} ${assets ? 'held' : 'earned'} by the largest ${who} in view. ${B(reportIt(sv.n, sv.base))} report ${assets ? 'total assets' : 'a revenue figure'}. A subsidiary is counted once, inside its group.${assets ? ' Assets are used because a lender’s income moves with interest rates.' : ' For banks, revenue means gross income.'}`]
  const label = assets ? 'Largest lenders' : 'Largest companies'
  if (!sv.top) return tile('size', label, sv.n ? fmtLkr(sv.total) : '–', sv.n ? `combined ${what} of ${plural(sv.n, company(d.lenders, sv.n) === 'lender' ? 'lender' : 'company')}` : 'No company here reports it.',
    sv.n ? `<ol class="dmini">${sv.largest.slice(0, 3).map(p => `<li><span>${esc(shortName(p.name))}</span><b>${lkrShort(p.value)}</b></li>`).join('')}</ol>` : '', reportIt(sv.n, sv.base), note, sv.n >= 2)
  const rest = sv.n - sv.top.k
  return tile('size', label, pctS(sv.top.pct, 0), `of ${what} ${assets ? 'are held' : 'is earned'} by the ${sv.top.k} largest ${who}`,
    bar([{ v: sv.top.pct, c: 'hi' }, { v: 100 - sv.top.pct }], `The ${sv.top.k} largest hold ${sv.top.pct.toFixed(0)}% of the ${what}; the other ${rest} hold ${(100 - sv.top.pct).toFixed(0)}%`) + ends(`${sv.top.k} largest`, `${rest} others`),
    reportIt(sv.n, sv.base), note)
}
function profitTile(d) {
  const pp = d.pool
  const note = [`Profit after tax, added up; losses are added up separately. ${B(reportIt(pp.n, pp.base))} publish accounts: only listed companies do. A subsidiary is counted once, inside its group.`]
  if (!pp.n) return tile('profit', 'Profit and loss', '–', 'No company here publishes accounts. Only listed companies do.', '', reportIt(0, pp.base, 'publish accounts'), note, false)
  const top = pp.top5Pct !== null ? pp.profitsLkr * pp.top5Pct / 100 : 0
  return tile('profit', 'Profit and loss', fmtLkr(pp.profitsLkr), pp.lossesLkr ? `in profit, against ${B(fmtLkr(-pp.lossesLkr))} in losses` : 'in profit; no company made a loss',
    bar([{ v: top, c: 'hi' }, { v: pp.profitsLkr - top }, { v: -pp.lossesLkr, c: 'lo' }], `Profits ${fmtLkr(pp.profitsLkr)}, losses ${fmtLkr(-pp.lossesLkr)}`) + ends(top ? '5 largest' : 'profits', pp.lossesLkr ? 'losses' : ''),
    reportIt(pp.n, pp.base, 'publish accounts'), note)
}
function roeTile(d) {
  const sp = d.roe, who = d.lenders ? 'lender' : 'company'
  const note = [`Profit after tax as a share of the owners’ money in the company. The figure is the middle ${who}, not an average. ${B(reportIt(sp.n, sp.base))} report it. Companies with negative equity are left out.`]
  if (sp.form === 'none') return tile('roe', 'Return on equity', '–', 'Too few companies here report it to show a spread.', '', reportIt(sp.n, sp.base), note, false)
  return tile('roe', 'Return on equity', pctS(sp.median), sp.n >= 8 ? `at the middle ${who}; half earn ${B(pctS(sp.p25))} to ${B(pctS(sp.p75))}` : `at the middle ${who}`,
    tileSpread(sp, v => pctS(v), v => v <= 0 ? 'lo' : '', 'Companies by return on equity'), reportIt(sp.n, sp.base), note)
}
function debtTile(d) {
  const dr = d.debt
  const note = [`Borrowing held by companies whose operating profit is less than 1.5 times their interest bill. ${B(reportIt(dr.n, dr.base))} companies outside finance report it. Between them they borrowed ${B(fmtLkr(dr.borrowingsLkr))}.`]
  if (dr.n < 8 || !dr.borrowingsLkr) {
    const list = current.filter(r => typeof r.interest_cover === 'number' && !['bank', 'finance_company', 'insurer'].includes(r.industry_kind)).sort((a, b) => a.interest_cover - b.interest_cover)
    return tile('debt', 'Debt at risk', dr.median !== null ? `${dr.median.toFixed(1)}×` : '–', dr.median !== null ? 'interest cover at the middle company' : 'No company here reports its interest cover.',
      list.length ? `<ol class="dmini">${list.slice(0, 3).map(r => `<li><span>${esc(shortName(r.name))}</span><b>${r.interest_cover >= 100 ? 'over 100' : r.interest_cover.toFixed(1)}×</b></li>`).join('')}</ol>` : '',
      reportIt(dr.n, dr.base), note, dr.n >= 3)
  }
  const weak = dr.bands[0].borrowingsPct + dr.bands[1].borrowingsPct, weakN = dr.bands[0].n + dr.bands[1].n
  return tile('debt', 'Debt at risk', pctS(weak, 0), weakN === 1 ? 'of borrowing sits with 1 company that barely covers its interest' : `of borrowing sits with ${B(weakN)} companies that barely cover their interest`,
    bar([{ v: weak, c: 'lo' }, { v: dr.bands[2].borrowingsPct }, { v: dr.bands[3].borrowingsPct }], `Share of borrowing by interest cover: under 1.5 times ${weak.toFixed(0)}%, 1.5 to 3.5 times ${dr.bands[2].borrowingsPct.toFixed(0)}%, 3.5 times or more ${dr.bands[3].borrowingsPct.toFixed(0)}%`)
      + ends('under 1.5×', '1.5–3.5×', '3.5×+'), reportIt(dr.n, dr.base), note)
}
function capitalTile(d) {
  const sp = d.capital, close = sp.points.filter(p => p.value < 2).length, below = sp.points.filter(p => p.value < 0).length
  const note = [`Each lender’s total capital ratio less the minimum the Central Bank sets for it, in percentage points. ${B(reportIt(sp.n, sp.base))} report it.`]
  if (sp.form === 'none') return tile('capital', 'Capital cushion', '–', 'Too few lenders here report it.', '', reportIt(sp.n, sp.base), note, false)
  return tile('capital', 'Capital cushion', `${close} <small>of ${sp.n}</small>`, `hold less than 2 points of capital above the minimum${below ? `; ${B(below)} ${below === 1 ? 'is' : 'are'} below it` : ''}`,
    tileSpread(sp, v => `${v.toFixed(1)}`, v => v < 0 ? 'lo' : v < 2 ? 'mk' : '', 'Lenders by points of capital above the minimum'), reportIt(sp.n, sp.base), note)
}
function stage3Tile(d) {
  const sp = d.stage3
  const note = [`Loans in default or close to it (Stage 3) as a share of all loans, as each lender reports it. Lenders do not all count this the same way. ${B(reportIt(sp.n, sp.base))} report it.`]
  if (sp.form === 'none') return tile('stage3', 'Bad loans', '–', 'Too few lenders here report it.', '', reportIt(sp.n, sp.base), note, false)
  return tile('stage3', 'Bad loans', pctS(sp.median), sp.n >= 8 ? `of loans have gone bad at the middle lender; half sit at ${B(pctS(sp.p25))} to ${B(pctS(sp.p75))}` : 'of loans have gone bad at the middle lender',
    tileSpread(sp, v => pctS(v), v => v >= 10 ? 'lo' : '', 'Lenders by share of bad loans'), reportIt(sp.n, sp.base), note)
}
function drawDists() {
  closeNote()
  SPREAD = spreadData()
  const d = SPREAD
  $('dists').innerHTML = d.lenders ? sizeTile(d) + roeTile(d) + capitalTile(d) + stage3Tile(d) : sizeTile(d) + profitTile(d) + roeTile(d) + debtTile(d)
  if (SPREAD_DLG.open) drawSpreadDialog()
}

/* the note: opens on press, one at a time, never traps focus */
let openNote = null
function closeNote(refocus = false) {
  if (!openNote) return
  const btn = openNote
  openNote = null
  btn.setAttribute('aria-expanded', 'false')
  $(btn.getAttribute('aria-controls'))?.setAttribute('hidden', '')
  if (refocus) btn.focus()
}
$('dists').addEventListener('click', e => {
  const info = e.target.closest('.dinfo')
  if (info) { const was = openNote === info; closeNote(); if (!was) { openNote = info; info.setAttribute('aria-expanded', 'true'); $(info.getAttribute('aria-controls')).removeAttribute('hidden') } return }
  if (e.target.closest('.dpop')) return
  const more = e.target.closest('[data-spread]')
  if (more) { closeNote(); openSpread(more.dataset.spread, more) }
})
document.addEventListener('click', e => { if (openNote && !e.target.closest('.dtile')) closeNote() })
$('dists').addEventListener('keydown', e => { if (e.key === 'Escape' && openNote) { e.stopPropagation(); closeNote(true) } })
$('dists').addEventListener('focusout', e => { if (openNote && !openNote.closest('.dtile').contains(e.relatedTarget)) closeNote() })

/* the dialog: one tab per figure, the full spread, the tables and what each counts */
const SPREAD_DLG = $('spread')
const TABS = lenders => lenders ? [['size', 'Largest'], ['roe', 'Returns'], ['capital', 'Capital'], ['stage3', 'Bad loans'], ['profit', 'Profit']]
  : [['size', 'Largest'], ['profit', 'Profit'], ['roe', 'Returns'], ['growth', 'Growth'], ['debt', 'Debt']]
function openSpread(tab) {
  DIST_STATE.tab = tab
