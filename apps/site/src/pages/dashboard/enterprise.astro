    sp.n >= 8 ? bigCols(sp.bins, b => midTone(b) >= 10 ? 'lo' : '', 'Number of lenders by share of loans in Stage 3') : nameList(sp.points.map(p => ({ ...p, v: pctS(p.value) }))),
    [`${B(reportIt(sp.n, sp.base))}.`, 'Stage 3 loans as a share of all loans, as each lender reports it. Lenders do not all count this the same way.'])
