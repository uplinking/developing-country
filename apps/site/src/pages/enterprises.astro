      ${cs.map(c => `<td class="${c.cls}">${c.cell(r)}</td>`).join('')}</tr>`
    return row + (openId === r.company_id ? `<tr class="d"><td colspan="${span}">${detail(r)}</td></tr>` : '')
  }).join('')
  fitWeb()
