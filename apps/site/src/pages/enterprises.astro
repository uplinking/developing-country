const $ = id => document.getElementById(id)
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c])
const FAMILY = new Map(COMPANY_SECTOR_TAGS.map(t => [t.tag, t.family]))
const tagLabel = t => COMPANY_SECTOR_BY_TAG.get(t)?.label ?? t
const OWNER = { listed: 'Listed on the CSE', state_owned: 'State-owned', family_group: 'Family-owned', foreign_multinational: 'Foreign-owned',
  private_local: 'Privately owned (Sri Lankan)', private: 'Privately owned (Sri Lankan)', joint_venture: 'Joint venture', listed_elsewhere: 'Part of a listed group',
  in_group: 'Owned by a group', unknown: 'Not classified', '': 'Not classified' }
const REL = { ultimate_parent: 'Parent company', subsidiary: 'Subsidiary', associate: 'Associate', joint_venture: 'Joint venture',
  member_per_web_sources: 'Part', named_in_report_only: 'Named in the annual report', former_holding: 'Formerly held', investment_not_consolidated: 'Minority investment' }
// How a company relates to its group, as a phrase: “Subsidiary of X”, “Part of X”, “Named in X’s annual report”.
const relPhrase = (r, name) => r.relation_to_group === 'named_in_report_only' ? `Named in ${name}’s annual report`
  : r.relation_to_group === 'former_holding' ? `Formerly held by ${name}` : `${REL[r.relation_to_group] ?? 'Part'} of ${name}`
const ISIC_LABEL = new Map()

function fmtLkr(v) {
  if (v === null || v === undefined) return '<span class="dash">–</span>'
  const a = Math.abs(v)
  if (a >= 1e12) return 'LKR ' + (v / 1e12).toPrecision(3) + 'tn'
  if (a >= 1e9) return 'LKR ' + +(v / 1e9).toPrecision(3) + 'bn'
  if (a >= 1e6) return 'LKR ' + +(v / 1e6).toPrecision(3) + 'm'
  return 'LKR ' + Math.round(v).toLocaleString('en')
}
const plural = (n, w) => `${n.toLocaleString('en')} ${n === 1 ? w : w === 'company' ? 'companies' : w + 's'}`
const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']
const fmtDate = d => /^\d{4}-\d{2}-\d{2}$/.test(d) ? `${+d.slice(8)} ${MONTHS[+d.slice(5, 7) - 1]} ${d.slice(0, 4)}` : d
// revenue_basis for web-researched companies is stored as “press_report (2009)”: say it in words
const BASIS = { reported_by_company: 'Company’s own figure', regulator_filing: 'Regulator filing', rating_agency: 'Rating agency report', press_report: 'Press report', ranking: 'Published ranking', estimate_range: 'Estimate' }
function basisText(b) {
  if (!b) return 'Source linked below'
  const m = b.match(/^([a-z_]+)(?: \((.*)\))?$/)
  if (!m || !BASIS[m[1]]) return b
  const yr = m[2] && m[2] !== 'None' ? (m[2].match(/\d{4}/) ?? [''])[0] : ''
  return BASIS[m[1]] + (yr ? `, ${yr}` : '')
}
const fmtPctPlain = v => v === null || v === undefined ? '–' : `${v > 0 ? '+' : ''}${v.toFixed(1)}%`
const fmtInt = v => v === null || v === undefined ? '<span class="dash">–</span>' : Math.round(v).toLocaleString('en')
const fmtPct = v => v === null || v === undefined ? '<span class="dash">–</span>'
  : `<span class="${v > 0 ? 'up' : v < 0 ? 'down' : ''}">${v > 0 ? '+' : ''}${v.toFixed(1)}%</span>`

let ROWS = [], BYID = new Map(), TEXT = new Map(), RELS = { from: new Map(), to: new Map() }, SECT = null
let F = parseFilter(new URLSearchParams(location.search))
let shown = 50, openId = null, menuOpen = null

/* ---------- filters ---------- */
const PERF = { profitable_growing: 'Profitable and growing in real terms', profitable_shrinking: 'Profitable but shrinking in real terms', profitable: 'Profitable',
  back_to_profit: 'Back to profit', fell_into_loss: 'Fell into loss', loss_both_years: 'Loss in both years', negative_equity: 'Negative equity (owes more than it owns)' }
const PERF_SHORT = { profitable_growing: 'Profitable · growing', profitable_shrinking: 'Profitable · shrinking', profitable: 'Profitable', back_to_profit: 'Back to profit', fell_into_loss: 'Fell into loss', loss_both_years: 'Loss both years', negative_equity: 'Negative equity' }
const PERF_TONE = { profitable_growing: 'good', back_to_profit: 'good', profitable_shrinking: 'warn', profitable: '', fell_into_loss: 'bad', loss_both_years: 'bad', negative_equity: 'bad' }
const LISTED = [['', 'All'], ['yes', 'Listed'], ['no', 'Unlisted']]
const KIND_NAME = { bank: 'Banks', finance_company: 'Finance companies', insurer: 'Insurers', other: 'Other listed companies' }
const SECTION = [['size', 'Size'], ['growth', 'Growth and profit'], ['debt', 'Debt and resilience'], ['price', 'Dividends and price'], ['international', 'Exports and overseas'], ['control', 'Control'], ['banks', 'Banks and lenders']]
let EF = effectiveFilter(F)
const rowsMatching = f => ROWS.filter(r => matches(r, f, FAMILY, TEXT.get(r.company_id)))
// any hand edit leaves the ready-made view (its columns stay)
const touched = () => { F.lens = '' }
const drawerCount = () => Object.keys(F.ranges).length + F.performance.length + F.abroad.length + F.kinds.length

const MENUS = {
  sector: {
    label: () => F.sectors.length + F.families.length ? 'Sector · ' + (F.sectors.length + F.families.length) : 'Sector',
    on: () => F.sectors.length + F.families.length > 0,
    items() {
      const base = rowsMatching(effectiveFilter({ ...F, sectors: [], families: [] }))
      const fam = new Map(countBy(base, r => tagsOf(r).map(t => FAMILY.get(t))))
      const tag = new Map(countBy(base, tagsOf))
      const out = []
      for (const [fk, fl] of Object.entries(COMPANY_SECTOR_FAMILIES)) {
        out.push({ id: 'f:' + fk, text: fl, n: fam.get(fk) ?? 0, sel: F.families.includes(fk), cls: 'fam' })
        for (const t of COMPANY_SECTOR_TAGS.filter(t => t.family === fk && (tag.get(t.tag) ?? 0) > 0))
          out.push({ id: 't:' + t.tag, text: t.label, n: tag.get(t.tag), sel: F.sectors.includes(t.tag), cls: 'sub', title: t.meaning })
      }
      return out
    },
    pick(id) {
      const [k, v] = id.split(':'), arr = k === 'f' ? F.families : F.sectors
      const i = arr.indexOf(v); i >= 0 ? arr.splice(i, 1) : arr.push(v); touched()
    }, multi: true,
  },
  ownership: {
    label: () => F.ownership.length ? 'Ownership · ' + F.ownership.length : 'Ownership', on: () => F.ownership.length > 0,
    items: () => countBy(rowsMatching(effectiveFilter({ ...F, ownership: [] })), r => [ownershipOf(r)]).map(([k, n]) => ({ id: k, text: OWNER[k] ?? k, n, sel: F.ownership.includes(k) })),
    pick(id) { const i = F.ownership.indexOf(id); i >= 0 ? F.ownership.splice(i, 1) : F.ownership.push(id); touched() }, multi: true,
  },
}

function drawFilters() {
  const forced = listedOnlyActive(F).length > 0
  const lc = k => rowsMatching(effectiveFilter({ ...F, listed: k })).length
  const n = drawerCount()
  $('filters').innerHTML = Object.entries(MENUS).map(([k, m]) =>
    `<span class="fbtn-w"><button type="button" class="fbtn${m.on() ? ' on' : ''}" data-menu="${k}" aria-haspopup="listbox" aria-expanded="${menuOpen === k}">${esc(m.label())}<span class="car">▼</span></button></span>`).join('') +
    `<div class="seg" role="group" aria-label="Companies">${LISTED.map(([k, t]) => {
      const off = forced && k !== 'yes'
      return `<button type="button" data-listed="${k}" aria-pressed="${EF.listed === k}"${off ? ' disabled title="A filter you chose is published only by listed companies"' : ''}>${t}${off ? '' : ` <span class="n">${lc(k).toLocaleString('en')}</span>`}</button>`
    }).join('')}</div>` +
    `<button type="button" class="fbtn filt${n ? ' on' : ''}" id="openFilters" aria-haspopup="dialog">Filters${n ? ' · ' + n : ''}<span class="car">▸</span></button>`
  if (menuOpen) openMenu(menuOpen, false)
}

function openMenu(key, focus = true) {
  const host = $('filters').querySelector(`[data-menu="${key}"]`)?.parentElement
  if (!host) return
  const m = MENUS[key]
  const items = m.items()
  const ul = document.createElement('ul')
  ul.className = 'menu'; ul.setAttribute('role', 'listbox'); ul.setAttribute('aria-multiselectable', m.multi ? 'true' : 'false')
  ul.innerHTML = items.map(it => `<li role="option" tabindex="-1" data-id="${esc(it.id)}" aria-selected="${it.sel}" class="${it.cls ?? ''}"${it.title ? ` title="${esc(it.title)}"` : ''}><span>${esc(it.text)}</span>${it.n !== undefined ? `<span class="n">${it.n}</span>` : ''}</li>`).join('')
  host.appendChild(ul)
  host.querySelector('.fbtn').setAttribute('aria-expanded', 'true')
  const opts = [...ul.querySelectorAll('[role=option]')]
  ul.addEventListener('click', e => {
    const li = e.target.closest('[role=option]'); if (!li) return
    m.pick(li.dataset.id); shown = 50
    if (!m.multi) menuOpen = null
    update(); if (m.multi) ul.ownerDocument.querySelector(`[data-menu="${key}"]`)?.parentElement.querySelector(`[data-id="${CSS.escape(li.dataset.id)}"]`)?.focus()
  })
  ul.addEventListener('keydown', e => {
    const i = opts.indexOf(document.activeElement)
    if (e.key === 'ArrowDown') { e.preventDefault(); opts[Math.min(i + 1, opts.length - 1)]?.focus() }
    else if (e.key === 'ArrowUp') { e.preventDefault(); opts[Math.max(i - 1, 0)]?.focus() }
    else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); document.activeElement.click() }
    else if (e.key === 'Escape') { closeMenu(true) }
  })
  if (focus) (opts.find(o => o.getAttribute('aria-selected') === 'true') ?? opts[0])?.focus()
}
function closeMenu(refocus) {
  const k = menuOpen; menuOpen = null
  document.querySelectorAll('.cmap .menu').forEach(u => u.remove())
  document.querySelectorAll('.cmap .fbtn').forEach(b => b.getAttribute('data-menu') && b.setAttribute('aria-expanded', 'false'))
  if (refocus && k) $('filters').querySelector(`[data-menu="${k}"]`)?.focus()
}
$('filters').addEventListener('click', e => {
  if (e.target.closest('#openFilters')) { closeMenu(); openDrawer(); return }
  const ls = e.target.closest('[data-listed]')
  if (ls) { if (ls.disabled) return; F.listed = ls.dataset.listed; touched(); shown = 50; update(); return }
  const b = e.target.closest('.fbtn[data-menu]'); if (!b) return
  const k = b.dataset.menu
  if (menuOpen === k) { closeMenu(); return }
  closeMenu(); menuOpen = k; b.setAttribute('aria-expanded', 'true'); openMenu(k)
})
document.addEventListener('click', e => { if (menuOpen && !e.target.closest('.fbtn-w')) closeMenu() })
document.addEventListener('keydown', e => { if (e.key === 'Escape' && menuOpen) closeMenu(true) })

/* ---------- ready-made views ---------- */
let LENS_COUNT = new Map()
function drawLenses() {
  $('lenses').innerHTML = LENSES.map(l => `<button type="button" data-lens="${l.id}" aria-pressed="${F.lens === l.id}">${esc(l.label)}<span class="n">${(LENS_COUNT.get(l.id) ?? 0).toLocaleString('en')}</span></button>`).join('')
  // keep the active view in sight in the scrolling strip (horizontal only: never scroll the page)
  const strip = $('lenses'), on = strip.querySelector('[aria-pressed="true"]')
  if (on && (on.offsetLeft < strip.scrollLeft || on.offsetLeft + on.offsetWidth > strip.scrollLeft + strip.clientWidth))
    strip.scrollLeft = on.offsetLeft - 8
}
$('lenses').addEventListener('click', e => {
  const b = e.target.closest('[data-lens]'); if (!b) return
  F = F.lens === b.dataset.lens ? emptyFilter() : applyLens(b.dataset.lens)
  $('fq').value = ''; openId = null; shown = 50; update()
})

/* ---------- the filters drawer ---------- */
const DRAWER = $('drawer')
function openDrawer() { drawDrawer(); DRAWER.showModal(); DRAWER.querySelector('.dbody').scrollTop = 0 }
DRAWER.addEventListener('click', e => { if (e.target === DRAWER || e.target.closest('[data-dclose]')) DRAWER.close() })
DRAWER.addEventListener('close', () => $('openFilters')?.focus())
$('dclear').addEventListener('click', () => { F.ranges = {}; F.performance = []; F.abroad = []; F.kinds = []; F.growthBasis = 'real'; touched(); shown = 50; update(); drawDrawer() })

function bucketButtons(attrs, items) {
  return `<div class="buckets">${items.map(it => `<button type="button" ${attrs(it)} aria-pressed="${it.sel}"${it.n === 0 && !it.sel ? ' class="zero"' : ''}>${esc(it.label)}<span class="n">${it.n.toLocaleString('en')}</span></button>`).join('')}</div>`
}
function rangeBlock(d) {
  const rest = { ...F, ranges: { ...F.ranges } }; delete rest.ranges[d.key]
  const ef = effectiveFilter(rest)
  // counts as if this filter were picked: a listed-only filter limits to listed companies
  const base = rowsMatching(d.listedOnly ? { ...ef, listed: 'yes', scope: ef.group ? ef.scope : 'all' } : ef)
  const vals = base.map(r => rangeValue(r, d.key, F.growthBasis))
  const reporting = vals.filter(v => v !== null).length
  const sel = (F.ranges[d.key] ?? '').split(',')
  const label = d.key === 'growth' ? (F.growthBasis === 'real' ? 'Growth this year, after inflation' : 'Growth this year, in rupees') : d.label
  return `<div class="dfilter"><div class="dhead"><h4>${esc(label)}</h4><span class="covtag">${d.listedOnly ? 'Listed · ' : ''}${reporting.toLocaleString('en')} of ${base.length.toLocaleString('en')} report this</span></div>
    ${d.note ? `<p class="note">${esc(d.note)}</p>` : ''}
    ${d.key === 'growth' ? `<div class="seg basis" role="group" aria-label="Growth basis"><button type="button" data-basis="real" aria-pressed="${F.growthBasis === 'real'}">After inflation</button><button type="button" data-basis="nominal" aria-pressed="${F.growthBasis === 'nominal'}">In rupees</button></div>` : ''}
    ${bucketButtons(it => `data-range="${d.key}" data-bucket="${it.id}"`, d.buckets.map(bk => ({ id: bk.id, label: bk.label, sel: sel.includes(bk.id), n: vals.filter(v => inBucket(v, bk.min, bk.max)).length })))}</div>`
}
function drawDrawer() {
  const body = $('dbody'), scroll = body.scrollTop
  const showBanks = F.kinds.length || F.families.includes('finance') || F.ranges.npl || F.ranges.car
  body.innerHTML = SECTION.filter(([k]) => k !== 'banks' || showBanks).map(([k, title]) => {
    let inner = RANGES.filter(d => d.section === k).map(rangeBlock).join('')
    if (k === 'growth') {
      const base = rowsMatching(effectiveFilter({ ...F, performance: [], listed: 'yes', scope: F.group ? F.scope : 'all' }))
      const by = new Map(countBy(base, r => [r.performance ?? '']))
      inner += `<div class="dfilter"><div class="dhead"><h4>Profit in the latest two years</h4><span class="covtag">Listed · ${base.filter(r => r.performance).length.toLocaleString('en')} report this</span></div>
        ${bucketButtons(it => `data-perf="${it.id}"`, Object.entries(PERF).map(([id, label]) => ({ id, label, sel: F.performance.includes(id), n: by.get(id) ?? 0 })))}</div>`
    }
    if (k === 'international') {
      const base = rowsMatching(effectiveFilter({ ...F, abroad: [] }))
      inner += `<div class="dfilter"><p class="note">Marked where a source says so; a blank means not known, not that the company does not export.</p>
        ${bucketButtons(it => `data-abroad="${it.id}"`, ABROAD_KEYS.map(id => ({ id, label: ABROAD_LABEL[id], sel: F.abroad.includes(id), n: base.filter(r => id === 'foreign_subsidiaries' ? r.foreign_subsidiaries > 0 : r[id] === true).length })))}</div>`
    }
    if (k === 'banks') {
      const base = rowsMatching(effectiveFilter({ ...F, kinds: [], listed: 'yes', scope: F.group ? F.scope : 'all' }))
      const by = new Map(countBy(base, r => [r.industry_kind ?? '']))
      inner = `<div class="dfilter"><div class="dhead"><h4>Kind of business</h4></div>${bucketButtons(it => `data-kind="${it.id}"`, ['bank', 'finance_company', 'insurer'].map(id => ({ id, label: KIND_NAME[id], sel: F.kinds.includes(id), n: by.get(id) ?? 0 })))}</div>` + inner
    }
    return `<section class="dsec"><h3>${title}</h3>${inner}</section>`
  }).join('')
  body.scrollTop = scroll
  $('dshow').textContent = `Show ${plural(current.length, 'company')}`
}
$('dbody').addEventListener('click', e => {
  const t = e.target.closest('button'); if (!t) return
  const toggle = (arr, v) => { const i = arr.indexOf(v); i >= 0 ? arr.splice(i, 1) : arr.push(v) }
  if (t.dataset.range) { const k = t.dataset.range, id = t.dataset.bucket; if (F.ranges[k] === id) delete F.ranges[k]; else F.ranges[k] = id }
  else if (t.dataset.basis) F.growthBasis = t.dataset.basis
  else if (t.dataset.perf) toggle(F.performance, t.dataset.perf)
  else if (t.dataset.abroad) toggle(F.abroad, t.dataset.abroad)
  else if (t.dataset.kind) toggle(F.kinds, t.dataset.kind)
  else return
  touched(); shown = 50; update(); drawDrawer()
  DRAWER.querySelector(`[data-range="${t.dataset.range}"][data-bucket="${t.dataset.bucket}"],[data-perf="${t.dataset.perf}"],[data-abroad="${t.dataset.abroad}"],[data-kind="${t.dataset.kind}"],[data-basis="${t.dataset.basis}"]`)?.focus()
})

/* ---------- chips ---------- */
function bucketWords(key, ids) {
  const d = RANGE_BY_KEY.get(key)
  return `${key === 'growth' && F.growthBasis === 'nominal' ? 'Growth in rupees' : d.label}: ${ids.split(',').map(id => d.buckets.find(x => x.id === id)?.label ?? id).join(' or ')}`
}
function chips() {
  const c = []
  if (F.group) c.push(['group', 'Group: ' + (BYID.get(F.group)?.name ?? F.group)])
  if (F.q) c.push(['q', `“${F.q}”`])
  F.families.forEach(v => c.push(['family:' + v, COMPANY_SECTOR_FAMILIES[v] ?? v]))
  F.sectors.forEach(v => c.push(['sector:' + v, tagLabel(v)]))
  F.ownership.forEach(v => c.push(['ownership:' + v, OWNER[v] ?? v]))
  if (F.listed) c.push(['listed', F.listed === 'yes' ? 'Listed companies' : 'Unlisted companies'])
  F.isic.forEach(v => c.push(['isic:' + v, 'Industry: ' + (ISIC_LABEL.get(v) ?? v)]))
  for (const [k, ids] of Object.entries(F.ranges)) c.push(['range:' + k, bucketWords(k, ids)])
  F.performance.forEach(v => c.push(['performance:' + v, PERF[v] ?? v]))
  F.kinds.forEach(v => c.push(['kind:' + v, KIND_NAME[v] ?? v]))
  F.abroad.forEach(v => c.push(['abroad:' + v, ABROAD_LABEL[v]]))
  const forced = listedOnlyActive(F)
  $('chips').innerHTML = (forced.length && F.listed !== 'yes' ? `<span class="chip lock" title="${esc(forced.join(', '))}: only listed companies publish this">Listed companies only</span>` : '') +
    c.map(([k, t]) => `<span class="chip">${esc(t)}<button type="button" data-chip="${esc(k)}" aria-label="Remove ${esc(t)}">×</button></span>`).join('') +
    (c.length > 1 ? '<button type="button" class="clear" data-chip="*">Clear all</button>' : '')
}
$('chips').addEventListener('click', e => {
  const b = e.target.closest('[data-chip]'); if (!b) return
  const [k, v] = b.dataset.chip.split(/:(.*)/s)
  const drop = (arr, x) => arr.splice(arr.indexOf(x), 1)
  if (k === '*') { const scope = F.scope; F = { ...emptyFilter(), cols: F.cols, scope: scope === 'all' && !F.group ? 'all' : 'groups' }; $('fq').value = '' }
  else if (k === 'group') { F.group = ''; F.scope = 'groups' }
  else if (k === 'q') { F.q = ''; $('fq').value = '' }
  else if (k === 'family') drop(F.families, v)
  else if (k === 'sector') drop(F.sectors, v)
  else if (k === 'ownership') drop(F.ownership, v)
  else if (k === 'isic') drop(F.isic, v)
  else if (k === 'abroad') drop(F.abroad, v)
  else if (k === 'performance') drop(F.performance, v)
  else if (k === 'kind') drop(F.kinds, v)
  else if (k === 'range') delete F.ranges[v]
  else if (k === 'listed') F.listed = ''
  touched(); shown = 50; update()
})

/* ---------- scope, search, sort, columns ---------- */
root.querySelectorAll('[data-scope]').forEach(b => b.addEventListener('click', () => { F.scope = b.dataset.scope; F.group = ''; touched(); shown = 50; update() }))
let qTimer = 0
$('fq').addEventListener('input', () => { clearTimeout(qTimer); qTimer = setTimeout(() => { F.q = $('fq').value.trim(); shown = 50; update(true) }, 120) })
$('find').addEventListener('submit', e => { e.preventDefault(); F.q = $('fq').value.trim(); update() })
$('fqx').addEventListener('click', () => { $('fq').value = ''; F.q = ''; update(); $('fq').focus() })
$('thead').addEventListener('click', e => {
  const b = e.target.closest('[data-sort]'); if (!b) return
  const k = b.dataset.sort
  if (F.sort === k) F.desc = !F.desc; else { F.sort = k; F.desc = k !== 'name' }
  update()
})
$('colset').addEventListener('change', () => { F.cols = $('colset').value; update() })
$('more').addEventListener('click', () => { shown += 100; drawRows(current) })

/* ---------- drawing ---------- */
let current = []
function update(replace = false) {
  EF = effectiveFilter(F)
  current = sortRows(rowsMatching(EF), F.sort, F.desc)
  const qs = filterToParams(F).toString()
  history[replace ? 'replaceState' : 'pushState'](null, '', (qs ? '?' + qs : location.pathname) + (location.hash === '#method' ? location.hash : ''))
  root.querySelectorAll('[data-scope]').forEach(b => b.setAttribute('aria-pressed', String(!EF.group && b.dataset.scope === EF.scope)))
  $('fqx').hidden = !F.q
  $('colset').value = F.cols
  drawLenses(); drawFilters(); chips(); drawCoverage(); drawSummary(); drawBreaks(); drawHead(); drawRows(current)
  if (DRAWER.open) drawDrawer()
  $('copyta').hidden = true
}

function drawCoverage() {
  const parts = coverage(ROWS, EF, FAMILY).filter(c => c.reporting < c.base)
    .map(c => `${c.reporting.toLocaleString('en')} of ${c.base.toLocaleString('en')} ${EF.listed === 'yes' ? 'listed ' : ''}companies report ${c.label.toLowerCase()}`)
  const forced = listedOnlyActive(F)
  const lines = []
  if (forced.length && F.listed !== 'yes') lines.push(`Showing listed companies, including those inside groups: only listed companies publish ${forced.map(x => x.toLowerCase()).join(', ')}.`)
  if (parts.length) lines.push(`${parts.join('; ')}. Companies without the figure are not counted, not ruled out.`)
  $('coverage').hidden = !lines.length
  $('coverage').textContent = lines.join(' ')
}

function drawSummary() {
  const s = summarize(current)
  // groups among the rows shown: a group counts once, whether the list shows its parent or its companies
  const groupsShown = new Set(current.filter(r => (BYID.get(r.group_id)?.group_companies ?? 0) > 1).map(r => r.group_id)).size
  const head = EF.group ? `<b>${s.companies.toLocaleString('en')}</b> ${s.companies === 1 ? 'company' : 'companies'} in ${esc(BYID.get(EF.group)?.name ?? 'this group')}`
    : `<b>${s.companies.toLocaleString('en')}</b> ${s.companies === 1 ? 'company' : 'companies'}${groupsShown ? ` <span class="incl">(including ${groupsShown.toLocaleString('en')} ${groupsShown === 1 ? 'group' : 'groups'})</span>` : ''}`
  $('lead').innerHTML = head
  const k = (l, v, sub) => `<div class="kpi"><p class="lbl">${l}</p><span class="v">${v}</span><span class="s">${sub}</span></div>`
  const top = EF.scope === 'groups' && !EF.group
  $('kpis').innerHTML =
    (top ? k('Groups', s.groups_with_members.toLocaleString('en'), `plus ${plural(s.companies - s.groups_with_members, 'company')} outside any group`)
      : k('Companies', s.companies.toLocaleString('en'), `in ${plural(s.groups, 'group')}`)) +
    k('Combined revenue', s.revenueCount ? fmtLkr(s.revenueLkr) : '–', `${s.revenueCount.toLocaleString('en')} report it; subsidiaries counted once, inside their group`) +
    k('Grew after inflation', s.growthCount ? `${s.grewReal.toLocaleString('en')} <small>of ${s.growthCount.toLocaleString('en')}</small>` : '–',
      s.growthCount ? `median ${fmtPctPlain(s.medianRealGrowth)} this year${s.growth5Count >= 20 ? `; ${s.grew5} of ${s.growth5Count} over five years` : ''}` : 'listed companies only') +
    k('Profit or loss', s.performanceCount ? `${s.profitable.toLocaleString('en')} <small>· ${s.loss.toLocaleString('en')} loss</small>` : '–',
      s.performanceCount ? `made a profit · made a loss, of ${s.performanceCount.toLocaleString('en')} that report` : 'listed companies only') +
    k('Employees', s.employeesCount ? fmtInt(s.employees) : '–', `${s.employeesCount.toLocaleString('en')} report a headcount`) +
    (EF.listed === 'yes' && s.marketCapCount ? k('Market value', fmtLkr(s.marketCapLkr), `${s.marketCapCount.toLocaleString('en')} listed companies, CSE, November 2026`)
      : k('Known exporters', s.exporters.toLocaleString('en'), `plus ${s.overseas.toLocaleString('en')} with overseas subsidiaries or operations`))
}

let SECTOR_BY = 'count'
function drawBreaks() {
  const rows = current.filter(r => r.primary_sector)
  const fam = SECTOR_BY === 'count' ? countBy(rows, r => [FAMILY.get(r.primary_sector)]).slice(0, 12)
    : [...rows.reduce((m, r) => m.set(FAMILY.get(r.primary_sector), (m.get(FAMILY.get(r.primary_sector)) ?? 0) + (r.revenue_additive_lkr ?? 0)), new Map())].filter(x => x[1] > 0).sort((a, b) => b[1] - a[1]).slice(0, 12)
  const max = Math.max(1, ...fam.map(x => x[1]))
  $('bySector').innerHTML = fam.length ? fam.map(([k, n]) => `<li><button type="button" data-fam="${esc(k)}" aria-pressed="${F.families.includes(k)}"><span class="t">${esc(COMPANY_SECTOR_FAMILIES[k] ?? k)}</span><span class="b"><i style="width:${(n / max * 100).toFixed(1)}%;background:var(--sec-${esc(k)}, var(--teal))"></i></span><span class="c">${SECTOR_BY === 'count' ? n : fmtLkr(n).replace('LKR ', '')}</span></button></li>`).join('')
    : '<li class="empty">No companies with a sector match.</li>'
  // every listed company's ownership reads "listed": with listed companies, show who their largest shareholder is
  const byHolder = EF.listed === 'yes'
  $('ownLabel').textContent = byHolder ? 'By largest shareholder' : 'By ownership'
  const own = byHolder ? countBy(current, r => [r.controller_type ?? 'unknown']).slice(0, 8) : countBy(current, r => [ownershipOf(r)]).slice(0, 8)
  const m2 = Math.max(1, ...own.map(x => x[1]))
  $('byOwner').innerHTML = own.map(([k, n]) => `<li><button type="button" ${byHolder ? 'disabled' : `data-own="${esc(k)}"`} aria-pressed="${!byHolder && F.ownership.includes(k)}"><span class="t">${esc(byHolder ? (HOLDER_KIND[k] ?? k) : (OWNER[k] ?? k))}</span><span class="b"><i style="width:${(n / m2 * 100).toFixed(1)}%"></i></span><span class="c">${n}</span></button></li>`).join('')
}
const HOLDER_KIND = { company: 'A company', person: 'A person or family', state: 'The state', state_enterprise: 'A state enterprise', pension_fund: 'A pension fund', fund: 'An investment fund', nominee_or_custodian: 'A custodian', group: 'Its group', unknown: 'Not known', other: 'Other' }
$('bySector').addEventListener('click', e => { const b = e.target.closest('[data-fam]'); if (!b) return; MENUS.sector.pick('f:' + b.dataset.fam); shown = 50; update() })
$('byOwner').addEventListener('click', e => { const b = e.target.closest('[data-own]'); if (!b) return; MENUS.ownership.pick(b.dataset.own); shown = 50; update() })
