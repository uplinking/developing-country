  $('thead').innerHTML = `<tr>${th('Company', 'name')}${cols().map(c => th(c.head, c.sort, c.cls, c.title)).join('')}</tr>`
}

function drawRows(list) {
  const body = $('rows'), cs = cols(), span = cs.length + 1
  if (!list.length) {
    const ranged = Object.keys(F.ranges).length
    body.innerHTML = `<tr><td colspan="${span}" class="empty">No companies match these filters.${ranged ? ' Some figures are published by only a few companies: try removing one.' : ''}</td></tr>`
    $('more').hidden = true; return
  }
  body.innerHTML = list.slice(0, shown).map(r => {
    const grp = r.is_group_head ? (r.group_companies > 1 ? `Parent of a group of ${r.group_companies} companies` : (r.ownership && r.ownership !== 'unknown' ? OWNER[r.ownership] ?? '' : '')) : relPhrase(r, esc(r.group_name))
    const row = `<tr class="r${openId === r.company_id ? ' open' : ''}" data-id="${esc(r.company_id)}" tabindex="0" aria-expanded="${openId === r.company_id}">
