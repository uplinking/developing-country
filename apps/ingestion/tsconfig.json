{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/ingestion.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "allowArbitraryExtensions": true
  },
  "include": ["./index.ts", "../../packages/ingestion/src"],
  "exclude": ["../../packages/ingestion/src/**/*.test.ts"]
}
