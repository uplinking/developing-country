{
  "$comment": "Every figure in 'Where Colombo's Metro Bus doesn't reach' as a query_data call. Run with: bun scripts/analysis-article.ts analysis/lk-metro-gaps-routes [--mcp <url>]",
  "figures": {
    "density_map": {
      "op": "select",
      "dataset_id": "metro-coverage-gnd",
      "fields": [
        "gnd_id",
        "gnd",
        "dsd",
        "pop_2024",
        "density_per_km2"
      ],
      "limit": 1000,
      "presentation": {
        "kind": "map",
        "title": "Where people live",
        "camera": {
          "center": [
            79.895,
            6.905
          ],
          "zoom": 10.6
        },
        "layers": [
          {
            "id": "metro-coverage-gnd",
            "label": "Residents per km²",
            "join": {
              "tileset": "demographics",
              "sourceLayer": "gnd",
              "rowKey": "gnd_id"
            },
            "style": {
              "geometry": "fill",
              "opacity": 0.8,
              "colorBy": {
                "field": "density_per_km2",
                "scale": "threshold",
                "label": "Residents per km²",
                "breaks": [
                  3000,
                  6000,
                  10000,
                  20000
                ],
                "colors": [
                  "#e7f3f1",
                  "#b4dcd5",
                  "#6fbfb3",
                  "#23978a",
                  "#05665c"
                ],
                "classLabels": [
                  "Under 3,000",
                  "3,000–6,000",
                  "6,000–10,000",
                  "10,000–20,000",
                  "20,000 or more"
                ]
              }
            }
          }
        ]
      }
    },
    "unserved_map": {
      "op": "select",
      "dataset_id": "metro-coverage-gnd",
      "fields": [
        "gnd_id",
        "gnd",
        "dsd",
        "district",
        "pop_2024",
        "density_per_km2",
        "share_10min",
        "unserved_pop_10min",
        "nearest_stop",
        "walk_m_to_stop"
      ],
      "limit": 1000,
      "presentation": {
        "kind": "map",
        "title": "Where people live more than a ten-minute walk from a stop",
        "camera": {
          "center": [
            79.9,
            6.9
          ],
          "zoom": 10.7
        },
        "layers": [
          {
            "id": "metro-coverage-gnd",
            "label": "Residents beyond 10 minutes",
            "join": {
              "tileset": "demographics",
              "sourceLayer": "gnd",
              "rowKey": "gnd_id"
            },
            "style": {
              "geometry": "fill",
              "opacity": 0.82,
              "colorBy": {
                "field": "unserved_pop_10min",
                "scale": "threshold",
                "label": "Residents beyond a 10-minute walk",
                "breaks": [
                  1000,
                  3000,
                  6000,
                  10000
                ],
                "colors": [
                  "#f6f0ea",
                  "#f3cbb9",
                  "#ea9b7e",
                  "#dc6a45",
                  "#b23a1d"
                ],
                "classLabels": [
                  "Under 1,000",
                  "1,000–3,000",
                  "3,000–6,000",
                  "6,000–10,000",
                  "10,000 or more"
                ]
              }
            }
          }
        ]
      }
    },
    "clusters_map": {
      "op": "bbox",
      "entities": "metro_gap_cluster",
      "bbox": [
        79.82,
        6.62,
        80.06,
        7.12
      ],
      "include_geometry": true,
      "presentation": {
        "kind": "map",
        "title": "Seven crowded areas beyond the walk",
        "camera": {
          "center": [
            79.9,
            6.9
          ],
          "zoom": 10.7
        },
        "layers": [
          {
            "id": "metro_gap_cluster",
            "label": "Area",
            "style": {
              "geometry": "line",
              "color": "route-flag",
              "width": 3,
              "labelField": "name"
            }
          }
        ]
      }
    },
    "uniqueness_map": {
      "op": "select",
      "dataset_id": "metro-stop-uniqueness",
      "fields": [
        "stop_id",
        "stop",
        "routes",
        "lng",
        "lat",
        "pop_10min",
        "unique_pop_10min",
        "unique_share_pct"
      ],
      "limit": 200,
      "presentation": {
        "kind": "map",
        "title": "Where the lines overlap",
        "camera": {
          "center": [
            79.87,
            6.9
          ],
          "zoom": 11.8
        },
        "layers": [
          {
            "id": "metro-stop-uniqueness",
            "label": "Metro Bus stop",
            "style": {
              "geometry": "circle",
              "radiusBy": {
                "field": "pop_10min",
                "range": [
                  3,
                  13
                ],
                "label": "Residents within a 10-minute walk"
              },
              "opacity": 0.9,
              "labelField": "stop",
              "colorBy": {
                "field": "unique_share_pct",
                "scale": "threshold",
                "label": "Residents only this stop reaches",
                "breaks": [
                  10,
                  25,
                  50,
                  90
                ],
                "colors": [
                  "#b23a1d",
                  "#ea9b7e",
                  "#cfcac0",
                  "#8fd0c5",
                  "#05776c"
                ],
                "classLabels": [
                  "Under 10%",
                  "10–25%",
                  "25–50%",
                  "50–90%",
                  "90% or more"
                ]
              }
            }
          }
        ]
      }
    },
    "metro_lines": {
      "op": "bbox",
      "entities": "metro_line",
      "bbox": [
        79.75,
        6.65,
        80.05,
        7.15
      ],
      "include_geometry": true,
      "presentation": {
        "kind": "map",
        "title": "The seven Metro Bus lines",
        "camera": {
          "center": [
            79.905,
            6.895
          ],
          "zoom": 10.2
        },
        "layers": [
          {
            "id": "metro_line",
            "label": "Metro Bus line",
            "style": {
              "geometry": "line",
              "color": "ink-dim",
              "width": 2.5,
              "opacity": 0.8
            }
          }
        ]
      }
    }
  }
}
