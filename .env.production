# The explorer is served from the root of explore.developing-country.org.
VITE_BASE=/

# PMTiles generated by data/pipeline.sh and uploaded to R2. Listing a file here
# switches its layer on in the UI. Add climate.pmtiles once it's generated.
VITE_TILE_BASE=https://tiles.developing-country.org
VITE_TILES=roads.pmtiles,water.pmtiles,climate.pmtiles,demographics.pmtiles

# PMTiles use the R2 custom domain directly; the Worker proxy remains only for
# old links and non-browser graph access. Base map stays on OpenFreeMap.

VITE_BASEMAP=openfreemap
