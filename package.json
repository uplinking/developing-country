{
  "name": "developing-country",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.mjs",
    "dev:site": "bun run --cwd apps/site dev",
    "dev:explore": "bun run --cwd apps/explore dev",
    "build": "bun run --cwd apps/explore build",
    "build:explore": "bun run --cwd apps/explore build:explore",
    "build:site": "bun run --cwd apps/site build",
    "datasets:sync": "bun run datasets:index && bun run --cwd apps/site seed:sync-notes && bun run --cwd apps/site data:catalog",
    "datasets:index": "bun scripts/build-dataset-index.ts",
    "check:dataset-index": "bun scripts/build-dataset-index.ts --check",
    "preinstall": "bun scripts/require-bun.mjs",
    "typecheck:packages": "tsc -p packages/domain/tsconfig.json && tsc -p packages/countries/tsconfig.json && tsc -p packages/datasets/tsconfig.json && tsc -p packages/views/tsconfig.json && tsc -p packages/figures/tsconfig.json",
    "typecheck:site": "bun run --cwd apps/site typecheck",
    "test": "bun test packages scripts/*.test.mjs scripts/*.test.ts && bun run --cwd apps/explore test",
    "check": "bun run --cwd packages/datasets registry:check && bun run typecheck:packages && bun run typecheck:worker && bun run typecheck:ingestion && bun run test && bun run lint:articles && bun run check:ontology && bun run check:dataset-versions && bun run check:dataset-index && bun run build && bun run check:site",
    "check:site": "bun run --cwd apps/site check",
    "check:bundle-size": "bun scripts/check-bundle-size.mjs",
    "lint": "oxlint",
    "preview": "bun run --cwd apps/explore preview",
    "cf:dev": "bun run --cwd apps/explore cf:dev",
    "cf:dev:explore": "bun run --cwd apps/explore cf:dev",
    "typecheck:worker": "bun run --cwd apps/explore typecheck",
    "check:ontology": "bun run --cwd apps/explore check:ontology",
    "check:dataset-versions": "bun run --cwd apps/explore check:dataset-versions",
    "build:dataset-versions": "bun run --cwd apps/explore build:dataset-versions",
    "check:gap": "bun run --cwd apps/explore check:gap",
    "flag:served": "bun scripts/flag-served-10min.mjs",
    "db:migrate:local": "bun run --cwd apps/explore db:migrate:local",
    "db:migrate:remote": "bun run --cwd apps/explore db:migrate:remote",
    "db:migrate:site:local": "bun run --cwd apps/site db:migrate:local",
    "db:migrate:site:remote": "bun run --cwd apps/site db:migrate:remote",
    "deploy": "bun run deploy:explore",
    "deploy:explore": "bun run --cwd apps/explore deploy",
    "dry-run:explore": "bun run --cwd apps/explore dry-run",
    "dry-run:site": "bun run build:site && env -u CLOUDFLARE_ACCOUNT_ID -u CLOUDFLARE_API_TOKEN bun run --cwd apps/site wrangler deploy --dry-run --outdir .wrangler/dry-run-site",
    "data": "bash data/pipeline.sh",
    "fetch:expressways": "bun scripts/fetch-expressways.mjs",
    "fetch:explore": "bun scripts/fetch-explore.mjs",
    "fetch:civic": "bun scripts/fetch-civic-poi.mjs",
    "fetch:metro": "bun scripts/fetch-metro.mjs",
    "build:metro-catchment": "bun scripts/build-metro-catchment.mjs",
    "build:walk-graph": "bun scripts/build-walk-graph.mjs",
    "build:developments": "bun scripts/build-developments.mjs",
    "build:boi": "bun scripts/build-boi-zones.mjs",
    "build:admin-index": "bun scripts/build-admin-index.mjs",
    "build:sea-routes": "bun scripts/build-sea-routes.mjs",
    "build:official-indicators": "bun scripts/build-official-indicators.mjs",
    "build:cbsl-indicators": "bun scripts/build-cbsl-indicators.mjs",
    "build:cbsl-real-estate": "bun scripts/build-cbsl-real-estate.mjs",
    "build:land-cover": "bun scripts/build-land-cover.mjs",
    "build:population-change": "bun scripts/build-population-change.mjs",
    "build:census-housing": "bun scripts/build-census-housing.mjs",
    "build:census-identity": "bun scripts/build-census-identity.mjs",
    "build:motor-vehicles": "bun scripts/build-motor-vehicles.mjs",
    "build:electricity-generation": "bun scripts/build-electricity-generation.mjs",
    "fetch:irrigation-gauges": "bun scripts/fetch-irrigation-gauges.mjs",
    "fetch:ferries": "bun scripts/fetch-ferries.mjs",
    "build:treasury": "bun scripts/build-treasury.mjs",
    "typecheck:ingestion": "bun run --cwd apps/ingestion typecheck",
    "dry-run:ingestion": "bun run --cwd apps/ingestion dry-run",
    "deploy:ingestion": "bun run --cwd apps/ingestion deploy",
    "build:sldu": "bun scripts/build-sldu.mjs",
    "build:recovery": "bun scripts/build-recovery-data.mjs",
    "build:urban": "bun scripts/build-urban-data.mjs",
    "lint:articles": "for d in analysis/*/; do bun scripts/lint-article.mjs \"$d\" > /dev/null || { bun scripts/lint-article.mjs \"$d\"; exit 1; }; done"
  },
  "dependencies": {
    "@developing-country/countries": "workspace:*",
    "@developing-country/datasets": "workspace:*",
    "@developing-country/domain": "workspace:*",
    "@developing-country/ui": "workspace:*"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.80.0",
    "@turf/turf": "^7.4.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^24.13.2",
    "oxlint": "^1.80.0",
    "searoute-js": "^0.1.0",
    "typescript": "~6.0.2",
    "wrangler": "^4.110.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
